      <!-- script pour faire la pagination + la recherche sur tout 100 les blogs de tout les pages -->
      <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
          const blogsPerPage = 27;
          const allBlogItems = Array.from(document.querySelectorAll('.blog-item'));
          let filteredBlogItems = [...allBlogItems];
          let totalPages = Math.ceil(filteredBlogItems.length / blogsPerPage);
          const paginationContainer = document.createElement('div');
          paginationContainer.className = 'd-flex justify-content-center mt-4';

          const pagination = document.createElement('ul');
          pagination.className = 'pagination justify-content-center';
          pagination.style.listStyleType = 'none';
          pagination.style.margin = '0';
          pagination.style.padding = '0';


          // Style pagination
          const style = document.createElement('style');
          style.innerHTML = `
            .pagination .page-item:hover {
              background-color: #ee5086;
              color: white;
              transform: scale(1.1);
            }
            .pagination .page-item.active {
              background-color: #4ea4b5;
              color: white;
              font-weight: bold;
            }
            .pagination .page-link {
              color: #4ea4b5;
              text-decoration: none;
            }
            .pagination .page-link:hover {
              color: white;
            }
            .pagination .page-item.disabled {
              pointer-events: none;
              opacity: 0.5;
            }
            .pagination .page-item a {
              font-weight: bold;
            }
            .pagination .page-item a:hover {
              background-color: #ee5086;
              color: white;
            }
            .pagination .page-item:first-child a,
            .pagination .page-item:last-child a {
              font-size: 14px;
            }

            .pagination {
              display: flex;
              justify-content: center;
              align-items: center;
              gap: 8px;
              max-width: 100%;
              box-sizing: border-box;
              -webkit-overflow-scrolling: touch; /* pour un scroll plus fluide sur iOS */
            }

            .pagination .page-item {
              border: 1px solid #ddd;
              border-radius: 5px;
              background-color: #fff;
              padding: 6px 12px; /* réduire un peu le padding sur mobiles */
              min-width: 32px;
              text-align: center;
              flex-shrink: 0; /* empêche le rétrécissement trop fort */
              transition: background-color 0.3s, transform 0.3s;
            }
            

            @media (max-width: 768px) {
            .pagination {
              flex-direction: column;
              align-items: center;
              gap: 6px;
            }

            .pagination .page-item {
              width: 100%;
              justify-content: center;
              padding: 6px 12px;
              font-size: 14px;
            }

            .pagination .page-item a {
              font-size: 14px;
            }
          }`
          ;
          document.head.appendChild(style);

          const prevButton = createPageItem('Prev', () => {
            const currentPage = getActivePage();
            if (currentPage > 1) showPage(currentPage - 1);
          });

          const nextButton = createPageItem('Next', () => {
            const currentPage = getActivePage();
            if (currentPage < totalPages) showPage(currentPage + 1);
          });

          function createPageItem(label, onClick) {
            const li = document.createElement('li');
            li.className = 'page-item';
            const link = document.createElement('a');
            link.className = 'page-link';
            link.href = '#';
            link.innerText = label;
            link.setAttribute('aria-label', `Page ${label}`);
            // Définir le texte ou l'attribut data-i18n
            if (label === 'Prev' || label === 'Next') {
              // Ajout de data-i18n
              link.setAttribute('data-i18n', `pagination.${label.toLowerCase()}`);
              link.innerText = ''; // le texte sera injecté par i18next
            } else {
              link.innerText = label;
            }
            link.addEventListener('click', function (e) {
              e.preventDefault();
              onClick();
            });
            li.appendChild(link);
            return li;
          }

          function getActivePage() {
            const active = document.querySelector('.pagination .page-item.active a');
            return active ? parseInt(active.textContent) || 1 : 1;
          }

          function rebuildPagination() {
            pagination.innerHTML = '';
            const newTotalPages = Math.ceil(filteredBlogItems.length / blogsPerPage);
            totalPages = newTotalPages;

            const noBlogsMessage = document.getElementById('noBlogsMessage');
            const searchSection = document.getElementById('searchSection');

            if (totalPages === 0) {
              // Aucun blog correspondant
              if (noBlogsMessage) noBlogsMessage.style.display = 'block';
              paginationContainer.style.display = 'none';
              allBlogItems.forEach(item => item.style.display = 'none');
              return; // on ne continue pas
            }

            // Sinon : au moins 1 blog => on construit la pagination
            if (noBlogsMessage) noBlogsMessage.style.display = 'none';
            if (searchSection) searchSection.style.display = '';

            pagination.appendChild(prevButton);
            for (let i = 1; i <= totalPages; i++) {
              const pageItem = createPageItem(i, () => showPage(i));
              pagination.appendChild(pageItem);
            }
            pagination.appendChild(nextButton);

            paginationContainer.style.display = totalPages <= 1 ? 'none' : 'flex';
            showPage(1);
          }

          function showPage(page) {
            if (page < 1 || page > totalPages) return;

            const start = (page - 1) * blogsPerPage;
            const end = start + blogsPerPage;

            filteredBlogItems.forEach((item, index) => {
              item.style.display = (index >= start && index < end) ? '' : 'none';
            });

            const pageItems = document.querySelectorAll('.pagination .page-item');
            pageItems.forEach(item => {
              item.classList.remove('active');
              const a = item.querySelector('a');
              if (a) a.removeAttribute('aria-current');
            });

            pageItems.forEach(item => {
              const a = item.querySelector('a');
              if (a && parseInt(a.innerText) === page) {
                item.classList.add('active');
                a.setAttribute('aria-current', 'page');
              }
            });

            prevButton.classList.toggle('disabled', page === 1);
            nextButton.classList.toggle('disabled', page === totalPages);

            updatePaginationVisibility();
          }

          function updatePaginationVisibility() {
            const visibleBlogs = filteredBlogItems.filter(item => item.style.display !== 'none');
            const visibleCount = visibleBlogs.length;

            const noBlogsMessage = document.getElementById('noBlogsMessage');
            const searchSection = document.getElementById('searchSection');

            if (visibleCount === 0) {
              prevButton.style.display = 'none';
              nextButton.style.display = 'none';
              if (noBlogsMessage) noBlogsMessage.style.display = 'block';
            } else {
              prevButton.style.display = '';
              nextButton.style.display = '';
              if (searchSection) searchSection.style.display = '';
              if (noBlogsMessage) noBlogsMessage.style.display = 'none';
            }
          }

          pagination.appendChild(prevButton);
          for (let i = 1; i <= totalPages; i++) {
            const pageItem = createPageItem(i, () => showPage(i));
            pagination.appendChild(pageItem);
          }
          pagination.appendChild(nextButton);
          paginationContainer.appendChild(pagination);

          const blogList = document.getElementById('blog-list');
          if (blogList) blogList.appendChild(paginationContainer);

          showPage(1);


          // Si aucun blog n'existe dès le départ
          if (allBlogItems.length === 0) {
            const noBlogsMessage = document.getElementById('noBlogsMessage');
            const searchSection = document.getElementById('searchSection');
            if (noBlogsMessage) noBlogsMessage.style.display = 'block';
            paginationContainer.style.display = 'none';
          }


          // Live search filter
          const searchInput = document.getElementById('searchInput');
          if (searchInput) {
            searchInput.addEventListener('input', function () {
              const term = this.value.toLowerCase().trim();
              filteredBlogItems = [];

              allBlogItems.forEach(item => {
                const title = item.querySelector('.card-title')?.innerText.toLowerCase() || '';
                const text = item.querySelector('.card-text')?.innerText.toLowerCase() || '';
                const isMatch = title.includes(term) || text.includes(term);
                item.style.display = isMatch ? '' : 'none';
                if (isMatch) filteredBlogItems.push(item);
              });

              paginationContainer.style.display = (term === '' || filteredBlogItems.length > blogsPerPage) ? 'flex' : 'none';
              rebuildPagination();
            });
          }
        });
      </script>

        

      <!-- script pour faire un style css sur la barre de recherche -->
      <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
          const style = document.createElement('style');
          style.textContent = `
            #searchContainer {
              display: flex;
              align-items: center;
              background: linear-gradient(45deg, #4ea4b5, #ee5086);
              border-radius: 30px;
              padding: 12px 20px;
              border: 2px solid #ccc;
              transition: all 0.3s ease;
              box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
              font-family: 'Arial', sans-serif;
              width: 100%;
              max-width: 100%;
            }
      
            #searchContainer i {
              color: #ffffff;
              margin-right: 15px;
              font-size: 1.3rem;
            }
      
            #searchInput {
              border: none;
              outline: none;
              flex: 1;
              font-size: 1rem;
              padding: 12px;
              color: #333;
              background: #f9f9f9;
              border-radius: 25px;
              transition: background 0.3s ease, box-shadow 0.3s ease;
              width: 100%;
            }
      
            #searchContainer.focused {
              border-color: #ee5086;
              box-shadow: 0 0 10px rgba(238, 80, 134, 0.25);
            }
      
            #searchInput:focus {
              background: #ffffff;
              box-shadow: 0px 0px 8px rgba(238, 80, 134, 0.3);
            }
      
            #searchInput::placeholder {
              color: #999;
              font-style: italic;
            }
      
            /* Responsive tablette */
            @media (max-width: 768px) {
              #searchContainer {
                padding: 8px 14px;
                flex-direction: row;
              }
      
              #searchInput {
                font-size: 0.9rem;
                padding: 10px;
              }
      
              #searchContainer i {
                font-size: 1.1rem;
                margin-right: 10px;
              }
            }
      
            /* Responsive téléphone */
            @media (max-width: 480px) {
              #searchContainer {
                padding: 6px 12px;
                flex-direction: row;
              }
      
              #searchInput {
                font-size: 0.85rem;
                padding: 8px;
              }
      
              #searchContainer i {
                font-size: 1rem;
                margin-right: 8px;
              }
            }
          `;
          document.head.appendChild(style);

          const searchContainer = document.getElementById('searchContainer');
          const searchInput = document.getElementById('searchInput');

          if (searchContainer && searchInput) {
            searchInput.addEventListener('focus', () => {
              searchContainer.classList.add('focused');
            });

            searchInput.addEventListener('blur', () => {
              searchContainer.classList.remove('focused');
            });
          }
        });
      </script>


      <!-- script qui détecet automatiquement la langue récupérer depuis la bd et faire l'alignemet du texte 
      selon la langue -->
      <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
          function isArabic(text) {
            // Vérifie si le texte contient des caractères arabes Unicode
            return /[\u0600-\u06FF]/.test(text);
          }

          document.querySelectorAll('.dynamic-text').forEach(el => {
            const text = el.textContent.trim();
            if (isArabic(text)) {
              el.style.direction = 'rtl';
              el.style.textAlign = 'right';
              el.lang = 'ar';
              el.style.fontFamily = "'Arial', 'Tahoma', sans-serif";
            } else {
              el.style.direction = 'ltr';
              el.style.textAlign = 'left';
              el.lang = 'fr'; // ou autre langue par défaut
            }
          });
        });
      </script>

      <!-- Script de détection et d’application de la langue (au chargement) -->
      <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
          const lang = localStorage.getItem("lang") || "en";

          // Appliquer les traductions
          function applyI18n(translations) {
            // Traduire les innerText / innerHTML
            document.querySelectorAll("[data-i18n]").forEach(el => {
              const key = el.getAttribute("data-i18n");
              if (translations[key]) el.innerHTML = translations[key];
            });

            // Traduire les placeholders
            document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
              const key = el.getAttribute("data-i18n-placeholder");
              if (translations[key]) el.setAttribute("placeholder", translations[key]);
            });
          }

          // Charger les traductions
          fetch(`/lang/${lang}.json`)
            .then(res => res.json())
            .then(translations => {
              applyI18n(translations);
            })
            .catch(err => console.error("Erreur traduction :", err));
        });
      </script>
      
      <!-- script pour sctocker la langue dans le local storage lorsque le user clique sur la langue(mobile+desktop+tablette) -->
      <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', function () {
          document.addEventListener('click', function (e) {
            const target = e.target.closest('.lang-select');
            if (target) {
              e.preventDefault();
              const selectedLang = target.dataset.lang;
              if (selectedLang) {
                localStorage.setItem('lang', selectedLang);
                location.reload(); // Recharge la page pour appliquer la langue
              }
            }
          });
        });
      </script>
      
      
      <!-- script pour remplir le champ lang (input lang dans le form) au chargement de la page -->
      <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', function () {
          const storedLang = localStorage.getItem('lang') || 'en';
          const langInput = document.getElementById('langField');
          if (langInput) {
            langInput.value = storedLang;
          }
        });
      </script>


      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      <% if (message) { %>
        <script nonce="<%= nonce %>">
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: "<%= message %>",
                confirmButtonText: 'OK'
            });
        </script>
      <% } %>
        
            
      
      

      
      
      
      
      




</body>

</html>