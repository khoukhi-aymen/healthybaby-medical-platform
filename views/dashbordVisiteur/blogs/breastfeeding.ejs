    <main class="content-wrap">
    
      <!-- Breadcrumbs -->
      <div class="breadcrumbs overlay">
        <div class="container">
          <div class="bread-inner">
            <div class="row">
              <div class="col-12">
                <h2 data-i18n="breastfeeding.title">Breastfeeding Blogs</h2>
                <ul class="bread-list">
                  <li><a href="/home" data-i18n="breadcrumb.home">Home</a></li>
                  <li><i class="icofont-simple-right"></i></li>
                  <li class="active" data-i18n="breadcrumb.breastfeeding">Breastfeeding Blogs</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- End Breadcrumbs -->
    
      <!-- ====== general Blog Section Start ====== -->
      <section class="blog section" style="padding: 60px 0;">
        <div class="container">
          <div class="section-title">
            <h2 data-i18n="doctorBlog.title">Doctor Blogs</h2>
            <p data-i18n="doctorBlog.subtitle">Latest articles from our pediatric professionals</p>
          </div>
    
          <!-- Search Bar Styled Professionally -->
          <div id="searchSection" class="container py-5">
            <!-- Formulaire de filtrage par date -->
            <form method="POST" action="/Breastfeeding" class="row g-3 align-items-end mb-4 justify-content-center">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="lang" id="langField">
              <div class="col-md-3">
                <label for="startDate" class="form-label" data-i18n="doctorBlog.startDate">Start Date</label>
                <input type="date" id="startDate" name="startDate" class="form-control" value="<%= startDate ? startDate : '' %>">
              </div>
            
              <div class="col-md-3">
                <label for="endDate" class="form-label" data-i18n="doctorBlog.endDate">End Date</label>
                <input type="date" id="endDate" name="endDate" class="form-control" value="<%= endDate ? endDate : '' %>">
              </div>
            
              <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-filter"></i><span data-i18n="doctorBlog.filter">Filter</span>
                </button>
              </div>
              <div class="col-auto">
                <a href="/Breastfeeding" class="btn btn-secondary">
                  <i class="bi bi-x-circle"></i><span data-i18n="doctorBlog.reset">Reset</span>
                </a>
              </div>
            </form>
            <!-- Fin formulaire -->


            <div class="row justify-content-center">
              <div class="col-md-8">
                <div id="searchContainer">
                  <i class="fas fa-search"></i>
                  <input type="text" id="searchInput" data-i18n-placeholder="doctorBlog.searchPlaceholder" placeholder="Search...">
                </div>
              </div>
            </div>
          </div>
    
          <!-- Message vide caché au départ -->
          <div id="noBlogsMessage" class="text-center text-muted mt-4" style="display: none;" data-i18n="doctorBlog.noBlogs">
            No blog posts found.
          </div>
    
    
    
    
    
          <!-- Blog List Container -->
          <div id="blog-list">
            <div class="container">
              <div class="row g-4" id="blog-container">
                <% blogs.forEach(function(blog) { %>
                  <% if (blog.status==='Approved' ) { %>
                    <div class="col-md-4 blog-item">
                      <div class="card shadow-sm rounded h-100">
                        <img src="<%= '/uploads/'+ blog.image %>" class="card-img-top" alt="Blog Image"
                          style="height: 250px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                          <h5 class="dynamic-text card-title" style="white-space: pre-line;">
                            <%= blog.title %>
                          </h5>
                          <p class="dynamic-text card-text" style="white-space: pre-line;">
                            <%= blog.content.length> 120 ? blog.content.substring(0, 120) + "..." : blog.content %>
                          </p>
                          <p class="dynamic-text text-muted small">
                            <i class="fas fa-calendar-alt"></i>
                            <%= blog.createdAt.toLocaleDateString("en-GB") %> |
                              <i class="fas fa-user-md"></i>
                              <%= blog.author %> |
                                <span class="badge bg-secondary text-capitalize">
                                  <%= blog.category.replace('-', ' ' ) %>
                                </span>
                          </p>
                          <div class="mt-auto">
                            <a href="/blog-details/<%= blog._id %>" class="btn btn-primary mt-3" data-i18n="doctorBlog.readMore">Read More</a>
                          </div>
                        </div>
                      </div>
                    </div>
                    <% } %>
                      <% }); %>
              </div>
            </div>
          </div>
          <!--End Blog List Container -->
    
          <div id="pagination" class="d-flex justify-content-center mt-4"></div>
        </div>
      </section>
      <!-- ====== general Blog Section End ====== -->
    
