											<small id="lowercase-rule" class="d-block text-secondary" data-i18n="register.rule_lowercase">• One lowercase letter</small>
											<small id="uppercase-rule" class="d-block text-secondary" data-i18n="register.rule_uppercase">• One uppercase letter</small>
											<small id="number-rule" class="d-block text-secondary" data-i18n="register.rule_number">• One number</small>
										</div>
									</div>
			
			
			
			
