        <!-- Ce script respecte la vie privée des visiteurs en les informant qu’un clic sur le bouton 
		entraînera le chargement d’un service externe susceptible de collecter des données personnelles.  -->

		<script nonce="<%= nonce %>">
			document.getElementById('loadMapBtn')?.addEventListener('click', function () {
				document.getElementById('mapPlaceholder').innerHTML = `
					<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3204.690681049366!2d3.6022547!3d36.561570499999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x128e7d0033484d7f%3A0x7810d6a5db9631c8!2zRHIgTS4gT3VkZGFoLCBQw6lkaWF0cmUgSUJDTEMg2K8uINmFLiDZiNi22KfYrdiMINi32KjZitio2Kkg2KPYt9mB2KfZhCDZiNin2LPYqti02KfYsdmK2Kkg2LHYttin2LnYqSDYt9io2YrYudmK2Kk!5e0!3m2!1sar!2sdz!4v1750526889800!5m2!1sar!2sdz" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
				`;
			});
		</script>

		<!-- Script de détection et d’application de la langue (au chargement) -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const lang = localStorage.getItem("lang") || "en";

				function applyI18n(translations) {
					// Traduire les innerText / innerHTML
					document.querySelectorAll("[data-i18n]").forEach(el => {
						const key = el.getAttribute("data-i18n");
						if (translations[key]) el.innerHTML = translations[key];
					});

					// Traduire les placeholders
					document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
						const key = el.getAttribute("data-i18n-placeholder");
						if (translations[key]) el.setAttribute("placeholder", translations[key]);
					});
				}

				// Charger les traductions
				fetch(`/lang/${lang}.json`)
					.then(res => res.json())
					.then(translations => {
						applyI18n(translations);

						// ✅ Appliquer RTL ou LTR uniquement à la section #about-section
						const aboutSection = document.getElementById("about-section");
						if (aboutSection) {
							if (lang === "ar") {
								aboutSection.setAttribute("dir", "rtl");
								aboutSection.style.textAlign = "right";
							} else {
								aboutSection.setAttribute("dir", "ltr");
								aboutSection.style.textAlign = "left";
							}
						}
					})
					.catch(err => console.error("Erreur traduction :", err));
			});
		</script>



        <!-- script pour sctocker la langue dans le local storage lorsque le user clique sur la langue(mobile+desktop+tablette) -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				document.addEventListener('click', function (e) {
					const target = e.target.closest('.lang-select');
					if (target) {
						e.preventDefault();
						const selectedLang = target.dataset.lang;
						if (selectedLang) {
							localStorage.setItem('lang', selectedLang);
							location.reload(); // Recharge la page pour appliquer la langue
						}
					}
				});
			});
		</script>

		  
		  

		

