        <!-- Vérifications de password solide -->
        <script nonce="<%= nonce %>">
            const passwordInput = document.getElementById("password");
            const confirmInput = document.getElementById("confirmPassword");
            const toggleBtn = document.getElementById("togglePassword");
            const toggleIcon = document.getElementById("toggleIcon");
            const toggleBtnConfirm = document.getElementById("toggleConfirm");
            const toggleIconConfirm = document.getElementById("toggleIconConfirm");

            const rules = {
                length: document.getElementById("length-rule"),
                lowercase: document.getElementById("lowercase-rule"),
                uppercase: document.getElementById("uppercase-rule"),
                number: document.getElementById("number-rule")
            };

            passwordInput.addEventListener("input", () => {
                const value = passwordInput.value;

                rules.length.className = value.length >= 8 ? "valid text-success" : "invalid text-secondary";
                rules.lowercase.className = /[a-z]/.test(value) ? "valid text-success" : "invalid text-secondary";
                rules.uppercase.className = /[A-Z]/.test(value) ? "valid text-success" : "invalid text-secondary";
                rules.number.className = /\d/.test(value) ? "valid text-success" : "invalid text-secondary";
            });

            toggleBtn.addEventListener("click", () => {
                const type = passwordInput.type === "password" ? "text" : "password";
                passwordInput.type = type;
                toggleIcon.className = type === "password" ? "bi bi-eye-slash" : "bi bi-eye";
            });

            toggleBtnConfirm.addEventListener("click", () => {
                const type = confirmInput.type === "password" ? "text" : "password";
                confirmInput.type = type;
                toggleIconConfirm.className = type === "password" ? "bi bi-eye-slash" : "bi bi-eye";
            });
        </script>

		<!-- Script de détection et d’application de la langue (au chargement) -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const lang = localStorage.getItem("lang") || "en";

				// Appliquer les traductions
				function applyI18n(translations) {
					// Traduire les innerText / innerHTML
					document.querySelectorAll("[data-i18n]").forEach(el => {
						const key = el.getAttribute("data-i18n");
						if (translations[key]) el.innerHTML = translations[key];
					});

					// Traduire les placeholders
					document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
						const key = el.getAttribute("data-i18n-placeholder");
						if (translations[key]) el.setAttribute("placeholder", translations[key]);
					});
				}

				// Charger les traductions
				fetch(`/lang/${lang}.json`)
					.then(res => res.json())
					.then(translations => {
						applyI18n(translations);
					})
					.catch(err => console.error("Erreur traduction :", err));
			});
		</script>

        <!-- script pour sctocker la langue dans le local storage lorsque le user clique sur la langue(mobile+desktop+tablette) -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				document.addEventListener('click', function (e) {
					const target = e.target.closest('.lang-select');
					if (target) {
						e.preventDefault();
						const selectedLang = target.dataset.lang;
						if (selectedLang) {
							localStorage.setItem('lang', selectedLang);
							location.reload(); // Recharge la page pour appliquer la langue
						}
					}
				});
			});
		</script>


		<!-- script pour remplir le champ lang (input lang dans le form) au chargement de la page -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				const storedLang = localStorage.getItem('lang') || 'en';
				const langInput = document.getElementById('langField');
				if (langInput) {
					langInput.value = storedLang;
				}
			});
		</script>



