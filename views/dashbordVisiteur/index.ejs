        <link rel="stylesheet" href="css/animate.min.css">
		<!-- Magnific Popup CSS -->
        <link rel="stylesheet" href="css/magnific-popup.css">
		
		<!-- Medipro CSS -->
        <link rel="stylesheet" href="css/normalize.css">
        <link rel="stylesheet" href="css/style.css">
        <link rel="stylesheet" href="css/responsive.css">
		
    </head>
    <body>

		<div class="page-container">
		
			<!-- Preloader -->
			<div class="preloader">
				<div class="loader">
					<div class="loader-outter"></div>
					<div class="loader-inner"></div>
		
					<div class="indicator">
						<svg width="16px" height="12px">
							<polyline id="back" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
							<polyline id="front" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
						</svg>
					</div>
				</div>
			</div>
			<!-- End Preloader -->
		
			<!-- Header Area -->
			<header class="header">
				<!-- Topbar -->
				<div class="topbar">
					<div class="container">
						<div class="row">
							<div class="col-lg-6 col-md-5 col-12"></div>
							<div class="col-lg-6 col-md-7 col-12">
								<!-- Top Contact -->
								<ul class="top-contact">
									<li><i class="fa fa-phone" data-i18n="header.phone"></i></li>
									<li><i class="fa fa-envelope"></i><a
											href="mailto:support@yourmail.com"
											data-i18n="header.email">mommyandmeclinic@outlook.com</a></li>
								</ul>
								<!-- End Top Contact -->
							</div>
						</div>
					</div>
				</div>
				<!-- End Topbar -->
				<!-- Header Inner -->
				<div class="header-inner">
					<div class="container">
						<div class="inner">
							<div class="row">
								<div class="col-lg-3 col-md-3 col-12">
									<!-- Start Logo -->
									<div class="logo">
										<a href="/home"
											class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
											<img src="img/logo_healthy_baby.jpg" alt="Logo" width="80">
										</a>
									</div>
									<!-- End Logo -->
									<!-- Mobile Nav -->
									<div class="mobile-nav"></div>
									<!-- End Mobile Nav -->
								</div>
								<div class="col-lg-7 col-md-9 col-12">
									<!-- Main Menu -->
									<div class="main-menu">
										<nav class="navigation">
											<ul class="nav menu">
												<li class="active"><a href="/home" data-i18n="header.home">Home </a></li>
												<li><a href="/AboutUs" data-i18n="header.about">About Us </a></li>
												<li><a href="#" data-i18n="header.blogs">Blogs <i class="icofont-rounded-down"></i></a>
													<ul class="dropdown">
														<li><a href="/General" data-i18n="header.general">general</a></li>
														<li><a href="/Nutrition" data-i18n="header.nutrition">nutrition</a></li>
														<li><a href="/mental-health" data-i18n="header.mental_health">mental-health</a></li>
														<li><a href="/Pediatrics" data-i18n="header.pediatrics">pediatrics</a></li>
														<li><a href="/Breastfeeding" data-i18n="header.breastfeeding">breastfeeding</a></li>
														<li><a href="/Parenting-advice" data-i18n="header.parenting_advice">parenting advice</a></li>
														<li><a href="/Others" data-i18n="header.others">others</a></li>
													</ul>
												</li>
												<li><a href="/contact" data-i18n="header.contact">Contact Us</a></li>
												<li><a href="#" data-i18n="header.language">Language <i class="icofont-rounded-down"></i></a>
													<ul class="dropdown">
														<li><a href="#" class="lang-select" data-lang="en">🇬🇧 English</a></li>
														<li><a href="#" class="lang-select" data-lang="ar">🇸🇦 العربية</a></li>
													</ul>
												</li>
											</ul>
										</nav>
									</div>
									<!--/ End Main Menu -->
								</div>
								<div class="col-lg-2 col-12">
									<div class="get-quote">
										<a href="/login" class="btn" data-i18n="header.my_account">My Account</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!--/ End Header Inner -->
			</header>
			<!-- End Header Area -->
		
		
			<main class="content-wrap">
		
				<!-- Slider Area -->
				<section class="slider">
					<div class="hero-slider">
						<!-- Start Single Slider -->
						<div class="single-slider" style="background-image:url('img/pediatre3.jpg')">
							<div class="container">
								<div class="row">
									<div class="col-lg-7">
										<div class="text">
											<h1 data-i18n="main.slider1.title">Welcome to <span>Mommy & Me</span> - Quality <span>Medical
													Care</span> You Can Trust!</h1>
											<p data-i18n="main.slider1.description" style="color: #E63976"><strong>Providing expert pediatric
													care for your little ones. Book an appointment today and ensure their health and
													well-being.</strong></p>
											<div class="button">
												<a href="/login" class="btn" data-i18n="main.slider1.btn_account">My Account</a>
												<a href="/AboutUs" class="btn primary" data-i18n="main.slider1.btn_about">About Us</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<!-- End Single Slider -->
						<!-- Start Single Slider -->
						<div class="single-slider" style="background-image:url('img/pediatre4.jpg')">
							<div class="container">
								<div class="row">
									<div class="col-lg-7">
										<div class="text">
											<h1 data-i18n="main.slider2.title">
												Expert <span>Medical</span> Care for Your Loved Ones – <span>Anytime, Anywhere!</span>
											</h1>
											<p data-i18n="main.slider2.description" style="color: #E63976">
												<strong>Your child’s health is our priority. Book a consultation with
													<strong style="color: black;">Dr M.Ouddah</strong> and
													<strong style="color: black;">Dr A.Nacef</strong>, our experienced pediatricians,
													and get the best care possible.
												</strong>
											</p>
											<div class="button">
												<a href="/login" class="btn" data-i18n="main.slider2.btn_account">My Account</a>
												<a href="/contact" class="btn primary" data-i18n="main.slider2.btn_contact">Contact Now</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<!-- Start End Slider -->
						<!-- Start Single Slider -->
						<div class="single-slider" style="background-image:url('img/pediatre6.jpg')">
							<div class="container">
								<div class="row">
									<div class="col-lg-7">
										<div class="text">
											<h1 data-i18n="main.slider3.title">Quality <span>Healthcare</span> for Your Child – <span>Trusted &
													Professional!</span></h1>
											<p data-i18n="main.slider3.description" style="color: #E63976">
												<strong>Ensure the best medical care for your little ones with our expert pediatricians. Book an
													appointment or contact us today.</strong>
											</p>
											<div class="button">
												<a href="/login" class="btn" data-i18n="main.slider3.btn_account">My Account</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
						<!-- End Single Slider -->

					</div>
				</section>
				<!--/ End Slider Area -->
		
				<!-- Start Schedule Area -->
				<section class="schedule">
					<div class="container">
						<div class="schedule-inner">
							<div class="row">
								<div class="col-lg-4 col-md-6 col-12 ">
									<!-- single-schedule -->
									<div class="single-schedule first">
										<div class="inner">
											<div class="icon">
												<i class="fa fa-ambulance"></i>
											</div>
											<div class="single-content">
												<span data-i18n="schedule.box1.subtitle">We Are Here for You</span>
												<h4 data-i18n="schedule.box1.title">Emergency Cases</h4>
												<p data-i18n="schedule.box1.text">
													<strong style="color: #1f1f1f;">Dr. M. Ouddah</strong> and
													<strong style="color: #1f1f1f;">Dr. A. Nacef</strong> are available to
													provide fast and effective care for pediatric emergencies.
												</p>
											</div>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6 col-12">
									<!-- single-schedule -->
									<div class="single-schedule middle">
										<div class="inner">
											<div class="icon">
												<i class="icofont-prescription"></i>
											</div>
											<div class="single-content">
												<span data-i18n="schedule.box2.subtitle">Our Schedule</span>
												<h4 data-i18n="schedule.box2.title">Doctors Timetable</h4>
												<p data-i18n="schedule.box2.text">
													Check the availability of <strong style="color:#1f1f1f;">Dr. M.Ouddah</strong>
													and <strong style="color:#1f1f1f;">Dr. A.Nacef</strong> to book your
													appointment at the right time. <br /><br>
												</p>
											</div>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-12 col-12">
									<!-- single-schedule -->
									<div class="single-schedule last">
										<div class="inner">
											<div class="icon">
												<i class="icofont-ui-clock"></i>
											</div>
											<div class="single-content">
												<span data-i18n="schedule.box3.subtitle">Clinic Hours</span>
												<h4 data-i18n="schedule.box3.title">Opening Hours</h4>
												<ul class="time-sidual">
													<li class="day" data-i18n="schedule.box3.day1">Saturday - Thursday <span>8:00 -
															16:00</span></li>
													<li class="day" data-i18n="schedule.box3.day2">Friday <span>Closed</span></li>
												</ul>
												<br><br>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</section>
				<!--/End Start schedule Area -->

		
				<!-- Start service -->
				<section class="services section">
					<div class="container">
						<div class="row">
							<div class="col-lg-12">
								<div class="section-title">
									<h2 data-i18n="services.title">We Provide Specialized Care for Mothers & Babies</h2>
									<img src="img/section-img.png" alt="#">
									<p data-i18n="services.description">
										At Mommy & Me Clinic, we offer comprehensive medical support for infants and mothers,
										ensuring optimal health from birth.
									</p>
								</div>
							</div>
						</div>
						<div class="row">
							<!-- Card 1 -->
							<div class="col-lg-4 col-md-6 col-12">
								<div class="single-service">
									<i class="icofont-baby"></i>
									<h4><a href="#" data-i18n="services.card1.title">Pediatric Consultations</a></h4>
									<p data-i18n="services.card1.text">
										Regular medical check-ups to monitor your child's growth, vaccinations, and overall health.
									</p>
								</div>
							</div>
							<!-- Card 2 -->
							<div class="col-lg-4 col-md-6 col-12">
								<div class="single-service">
									<i class="icofont-woman-bird"></i>
									<h4><a href="#" data-i18n="services.card2.title">Breastfeeding Support</a></h4>
									<p data-i18n="services.card2.text">
										Expert guidance on breastfeeding techniques, lactation challenges, and maternal health.
									</p>
								</div>
							</div>
							<!-- Card 3 -->
							<div class="col-lg-4 col-md-6 col-12">
								<div class="single-service">
									<i class="icofont-thermometer"></i>
									<h4><a href="#" data-i18n="services.card3.title">Infant Health & Disease Treatment</a></h4>
									<p data-i18n="services.card3.text">
										Diagnosis and treatment of common childhood illnesses such as fevers, allergies, and infections.
									</p>
								</div>
							</div>
							<!-- Card 4 -->
							<div class="col-lg-4 col-md-6 col-12">
								<div class="single-service">
									<i class="icofont-medical-sign-alt"></i>
									<h4><a href="#" data-i18n="services.card4.title">Vaccination & Prevention</a></h4>
									<p data-i18n="services.card4.text">
										Ensuring your child follows the necessary immunization schedule for a healthy future.
									</p>
								</div>
							</div>
							<!-- Card 5 -->
							<div class="col-lg-4 col-md-6 col-12">
								<div class="single-service">
									<i class="icofont-nurse"></i>
									<h4><a href="#" data-i18n="services.card5.title">Growth & Development Monitoring</a></h4>
									<p data-i18n="services.card5.text">
										Tracking motor, cognitive, and physical growth milestones to ensure healthy development.
									</p>
								</div>
							</div>
							<!-- Card 6 -->
							<div class="col-lg-4 col-md-6 col-12">
								<div class="single-service">
									<i class="icofont-apple"></i>
									<h4><a href="#" data-i18n="services.card6.title">Nutritional Counseling</a></h4>
									<p data-i18n="services.card6.text">
										Personalized nutrition plans for infants and children to promote healthy eating habits.
									</p>
								</div>
							</div>
						</div>
					</div>
				</section>
				<!--/ End service -->

		
				<!-- Start Fun-facts -->
				<div id="fun-facts" class="fun-facts section overlay">
					<div class="container">
						<div class="row">
							<div class="col-lg-3 col-md-6 col-12">
								<!-- Start Single Fun -->
								<div class="single-fun">
									<i class="icofont-baby"></i>
									<div class="content">
										<span class="counter">2500</span>
										<p data-i18n="funfacts.babies">Babies Cared For</p>
									</div>
								</div>
								<!-- End Single Fun -->
							</div>
							<div class="col-lg-3 col-md-6 col-12">
								<!-- Start Single Fun -->
								<div class="single-fun">
									<i class="icofont-stethoscope"></i>
									<div class="content">
										<span class="counter">2000</span>
										<p data-i18n="funfacts.consultations">Pediatric Consultations</p>
									</div>
								</div>
								<!-- End Single Fun -->
							</div>
							<div class="col-lg-3 col-md-6 col-12">
								<!-- Start Single Fun -->
								<div class="single-fun">
									<i class="icofont-woman-bird"></i>
									<div class="content">
										<span class="counter">1800</span>
										<p data-i18n="funfacts.breastfeeding">Moms Supported in Breastfeeding</p>
									</div>
								</div>
								<!-- End Single Fun -->
							</div>
							<div class="col-lg-3 col-md-6 col-12">
								<!-- Start Single Fun -->
								<div class="single-fun">
									<i class="icofont-doctor"></i>
									<div class="content">
										<span class="counter">10</span>
										<p data-i18n="funfacts.years">Years of Medical Expertise</p>
									</div>
								</div>
								<!-- End Single Fun -->
							</div>
						</div>
					</div>
				</div>
				<!--/ End Fun-facts -->

				<br><br><br><br>
		
				<!-- Start Testimonials Section -->
				
				<% if (testimonials.length>= 3) { %> <!--ne pas afficher les témoignage sauf si le nombre est sup de 3 -->
				
					<div class="container">
						<div class="row justify-content-center text-center">
							<div class="col-lg-12">
								<div class="section-title">
									<h2 class="text-dark fw-bold" data-i18n="patients.title">What Our Patients Say</h2>
									<img src="img/section-img.png" alt="Section image" class="img-fluid my-3" style="max-width: 100px;">
									<p data-i18n="patients.subtitle">Discover the experiences of our satisfied patients.</p>
								</div>
							</div>
						</div>
					</div>
				
				
					<section class="testimonials section">
						<div class="container">
							<div class="row">
								<div class="col-lg-12">
									<div class="section-title">
										<br><br><br><br><br><br><br><br><br>
									</div>
								</div>
							</div>
						</div>
						<div class="container-fluid">
							<div class="row">
								<div class="col-lg-12 col-12">
									<div class="owl-carousel testimonial-slider">
										<% testimonials.forEach(function(t) { %>
											<div class="single-testimonial p-4 rounded text-white bg-opacity-75">
												<div class="testimonial-content text-center" style="height: 130px;">
													<%= t.image %>
														<img src="<%= t.testimonial_image ? '/uploads/' + t.testimonial_image : '/img/image-default-user.png' %>"
															alt="Patient" class="rounded-circle mb-3" width="80">
														<h4>
															<%= t.name %>
														</h4>
														<span class="date d-block fw-light">
															<strong>
															<%= new Date(t.createdAt).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }) %>
															</strong>
														</span>

														<!-- 5 stars statiques -->
														<div class="text-warning mb-2" aria-label="5 stars rating">
															<i class="fas fa-star"></i>
															<i class="fas fa-star"></i>
															<i class="fas fa-star"></i>
															<i class="fas fa-star"></i>
															<i class="fas fa-star"></i>
														</div>


														<p class="fst-italic fw-bold"
															style="height: 80px; overflow: hidden; text-overflow: ellipsis;">
															"<%= t.message %>"
														</p>

														

												</div>
												<br>
											</div>
											<% }) %>
				
									</div>
								</div>
							</div>
						</div>
					</section>
				
				<% } %>
						<!-- End Testimonials Section -->
						<br><br><br><br>
				
				
				
						<!-- Start Contact Section -->
						<section class="contact-us">
							<div class="container">
								<div class="row">
									<div class="col-lg-12">
										<div class="section-title">
											<h2 data-i18n="contact.title">Contact Us</h2>
											<img src="img/section-img.png" alt="#">
											<p data-i18n="contact.description">
												Have a question? Need more information? Fill out this form, and we will get back to you shortly.
											</p>
										</div>
									</div>
								</div>
								<div class="row">
									<!-- Contact Form -->
									<div class="col-lg-6 col-md-12 col-12">
										<form class="form" action="/home" method="POST">
											<input type="hidden" name="_csrf" value="<%= csrfToken %>">
											<input type="hidden" name="lang" id="langField">
											<div class="row">
												<div class="col-lg-6 col-md-6 col-12">
													<div class="form-group">
														<input name="name" type="text" placeholder="Full Name" dir="auto" required
															data-i18n-placeholder="contact.full_name">
													</div>
												</div>
												<div class="col-lg-6 col-md-6 col-12">
													<div class="form-group">
														<input name="email" type="email" placeholder="Email" required
															data-i18n-placeholder="contact.email">
													</div>
												</div>
												<div class="col-lg-6 col-md-6 col-12">
													<div class="form-group">
														<input name="phone" type="text" placeholder="Phone"
															data-i18n-placeholder="contact.phone">
													</div>
												</div>
												<div class="col-lg-6 col-md-6 col-12">
													<div class="form-group">
														<input name="subject" type="text" placeholder="Subject" dir="auto" required
															data-i18n-placeholder="contact.subject">
													</div>
												</div>
												<div class="col-lg-12 col-md-12 col-12">
													<div class="form-group">
														<textarea name="message" class="form-control w-100"
															placeholder="Write your message here..." dir="auto" required
															data-i18n-placeholder="contact.message"></textarea>
													</div>
												</div>
											</div>
											<div class="row">
												<div class="col-lg-5 col-md-4 col-12">
													<div class="form-group">
														<div class="button">
															<button type="submit" class="btn" data-i18n="contact.send">Send</button>
														</div>
													</div>
