        <!-- Script de test de longeur de message <= 80 -->
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<script nonce="<%= nonce %>">
			const message = document.getElementById("message");
			const counter = document.getElementById("charCounter");
			const form = document.querySelector("form");

			let alertShown = false; // Pour éviter de montrer plusieurs fois le Swal

			// Met à jour le compteur et coupe le texte si nécessaire
			message.addEventListener("input", () => {
				let text = message.value;
				if (text.length > 80) {
					message.value = text.slice(0, 80); // Coupe automatiquement à 80 caractères
					if (!alertShown) {
						alertShown = true;
						Swal.fire({
							icon: 'warning',
							title: 'Too long!',
							text: 'Max 80 characters allowed.',
							showConfirmButton: true
						}).then(() => {
							alertShown = false; // Réinitialise après fermeture de l'alerte
						});
					}
				}
				counter.textContent = `${message.value.length}/80`;
			});
		</script>

		<!-- Script de détection et d’application de la langue (au chargement) -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const lang = localStorage.getItem("lang") || "en";

				// Appliquer les traductions
				function applyI18n(translations) {
					// Traduire les innerText / innerHTML
					document.querySelectorAll("[data-i18n]").forEach(el => {
						const key = el.getAttribute("data-i18n");
						if (translations[key]) el.innerHTML = translations[key];
					});

					// Traduire les placeholders
					document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
						const key = el.getAttribute("data-i18n-placeholder");
						if (translations[key]) el.setAttribute("placeholder", translations[key]);
					});
				}

				// Charger les traductions
				fetch(`/lang/${lang}.json`)
					.then(res => res.json())
					.then(translations => {
						applyI18n(translations);
					})
					.catch(err => console.error("Erreur traduction :", err));
			});
		</script>

        <!-- script pour sctocker la langue dans le local storage lorsque le user clique sur la langue(mobile+desktop+tablette) -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				document.addEventListener('click', function (e) {
					const target = e.target.closest('.lang-select');
					if (target) {
						e.preventDefault();
						const selectedLang = target.dataset.lang;
						if (selectedLang) {
							localStorage.setItem('lang', selectedLang);
							location.reload(); // Recharge la page pour appliquer la langue
						}
					}
				});
			});
		</script>


		<!-- script pour remplir le champ lang (input lang dans le form) au chargement de la page -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				const storedLang = localStorage.getItem('lang') || 'en';
				const langInput = document.getElementById('langField');
				if (langInput) {
					langInput.value = storedLang;
				}
			});
		</script>



		<% if (message) { %>
			<script nonce="<%= nonce %>">
				Swal.fire({
					icon: '<%= message === "Thank you! Your testimonial will be reviewed before publication." || message==="شكرًا لك! سيتم مراجعة شهادتك قبل النشر" ? "success" : "error" %>',
					title: '<%= message ==="Thank you! Your testimonial will be reviewed before publication." || message==="شكرًا لك! سيتم مراجعة شهادتك قبل النشر" ? "success" : "Oops..." %>',
					text: "<%= message %>",
					confirmButtonText: 'OK'
				});
			</script>
		<% } %>


  
    </body>
</html>