										<div class="main-menu">
											<nav class="navigation">
												<ul class="nav menu">
													<li class="nav-item">
														<a href="/MyApp" class="nav-link active">
															<span data-i18n="header.myAppointments">My Appointments</span>
														</a>
													</li>
													<li class="nav-item">
														<a href="/BookAppoitement" class="nav-link">
															<span data-i18n="header.bookAppointment">Book Appointment</span>
														</a>
													</li>

													<li><a href="#" data-i18n="header.blogs">Blogs <i class="nav-item"></i></a>
														<ul class="dropdown">
															<li><a href="/MyApp/General" data-i18n="blogs.general">general</a></li>
															<li><a href="/MyApp/Nutrition" data-i18n="blogs.nutrition">nutrition</a></li>
															<li><a href="/MyApp/Mental-health" data-i18n="blogs.mental">mental-health</a></li>
															<li><a href="/MyApp/Pediatrics" data-i18n="blogs.pediatrics">pediatrics</a></li>
															<li><a href="/MyApp/Breastfeeding" data-i18n="blogs.breastfeeding">breastfeeding</a></li>
															<li><a href="/MyApp/Parenting-advice" data-i18n="blogs.parenting">parenting advice</a></li>
															<li><a href="/MyApp/Others" data-i18n="blogs.others">others</a></li>
														</ul>
													</li>

													<li class="nav-item">
														<a href="/ContactAdminFromParent" class="nav-link">
															<span data-i18n="header.contact">Contact Us</span>
														</a>
													</li>


													<li><a class="" href="#" data-i18n="header.language">Language</a>
														<ul class="dropdown">
															<li><a href="#" class="lang-select" data-lang="en">🇬🇧 English</a></li>
															<li><a href="#" class="lang-select" data-lang="ar">🇸🇦 العربية</a></li>
