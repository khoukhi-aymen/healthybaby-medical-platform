		<!-- Initialisation De DataTables JS -->
		<script nonce="<%= nonce %>">
			$(document).ready(function () {
				var table = $('#dataTable').DataTable({
					"paging": true,
					"pagingType": "full_numbers",
					"lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
					"searching": true,
					"ordering": true,
					"info": true,
					"language": {
						"lengthMenu": "Showing _MENU_ entries",
						"search": "searching :",
						"paginate": {
							"first": "First",
							"last": "Last",
							"next": ">",
							"previous": "<"
						},
						"info": "Showing _START_ à _END_ sur _TOTAL_ entries"
					}
				});

				// Appliquer le style à la pagination au chargement et après chaque changement de page
				function stylePagination() {
					let pagination = document.querySelector('.dataTables_paginate');
					if (pagination) {
						pagination.style.marginTop = "10px";
						pagination.style.display = 'flex';
						pagination.style.alignItems = 'center';
						pagination.style.justifyContent = 'flex-end';
						pagination.style.gap = '5px';
						pagination.style.borderRadius = '5px';
						pagination.style.backgroundColor = '#f8f9fa'; // Fond clair
						pagination.style.border = '0px';
					}

					document.querySelectorAll('.paginate_button').forEach(button => {
						button.style.display = 'inline-block';
						button.style.color = '#333';
						button.style.textDecoration = 'none';
						button.style.border = '0px solid #ddd';
						button.style.borderRadius = '3px';
						button.style.cursor = 'pointer';
						button.style.backgroundColor = '#fff';

						// Effet au survol
						button.addEventListener('mouseover', () => {
							button.style.backgroundColor = '#e9ecef';
						});
						button.addEventListener('mouseout', () => {
							button.style.backgroundColor = '#fff';
						});

						// Mettre en évidence la page active
						if (button.classList.contains('current')) {
							button.style.backgroundColor = '#6c63ff'; // Bleu foncé
							button.style.color = '#fff';
							button.style.fontWeight = 'bold';
						}
					});
				}

				// Appliquer le style au chargement
				stylePagination();

				// Appliquer le style après chaque changement de page
				table.on('draw.dt', function () {
					stylePagination();
					if (globalTranslations) {
						applyI18n(globalTranslations); // On applique la traduction à chaque redraw
					}
				});


				// Synchronisation du sélecteur avec DataTables
				$('#entries').on('change', function () {
					table.page.len($(this).val()).draw();
				});

				// Synchronisation de la barre de recherche avec DataTables
				$('#searchInput').on('keyup', function () {
					table.search($(this).val()).draw();
				});
			});

		</script>

		<!-- Script de détection et d’application de la langue (au chargement) -->
		<script nonce="<%= nonce %>">
			// Fonction de traduction globale
			function applyI18n(translations) {
				document.querySelectorAll("[data-i18n]").forEach(el => {
					const key = el.getAttribute("data-i18n");
					if (translations[key]) el.innerHTML = translations[key];
				});
				document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
					const key = el.getAttribute("data-i18n-placeholder");
					if (translations[key]) el.setAttribute("placeholder", translations[key]);
				});
			}

			// Traductions globales accessibles par tout le site
			let globalTranslations = {};
		</script>

		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const lang = localStorage.getItem("lang") || "en";

				fetch(`/lang/${lang}.json`)
					.then(res => res.json())
					.then(translations => {
						globalTranslations = translations; // on garde en global
						applyI18n(translations);           // on applique sur les éléments initiaux
					})
					.catch(err => console.error("Erreur traduction :", err));
			});
		</script>



        <!-- script pour sctocker la langue dans le local storage lorsque le user clique sur la langue(mobile+desktop+tablette) -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				document.addEventListener('click', function (e) {
					const target = e.target.closest('.lang-select');
					if (target) {
						e.preventDefault();
						const selectedLang = target.dataset.lang;
						if (selectedLang) {
							localStorage.setItem('lang', selectedLang);
							location.reload(); // Recharge la page pour appliquer la langue
						}
					}
				});
			});
		</script>


		<!-- script pour remplir le champ lang (input lang dans le form) au chargement de la page -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				const storedLang = localStorage.getItem('lang') || 'en';
				const langInput = document.getElementById('langField');
				if (langInput) {
					langInput.value = storedLang;
				}
			});
		</script>



		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<% if (message) { %>
			<script nonce="<%= nonce %>">
				Swal.fire({
					icon: 'error',
					title: 'Oops...',
					text: "<%= message %>",
					confirmButtonText: 'OK'
				});
			</script>
		<% } %>
			
    </body>
</html>