				<main class="content-wrap">
			
					<!-- Breadcrumbs -->
					<div class="breadcrumbs overlay">
						<div class="container">
							<div class="bread-inner">
								<div class="row">
									<div class="col-12">
										<h2 data-i18n="breadcrumb.myAppointments.title">My Appoitements</h2>
										<ul class="bread-list">
											<li><a href="/MyApp" data-i18n="breadcrumb.myAppointments.account">My Account</a></li>
											<li><i class="icofont-simple-right"></i></li>
											<li class="active" data-i18n="breadcrumb.myAppointments.title">My Appoitements</li>
										</ul>
									</div>
								</div>
							</div>
						</div>
					</div>
					<!-- End Breadcrumbs -->
			
					<!-- Contenu principal -->
					<div class="container-fluid p-4">
						<!-- Formulaire de filtrage par date -->
						<form method="POST" action="/MyApp" class="row g-3 align-items-end mb-4">
							<input type="hidden" name="_csrf" value="<%= csrfToken %>">
							<input type="hidden" name="lang" id="langField">
			
							<div class="col-md-3">
								<label for="startDate" class="form-label" data-i18n="doctorBlog.startDate">Start Date</label>
								<input type="date" id="startDate" name="startDate" class="form-control"
									value="<%= startDate ? startDate : '' %>">
							</div>
			
							<div class="col-md-3">
								<label for="endDate" class="form-label" data-i18n="doctorBlog.endDate">End Date</label>
								<input type="date" id="endDate" name="endDate" class="form-control"
									value="<%= endDate ? endDate : '' %>">
							</div>
			
							<div class="col-auto">
								<button type="submit" class="btn btn-primary">
									<i class="bi bi-filter"></i> <span data-i18n="doctorBlog.filter">Filter</span>
								</button>
							</div>
							<div class="col-auto">
								<a href="/MyApp" class="btn btn-secondary">
									<i class="bi bi-x-circle"></i> <span data-i18n="doctorBlog.reset">Reset</span>
								</a>
							</div>
						</form>
						<!-- Fin formulaire -->
			
			
						<!-- Tableau des rendez vous -->
						<div class="card mb-4">
							<div class="table-responsive p-3">
								<table class="table align-items-center table-flush" id="dataTable">
									<thead class="thead">
										<tr>
											<th class="w-25" data-i18n="appointments.table.doctor">Dr. Name</th>
											<th class="w-25" data-i18n="appointments.table.status">Status</th>
											<th class="w-25" data-i18n="appointments.table.date">Date</th>
											<th class="w-25" data-i18n="appointments.table.hour">Hour</th>
											<th class="w-25" data-i18n="appointments.table.type">Type</th>
											<th class="w-25" data-i18n="appointments.table.mode">Mode</th>
											<th data-i18n="appointments.table.action">Action</th>
										</tr>
									</thead>
									<tbody class="tbody">
										<% appointments.forEach(app=> { %>
											<tr>
												<td class="w-25 text-truncate dynamic-text">
													<%= app.doctorName %>
												</td>
												
												<td class="w-25 text-truncate">
													<span class="badge text-dark
														<%= app.status === 'Pending' ? 'bg-warning' : 
															app.status === 'Approved' ? 'bg-success' : 
															app.status === 'Rejected' ? 'bg-danger' : 
															app.status === 'Completed' ? 'bg-primary' : 
															app.status === 'In follow-up' ? 'bg-info' : 
															app.status === 'Reviewed' ? 'bg-secondary' : 
															'bg-secondary' %>" data-i18n="appointments.status.<%= app.status.replace(/[\s-]/g,'').toLowerCase() %>">
														<%= app.status %>
													</span>
												</td>

												<td class="w-25 text-truncate">
													<%= new Date(app.appointmentDate).toLocaleDateString() %>
												</td>
												<td class="w-25 text-truncate">
													<%= app.appointmentHour %>
												</td>
												<td class="w-25 text-truncate" data-i18n="appointments.type.<%= app.appointmentType.toLowerCase() %>">
													<%= app.appointmentType %>
												</td>
												<td class="w-25 text-truncate"
													data-i18n="appointments.mode.<%= app.appointmentMode === 'online' ? 'online' : app.appointmentMode === 'Face-to-face' ? 'facetoface' : 'notSpecified' %>">
													<%= app.appointmentMode==='online' ? 'Online' : app.appointmentMode==='Face-to-face' ? 'Face-to-Face'
														: 'Not Specified' %>
												</td>
												<td>
						
														<% if (app.status==='Approved' ) { %>
															<div class="d-flex">
																<!-- Supprimer -->
																<a class="btn btn-sm me-2 deleteAppointmentBtn" data-app-id="<%= app._id %>"
																	data-pre-id="<%= app.preAppointmentId %>"
																	data-schedule-id="<%= app.scheduleId %>"
																	data-doctor-name="<%= app.doctorName %>"
																	data-date="<%= app.appointmentDate.toISOString() %>"
																	data-hour="<%= app.appointmentHour %>"
																	style="background-color: #f44336; color: white;">
																	<i class="bi bi-trash"></i>
																</a>
						
																<!-- Update Appointment -->
																<a class="btn btn-sm me-2 updateAppointmentBtn"
																    data-app-id="<%= app._id %>"
																	data-pre-id="<%= app.preAppointmentId %>"
																	style="background-color: #2196f3; color: white;">
																	<i class="bi bi-pencil"></i>
																</a>
																<!-- view Pre-rendez vous -->
																<a class="btn btn-sm me-2 updateQuestionnaireBtn"
																	data-pre-id="<%= app.preAppointmentId %>"
																	style="background-color: #4ea4b5; color: white;">
																	<i class="bi bi-eye"></i>
																</a>
															</div>
						
														<% } else if (app.status==='Pending' ) { %>
																<div class="d-flex">
																	<!-- Supprimer -->
																	<a class="btn btn-sm me-2 deleteAppointmentBtn" data-app-id="<%= app._id %>"
																		data-pre-id="<%= app.preAppointmentId %>"
																		data-schedule-id="<%= app.scheduleId %>"
																		data-doctor-name="<%= app.doctorName %>"
																		data-date="<%= app.appointmentDate.toISOString() %>"
																		data-hour="<%= app.appointmentHour %>"
																		style="background-color: #f44336; color: white;">
																		<i class="bi bi-trash"></i>
																	</a>
																	<!-- Update Appointment -->
																	<a class="btn btn-sm me-2 updateAppointmentBtn" 
																	    data-app-id="<%= app._id %>"
																		data-pre-id="<%= app.preAppointmentId %>"
																		style="background-color: #2196f3; color: white;">
																		<i class="bi bi-pencil"></i>
																	</a>
																	<!-- view Pre-rendez vous -->
																	<a class="btn btn-sm me-2 updateQuestionnaireBtn"
																		data-pre-id="<%= app.preAppointmentId %>"
																		style="background-color: #4ea4b5; color: white;">
																		<i class="bi bi-eye"></i>
																	</a>
																</div>
						
														<% } else if (app.status==='In follow-up' ) { %>
																	<div class="d-flex">
																		<!-- Supprimer -->
																		<a class="btn btn-sm me-2 deleteAppointmentBtn"
																			data-app-id="<%= app._id %>"
																			data-pre-id="<%= app.preAppointmentId %>"
																			data-schedule-id="<%= app.scheduleId %>"
																			data-doctor-name="<%= app.doctorName %>"
																			data-date="<%= app.appointmentDate.toISOString() %>"
																			data-hour="<%= app.appointmentHour %>"
																			style="background-color: #f44336; color: white;">
																			<i class="bi bi-trash"></i>
																		</a>
																		<!-- Update Appointment -->
																		<a class="btn btn-sm me-2 updateAppointmentBtn"
																			data-app-id="<%= app._id %>"
																			data-pre-id="<%= app.preAppointmentId %>"
																			style="background-color: #2196f3; color: white;">
																			<i class="bi bi-pencil"></i>
																		</a>
																		<!-- view Pre-rendez vous -->
																		<a class="btn btn-sm me-2 updateQuestionnaireBtn"
																			data-pre-id="<%= app.preAppointmentId %>"
																			style="background-color: #4ea4b5; color: white;">
																			<i class="bi bi-eye"></i>
																		</a>
																	</div>
						
														<% } else if (app.status==='Completed' ) { %>
																		<div class="d-flex">
																			<% if (app.isReviewed) { %>
																				<!-- Afficher "Update Testimonial" avec une étoile -->
																				<a class="btn btn-sm me-2 updateTestimonialBtn"
																					data-app-id="<%= app._id %>"
																					style="background-color: #4ea4b5; color: white; position: relative;">
																					<i class="bi bi-pencil"></i>
																				</a>
																			<% } else{ %>
																					<!-- Leave Testimonial -->
																					<a class="btn btn-sm me-2 leaveTestimonialBtn"
																						data-app-id="<%= app._id %>"
																						style="background-color: #00ad34; color: white;">
																						<i class="bi bi-chat"></i>
																					</a>
																			<% } %>
																		</div>
														<% } %>
						
												</td>
						
											</tr>
											<% }) %>
									</tbody>
								</table>
							</div>
						</div>
						<!--End Tableau des rendez vous -->
			
					</div>
					<!--End Contenu principal -->
			
				</main>
			
				<!-- Footer Area -->
				<footer id="footer" class="footer">
					<!-- Copyright -->
					<div class="copyright">
						<div class="container">
							<div class="row align-items-center">
								<!-- Copyright Text -->
								<div class="col-md-6 text-md-start text-center">
									<div class="copyright-content">
										<p data-i18n="footer.copyrightText">
											© Copyright 2025 | All Rights Reserved by
											<a href="#" target="_blank">Mommy&Me.com</a>
										</p>
									</div>
								</div>
								<!--/ End Copyright -->
				
								<!-- Social Media Icons -->
								<div class="col-md-6 text-md-end text-center">
									<div class="social-icons">
										<a href="https://web.facebook.com/dr.ouddah" target="_blank"
											class="text-white fs-4 p-2 btn btn-outline-light">
											<i style="font-size: 30px;" class="icofont-facebook display-4"></i>
										</a>
										<a href="https://www.instagram.com/dr.ouddah" target="_blank"
											class="text-white fs-4 p-2 btn btn-outline-light">
											<i style="font-size: 30px;" class="icofont-instagram display-4"></i>
										</a>
										<a href="https://www.linkedin.com/in/meriem-ouddah-88b097213/" target="_blank"
											class="text-white fs-4 p-2 btn btn-outline-light">
											<i style="font-size: 30px;" class="icofont-linkedin"></i>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</footer>
				<!--End Footer Area -->
			</div>

			

		

		
		
