					<!-- Header Inner -->
					<div class="header-inner">
						<div class="container">
							<div class="inner">
								<div class="row">
									<div class="col-lg-3 col-md-3 col-12">
										<!-- Start Logo -->
										<div class="logo">
											<a href="/MyApp"
												class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
												<img src="img/logo_healthy_baby.jpg" alt="Logo" width="50">
												<span style="margin-left: 10px;" class="fs-5 ms-3 fw-bold" data-i18n="header.myAccount">My Account</span>
											</a>
										</div>
										<!-- End Logo -->
										<!-- Mobile Nav -->
										<div class="mobile-nav"></div>
										<!-- End Mobile Nav -->
									</div>
									<div class="col-lg-7 col-md-9 col-12">
