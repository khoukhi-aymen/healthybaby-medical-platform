        <!-- script pour supprimer un rendez vous  -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", () => {
				const csrfToken = "<%= csrfToken %>";
				document.querySelectorAll(".deleteAppointmentBtn").forEach((button) => {
					button.addEventListener("click", (event) => {
						const dataset = event.currentTarget.dataset;

						const appointmentId = dataset.appId;
						const preAppointmentId = dataset.preId;
						const scheduleId = dataset.scheduleId;
						const doctorName = dataset.doctorName;
						const appointmentDate = dataset.date;
						const appointmentHour = dataset.hour;

						//récupérer la langue
						const lang = document.getElementById("langField").value;

						Swal.fire({
							icon: 'warning',
							html: `
								<h2 data-i18n="swal.delete.title">Delete this appointment?</h2>
								<p data-i18n="swal.delete.text">This action cannot be undone.</p>
							`,
							showCancelButton: true,
							confirmButtonText: '<span data-i18n="swal.delete.confirm">Yes, delete it!</span>',
							cancelButtonText: '<span data-i18n="swal.delete.cancel">Cancel</span>',
							confirmButtonColor: '#3085d6',
							cancelButtonColor: '#d33',
							didOpen: () => {
								const lang = localStorage.getItem('lang') || 'en';
								fetch(`/lang/${lang}.json`)
									.then(res => res.json())
									.then(translations => {
										document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
											const key = el.getAttribute('data-i18n');
											if (translations[key]) {
												el.innerHTML = translations[key];
											}
										});
									});
						    }
						}).then((result) => {
							if (result.isConfirmed) {
								fetch(`/MyApp/delete/${appointmentId}`, {
									method: "POST",
									headers: {
										"Content-Type": "application/json",
										"X-Requested-With": "XMLHttpRequest",
										"CSRF-Token": csrfToken
									}, 
									body: JSON.stringify({
										preAppointmentId: preAppointmentId,
										scheduleId: scheduleId,
										doctorName: doctorName,
										appointmentDate: appointmentDate,
										appointmentHour: appointmentHour,
										lang: lang //ajoute ta variable de langue ici
									})
								})
									.then(response => response.json())
									.then(data => {

										// Si redirection nécessaire
										if (data.redirectTo) {
											window.location.href = data.redirectTo;
											return;
										}


										if (data.success) {
											// Affiche une alerte de succès après la suppression
											Swal.fire({
												icon: "success",
												title: "Deleted!",
												text: data.message
											}).then(() => {
												// Recharge la page pour mettre à jour l'affichage des blogs
												window.location.reload();
											});
										} else {
											// Affiche une alerte d'erreur si la suppression échoue
											Swal.fire({
												icon: "error",
												title: "Oops...",
												text: data.message
											});
										}
									})
									.catch(() => {
										// Si la requête échoue, affiche une alerte d'erreur
										Swal.fire({
											icon: 'error',
											title: 'Oops...',
											html: `
												<p data-i18n="error.message">Something went wrong, please try again later.</p>
											`,
											didOpen: () => {
												const lang = localStorage.getItem('lang') || 'en';
												fetch(`/lang/${lang}.json`)
													.then(res => res.json())
													.then(translations => {
														document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
															const key = el.getAttribute('data-i18n');
															if (translations[key]) {
																el.innerHTML = translations[key];
															}
														});
													});
											}
										});
									});
							}
						});
					});
				});
			});
		</script>


