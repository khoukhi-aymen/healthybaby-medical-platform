        <!-- script pour afficher le details sur le pre-rendez vous  -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", () => {
				const csrfToken = "<%= csrfToken %>";

				// Fonction pour détecter la présence de texte arabe
				function containsArabic(text) {
					return /[\u0600-\u06FF]/.test(text);
				}
		
				document.querySelectorAll(".updateQuestionnaireBtn").forEach(button => {
					button.addEventListener("click", () => {
						const preId = button.dataset.preId;

						//récupérer la langue
						const lang = document.getElementById("langField").value;
		
						if (!preId) {
							return Swal.fire({
								icon: 'error',
								title:"Oops...",
								html: `
									<p data-i18n="swal.noPreId.text">No pre-appointment ID associated.</p>
								`,
								didOpen: () => {
									const lang = localStorage.getItem('lang') || 'en';
									fetch(`/lang/${lang}.json`)
										.then(res => res.json())
										.then(translations => {
											document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
												const key = el.getAttribute('data-i18n');
												if (translations[key]) {
													el.innerHTML = translations[key];
												}
											});
										});
								}
							});
						}

		
						fetch(`/MyApp/PreappointmentDetails/${preId}`, {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-Requested-With": "XMLHttpRequest", // pour req.xhr
								"CSRF-Token": csrfToken
							},
							body: JSON.stringify({
								lang: lang //ajoute ta variable de langue ici
							})
						})
						.then(response => response.json())
						.then(data => {
								if (data.redirectTo) {
									window.location.href = data.redirectTo;
									return;
								}

								if (data.success) {
									const diseasesList = Array.isArray(data.diseases) ? data.diseases.join(", ") : 'None';
									// Détecter si du texte arabe est présent
									const isArabic =
										containsArabic(data.name) ||
										containsArabic(data.residence) ||
										containsArabic(data.concern_summary);

									const direction = isArabic ? 'rtl' : 'ltr';
									const align = isArabic ? 'right' : 'left';

									// Construire le contenu HTML avec alignement
									const htmlContent = `
              							<div class="dynamic-text" style="max-height: 400px; overflow-y: auto; text-align: ${align}; direction: ${direction}; line-height: 1.8; white-space: pre-line;">
                							<p><strong>${isArabic ? 'الاسم' : 'Name'}:</strong> ${data.name}</p>
                							<p><strong>${isArabic ? 'البريد الإلكتروني' : 'Email'}:</strong> ${data.email}</p>
                							<p><strong>${isArabic ? 'الواتساب' : 'WhatsApp'}:</strong> ${data.whatsapp}</p>
                							<p><strong>${isArabic ? 'الإقامة' : 'Residence'}:</strong> ${data.residence}</p>
                							<p><strong>${isArabic ? 'موافقة الفيديو' : 'Video Consent'}:</strong> ${data.video_consent}</p>
                							<p><strong>${isArabic ? 'الأمراض' : 'Diseases'}:</strong> ${diseasesList}</p>
                							<p><strong>${isArabic ? 'أمراض أخرى' : 'Other Diseases'}:</strong> ${data.other_diseases || (isArabic ? 'لا توجد' : 'None')}</p>
                							<p><strong>${isArabic ? 'ملخص المشكل' : 'Concern Summary'}:</strong></p>
                							<p>${data.concern_summary || (isArabic ? 'لا يوجد' : 'None')}</p>
                							<p><strong>${isArabic ? 'تم تأكيد الدفع' : 'Payment Confirmed'}:</strong> ${data.payment_confirmed || (isArabic ? 'لا' : 'No')}</p>
              							</div>
            						`;

									Swal.fire({
										title: isArabic ? 'تفاصيل الموعد المسبق' : 'Pre-Appointment Details',
										html: htmlContent,
										width: 700,
										confirmButtonText: isArabic ? 'إغلاق' : 'Close',
										confirmButtonColor: "#4ea4b5"
									});
								} else {
									Swal.fire({
										icon: "error",
										title: "Oops...",
										text: data.message
									});
								}
						})
						.catch(error => {
								// Si la requête échoue, affiche une alerte d'erreur
							Swal.fire({
								icon: 'error',
								title: 'Oops...',
								html: `
									<p data-i18n="error.message">Something went wrong, please try again later.</p>
								`,
								didOpen: () => {
									const lang = localStorage.getItem('lang') || 'en';
									fetch(`/lang/${lang}.json`)
										.then(res => res.json())
										.then(translations => {
											document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
												const key = el.getAttribute('data-i18n');
												if (translations[key]) {
													el.innerHTML = translations[key];
												}
											});
										});
								}
							});
						});

					});
				});
			});
		</script>
		


