				<!-- Contenu principal -->
				<div class="container-fluid p-4">
					<!-- Start Patient Questionnaire Section -->
					<section class="container-fluid mt-5">
						<div class="row justify-content-center">
							<div class="col-12 col-md-8 col-lg-6">
								<div class="Questionnaire card shadow p-4">
									<h3 class="text-dark Questionnaire-title text-center mb-2"
										style="font-weight: 600; color: #4e73df;"
										data-i18n="questionnaire.title">
										Natural Breastfeeding Consultation Booking
									</h3>
									<br>
									<br>
									<div class="alert alert-info" role="alert">
										<div class="mb-2">
											<strong><span data-i18n="questionnaire.duration">Consultation Duration:45 minutes</span></strong>
										</div>
										<div class="mb-2">
											<strong data-i18n="questionnaire.fee"><span> Fee:3000 DZD</span></strong>
										</div>
										<div class="mb-2">
											<strong data-i18n="questionnaire.paymentMethod">Payment via:</strong>
											<ul class="mb-2 ps-3">
												<li><strong data-i18n="questionnaire.payment.baridiMob">BaridiMob (RIP):</strong> <span
														class="text-break">00799999001245839494</span></li>
												<li><strong data-i18n="questionnaire.payment.ccp">CCP:</strong> Ouddah Meriem - <span class="text-break">0012458394
														key 94</span></li>
											</ul>
										</div>
										<div class="mb-2">
											<strong data-i18n="questionnaire.sendReceipt">After payment, please send the payment receipt via WhatsApp to:</strong>
											<a href="https://wa.me/213562392055" class="text-primary text-break">0562392055</a>
										</div>
										<div>
											<span data-i18n="questionnaire.zoomNote">The consultation will be held via <strong>Zoom</strong> at the agreed
												time.</span>
										</div>
									</div>
				
				
				
									<form class="questionnaire-form" id="questionnaire-form" action="/UpdatePre-Appointment/<%= preAppointment._id %>" method="POST">
										<input type="hidden" name="_csrf" value="<%= csrfToken %>">
										<input type="hidden" name="lang" id="langField">
										<br><br>
										<!-- Step 1-->
										<div class="form-step active">
				
											<div class="form-group mt-3">
												<label for="name" class="form-label"><span data-i18n="form.name">Full Name</span></label>
												<input type="text" class="form-control" id="name" name="name"
													value="<%= preAppointment.name %>" placeholder="Enter your full name" data-i18n-placeholder="form.placeholder.fullName" required>
											</div>
				
											<div class="form-group mt-3">
												<label for="email" class="form-label"><span data-i18n="form.email" >Email Address </span></label>
												<input type="email" class="form-control" id="email" name="email"
													value="<%= preAppointment.email %>" placeholder="Enter your email address" data-i18n-placeholder="form.placeholder.email" required>
											</div>
				
				
											<div class="form-group mt-3">
												<label for="whatsapp" class="form-label"><span data-i18n="form.whatsapp">WhatsApp Number</span></label>
												<input type="tel" class="form-control" id="whatsapp" name="whatsapp"
													value="<%= preAppointment.whatsapp %>"  placeholder="+213 XXX-XX-XX-XX" data-i18n-placeholder="form.placeholder.whatsapp" required>
											</div>
				
											<div class="form-group mt-3">
												<label for="residence" class="form-label"><span data-i18n="form.city">City / Region</span></label>
												<input type="text" class="form-control" id="residence" name="residence" placeholder="Enter your city" data-i18n-placeholder="form.placeholder.city"
													value="<%= preAppointment.residence %>" required>
											</div>
				
											<div class="form-group mt-3" data-radio-group>
												<label class="form-label d-block"><span data-i18n="form.videoConsent">Do you consent to a video call for consultation?</span><span class="text-danger">*</span></label>
												<div class="form-check form-check-inline">
													<input class="form-check-input" type="radio" name="video_consent" id="video_yes"
														value="Yes" <%=preAppointment.video_consent==='Yes' ? 'checked' : '' %>  required>
													<label class="form-check-label" for="video_yes"><span data-i18n="form.yes">Yes</span></label>
												</div>
												<div class="form-check form-check-inline">
													<input class="form-check-input" type="radio" name="video_consent" id="video_no"
														value="No" <%=preAppointment.video_consent==='No' ? 'checked' : '' %> required>
													<label class="form-check-label" for="video_no"><span data-i18n="form.no">No</span></label>
												</div>
											</div>
				
											<div class="mt-4 text-end">
												<button type="button" class="btn btn-primary next-btn" data-i18n="form.next">Next</button>
											</div>
										</div>
				
										<!-- Step 2: Medical History -->
										<div class="form-step d-none">
				
											<% const selectedDiseases=preAppointment.diseases || []; %>
				
												<div class="form-group mt-3">
													<div class="checkbox-group-wrapper">
														<label class="form-label"><span data-i18n="form.breastfeedingIssuesQuestion">What breastfeeding issues are you facing?</span></label>
				
														<% const diseaseOptions=[ "Nipple/Breast Pain" , "Difficulty Latching"
															, "Inverted/Flat Nipple" , "Baby is not gaining weight appropriately"
															, "Low Milk Supply" , "Relactation" , "Going back to work"
															, "Induced Lactation" ]; %>
				
															<% diseaseOptions.forEach((disease, index)=> { %>
																<div class="form-check">
																	<input class="form-check-input" type="checkbox" name="diseases[]"
																		value="<%= disease %>" id="disease<%= index + 1 %>"
																		<%=selectedDiseases.includes(disease) ? 'checked' : '' %>
																	>
																	<label class="form-check-label" for="disease<%= index + 1 %>" data-i18n="form.step2.diseases.<%= index + 1 %>"><%= disease %></label>
																</div>
																<% }); %>
				
																	<!-- Autres maladies -->
																	<div class="form-group mt-3">
																		<label for="other_diseases"><span data-i18n="form.issues.other">Other (please specify):</span></label>
																		<input type="text" class="form-control" id="other_diseases"
																			name="other_diseases"
																			value="<%= preAppointment.other_diseases || '' %>"
																			placeholder="Specify other concern..." data-i18n-placeholder="form.placeholder.otherIssue" dir="auto">
																	</div>
				
																	<!-- Placeholder for validation error -->
																	<div class="checkbox-error-placeholder mt-2"></div>
													</div>
												</div>
				
				
												<div class="form-group mt-4">
													<label for="concern_summary" class="form-label" data-i18n="form.concernSummary">What is your concern in brief words?</label>
													<textarea class="form-control" name="concern_summary" id="concern_summary" rows="3" data-i18n-placeholder="form.placeholder.concernSummary"
														dir="auto" required><%= preAppointment.concern_summary %></textarea>
												</div>
				
												<div class="form-group mt-4" data-radio-group>
													<label class="form-label" data-i18n="form.paymentConfirmedQuestion">Was the appointment confirmed by paying the consultation
														fee? <span class="text-danger">*</span></label>
													<div class="form-check">
														<input class="form-check-input" type="radio" name="payment_confirmed"
															id="paid_yes" value="Yes" <%=preAppointment.payment_confirmed==='Yes'
															? 'checked' : '' %> required>
														<label class="form-check-label" for="paid_yes" data-i18n="form.yes">Yes</label>
													</div>
													<div class="form-check">
														<input class="form-check-input" type="radio" name="payment_confirmed"
															id="paid_no" value="No" <%=preAppointment.payment_confirmed==='No'
															? 'checked' : '' %> required>
														<label class="form-check-label" for="paid_no" for="paid_no" data-i18n="form.no">No</label>
													</div>
												</div>
				
												<div class="mt-4 d-flex justify-content-between">
													<button type="button" class="btn btn-secondary prev-btn" data-i18n="form.previous">Previous</button>
													<button id="submit-questionnaire" type="submit"
														class="btn btn-success" data-i18n="form.navigation.confirmUpdate">Confirm Update</button>
												</div>
				
										</div>
				
									</form>
								</div>
							</div>
						</div>
					</section>
					<!-- End Patient Questionnaire Section -->
				
				</div>
				<!--End Contenu principal -->
			
			</main>
		
