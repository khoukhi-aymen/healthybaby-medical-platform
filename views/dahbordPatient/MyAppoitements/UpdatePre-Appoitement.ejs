				Swal.fire({
					icon: '<%= message === "Your pre-appointment has been successfully updated." || message==="تم تحديث الحجز المسبق بنجاح" ? "success" : "error" %>',
					title: '<%= message ==="Your pre-appointment has been successfully updated." || message==="تم تحديث الحجز المسبق بنجاح" ? "success" : "Oops..." %>',
					text: "<%= message %>",
					confirmButtonText: 'OK'
				});
			</script>
		<% } %>
