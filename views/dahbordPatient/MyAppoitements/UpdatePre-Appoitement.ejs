		<!-- Script principal avec validation complète du formulaire de pre-rendez vous et navigation entre étapes -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const questionnaireForm = document.getElementById("questionnaire-form");
				const submitQuestionnaireBtn = document.getElementById("submit-questionnaire");

				const nextBtns = document.querySelectorAll('.next-btn');
				const prevBtns = document.querySelectorAll('.prev-btn');

				// Validation des groupes de checkboxes
				function validateCheckboxGroup(step) {
					const checkboxGroupWrapper = step.querySelector('.checkbox-group-wrapper');
					if (!checkboxGroupWrapper) return true;

					const checkboxes = checkboxGroupWrapper.querySelectorAll('input[type="checkbox"][name="diseases[]"]');
					const otherInput = checkboxGroupWrapper.querySelector('#other_diseases');
					const errorPlaceholder = checkboxGroupWrapper.querySelector('.checkbox-error-placeholder');

					const isAnyChecked = Array.from(checkboxes).some(cb => cb.checked);
					const hasOtherInput = otherInput && otherInput.value.trim() !== '';

					if (!isAnyChecked && !hasOtherInput) {
						if (!errorPlaceholder.querySelector('.checkbox-error-message')) {
							const error = document.createElement('div');
							error.classList.add('text-danger', 'checkbox-error-message');
							error.innerText = "Please select at least one disease or fill in the 'Other' field.";
							errorPlaceholder.appendChild(error);
						}
						return false;
					} else {
						const existingError = errorPlaceholder.querySelector('.checkbox-error-message');
						if (existingError) existingError.remove();
						return true;
					}
				}

				// Validation des groupes de boutons radio
				function validateRadioGroups(step) {
					let allValid = true;
					const radioGroups = step.querySelectorAll('[data-radio-group]');

					radioGroups.forEach(wrapper => {
						const radios = wrapper.querySelectorAll('input[type="radio"]');
						const isChecked = Array.from(radios).some(r => r.checked);
						let errorMsg = wrapper.querySelector('.radio-error-message');

						if (!isChecked) {
							allValid = false;
							if (!errorMsg) {
								errorMsg = document.createElement('div');
								errorMsg.classList.add('text-danger', 'radio-error-message');
								errorMsg.innerText = "Please select an option.";
								wrapper.appendChild(errorMsg);
							}
						} else if (errorMsg) {
							errorMsg.remove();
						}
					});

					return allValid;
				}

				// Validation générale
				function validateForm(step) {
					const requiredFields = step.querySelectorAll('[required]');
					let isValid = true;

					requiredFields.forEach(field => {
						let fieldValid = true;

						if (field.type === 'radio' || field.type === 'checkbox') return;
						else if (field.type === 'file') {
							fieldValid = field.files.length > 0;
						} else {
							fieldValid = field.value.trim() !== '';
						}

						if (!fieldValid) {
							isValid = false;
							field.classList.add('is-invalid');
							if (!field.nextElementSibling || !field.nextElementSibling.classList.contains('invalid-feedback')) {
								const errorMsg = document.createElement('div');
								errorMsg.classList.add('invalid-feedback');
								errorMsg.innerText = "This field is required.";
								field.parentElement.appendChild(errorMsg);
							}
						} else {
							field.classList.remove('is-invalid');
							if (field.nextElementSibling && field.nextElementSibling.classList.contains('invalid-feedback')) {
								field.nextElementSibling.remove();
							}
						}
					});

					if (!validateCheckboxGroup(step)) isValid = false;
					if (!validateRadioGroups(step)) isValid = false;

					return isValid;
				}

				// Navigation "Suivant"
				nextBtns.forEach(btn => {
					btn.addEventListener('click', function () {
						const currentStep = btn.closest('.form-step');
						if (validateForm(currentStep)) {
							const nextStep = currentStep.nextElementSibling;
							if (nextStep) {
								currentStep.classList.add('d-none');
								nextStep.classList.remove('d-none');
							}
						}
					});
				});

				// Navigation "Précédent"
				prevBtns.forEach(btn => {
					btn.addEventListener('click', function () {
						const currentStep = btn.closest('.form-step');
						const prevStep = currentStep.previousElementSibling;
						if (prevStep) {
							currentStep.classList.add('d-none');
							prevStep.classList.remove('d-none');
						}
					});
				});

				// Soumission du pré-rendez-vous (bouton "Terminer")
				if (submitQuestionnaireBtn) {
					submitQuestionnaireBtn.addEventListener("click", function (e) {
						const currentStep = questionnaireForm.querySelector('.form-step:not(.d-none)');
						if (!validateForm(currentStep)) {
							e.preventDefault();
						}
					});
				}

				// Soumission générale du formulaire
				if (questionnaireForm) {
					questionnaireForm.addEventListener('submit', function (e) {
						const currentStep = questionnaireForm.querySelector('.form-step:not(.d-none)');
						if (!validateForm(currentStep)) {
							e.preventDefault();
						}
					});
				}
			});
		</script>

		<!-- Script de détection et d’application de la langue (au chargement) -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const lang = localStorage.getItem("lang") || "en";

				// Appliquer les traductions
				function applyI18n(translations) {
					// Traduire les innerText / innerHTML
					document.querySelectorAll("[data-i18n]").forEach(el => {
						const key = el.getAttribute("data-i18n");
						if (translations[key]) el.innerHTML = translations[key];
					});

					// Traduire les placeholders
					document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
						const key = el.getAttribute("data-i18n-placeholder");
						if (translations[key]) el.setAttribute("placeholder", translations[key]);
					});
				}

				// Charger les traductions
				fetch(`/lang/${lang}.json`)
					.then(res => res.json())
					.then(translations => {
						applyI18n(translations);
					})
					.catch(err => console.error("Erreur traduction :", err));
			});
		</script>

        <!-- script pour sctocker la langue dans le local storage lorsque le user clique sur la langue(mobile+desktop+tablette) -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				document.addEventListener('click', function (e) {
					const target = e.target.closest('.lang-select');
					if (target) {
						e.preventDefault();
						const selectedLang = target.dataset.lang;
						if (selectedLang) {
							localStorage.setItem('lang', selectedLang);
							location.reload(); // Recharge la page pour appliquer la langue
						}
					}
				});
			});
		</script>


		<!-- script pour remplir le champ lang (input lang dans le form) au chargement de la page -->
		<script nonce="<%= nonce %>">
			document.addEventListener('DOMContentLoaded', function () {
				const storedLang = localStorage.getItem('lang') || 'en';
				const langInput = document.getElementById('langField');
				if (langInput) {
					langInput.value = storedLang;
				}
			});
		</script>
		
		
