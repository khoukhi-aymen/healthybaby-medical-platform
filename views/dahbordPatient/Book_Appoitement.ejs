	<!-- Favicon -->
	<link rel="icon" href="img/logo_healthy_baby.jpg">

	<!-- Google Fonts -->
	<link
		href="https://fonts.googleapis.com/css?family=Poppins:200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap"
		rel="stylesheet">

	<!-- Bootstrap CSS -->
	<link rel="stylesheet" href="css/bootstrap.min.css">
	<!-- Nice Select CSS -->
	<link rel="stylesheet" href="css/nice-select.css">
	<!-- Font Awesome CSS -->
	<link rel="stylesheet" href="css/font-awesome.min.css">
	<!-- icofont CSS -->
	<link rel="stylesheet" href="css/icofont.css">
	<!-- Slicknav -->
	<link rel="stylesheet" href="css/slicknav.min.css">
	<!-- Owl Carousel CSS -->
	<link rel="stylesheet" href="css/owl-carousel.css">
	<!-- Datepicker CSS -->
	<link rel="stylesheet" href="css/datepicker.css">
	<!-- Animate CSS -->
	<link rel="stylesheet" href="css/animate.min.css">
	<!-- Magnific Popup CSS -->
	<link rel="stylesheet" href="css/magnific-popup.css">

	<!-- Medipro CSS -->
	<link rel="stylesheet" href="css/normalize.css">
	<link rel="stylesheet" href="css/style.css">
	<link rel="stylesheet" href="css/responsive.css">

</head>

<body class="light-mode">


	<div class="page-container">
	
		<!-- Preloader -->
		<div class="preloader">
			<div class="loader">
				<div class="loader-outter"></div>
				<div class="loader-inner"></div>
	
				<div class="indicator">
					<svg width="16px" height="12px">
						<polyline id="back" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
						<polyline id="front" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
					</svg>
				</div>
			</div>
		</div>
		<!-- End Preloader -->
	
	
	
		<!-- Header Area -->
		<header class="header">
			<!-- Topbar -->
			<div class="topbar">
				<div class="container">
					<div class="row">
						<div class="col-lg-6 col-md-5 col-12"></div>
						<div class="col-lg-6 col-md-7 col-12">
							<!-- Top Contact -->
							<ul class="top-contact">
								<li class="num"><i class="fa fa-phone"></i>+213 562 39 20 55</li>
								<li class="email"><i class="fa fa-envelope"></i><a
										href="mailto:support@yourmail.com">mommyandmeclinic@outlook.com</a></li>
							</ul>
							<!-- End Top Contact -->
						</div>
						<!-- Contenu principal -->
					</div>
				</div>
			</div>
			<!-- End Topbar -->
			<!-- Header Inner -->
			<div class="header-inner">
				<div class="container">
					<div class="inner">
						<div class="row">
							<div class="col-lg-3 col-md-3 col-12">
								<!-- Start Logo -->
								<div class="logo">
									<a href="/MyApp"
										class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
										<img src="img/logo_healthy_baby.jpg" alt="Logo" width="50">
										<span style="margin-left: 10px;" class="fs-5 ms-3 fw-bold" data-i18n="header.myAccount">My Account</span>
									</a>
								</div>
								<!-- End Logo -->
								<!-- Mobile Nav -->
								<div class="mobile-nav"></div>
								<!-- End Mobile Nav -->
							</div>
							<div class="col-lg-7 col-md-9 col-12">
								<!-- Main Menu -->
								<div class="main-menu">
									<nav class="navigation">
										<ul class="nav menu">
											<li class="nav-item">
												<a href="/MyApp" class="nav-link active">
													<span data-i18n="header.myAppointments">My Appointments</span>
												</a>
											</li>
											<li class="nav-item">
												<a href="/BookAppoitement" class="nav-link">
													<span data-i18n="header.bookAppointment">Book Appointment</span>
												</a>
											</li>
											<li><a href="#" data-i18n="header.blogs">Blogs <i class="nav-item"></i></a>
													<ul class="dropdown">
														<li><a href="/MyApp/General" data-i18n="blogs.general">general</a></li>
														<li><a href="/MyApp/Nutrition"  data-i18n="blogs.nutrition">nutrition</a></li>
														<li><a href="/MyApp/Mental-health" data-i18n="blogs.mental">mental-health</a></li>
														<li><a href="/MyApp/Pediatrics" data-i18n="blogs.pediatrics">pediatrics</a></li>
														<li><a href="/MyApp/Breastfeeding" data-i18n="blogs.breastfeeding">breastfeeding</a></li>
														<li><a href="/MyApp/Parenting-advice" data-i18n="blogs.parenting">parenting advice</a></li>
														<li><a href="/MyApp/Others" data-i18n="blogs.others">others</a></li>
													</ul>
											</li>

											<li class="nav-item">
												<a href="/ContactAdminFromParent" class="nav-link">
													<span class="" data-i18n="header.contact">Contact Us</span>
												</a>
											</li>
											<li><a class="" href="#" data-i18n="header.language">Language</a>
												<ul class="dropdown">
														<li><a href="#" class="lang-select" data-lang="en">🇬🇧 English</a></li>
														<li><a href="#" class="lang-select" data-lang="ar">🇸🇦 العربية</a></li>
												</ul>
											</li>
	
										</ul>
									</nav>
								</div>
								<!--/ End Main Menu -->
							</div>
							<div class="col-lg-2 col-12 d-flex justify-content-end align-items-center">
								<form method="post" action="/logout" class="m-0">
									<button style="background-color: red;" type="submit" class="btn" data-i18n="header.logout">
										Logout
									</button>
								</form>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!--/ End Header Inner -->
		</header>
		<!-- End Header Area -->


		<main class="content-wrap">
		
		
		
			<!-- Breadcrumbs -->
			<div class="breadcrumbs overlay">
				<div class="container">
					<div class="bread-inner">
						<div class="row">
							<div class="col-12">
								<h2 data-i18n="breadcrumbs.title">Book Appointment</h2>
								<ul class="bread-list">
									<li><a href="/MyApp" data-i18n="breadcrumbs.account">My Account</a></li>
									<li><i class="icofont-simple-right"></i></li>
									<li class="active" data-i18n="breadcrumbs.book">Book an Appointment</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- End Breadcrumbs -->

		
		
		
			<!-- Contenu principal -->
			<div class="container-fluid p-4">
				<!-- Start Patient Questionnaire Section -->
				<section class="container-fluid mt-5">
					<div class="row justify-content-center">
						<div class="col-12 col-md-8 col-lg-6">
							<div class="Questionnaire card shadow p-4">
								<h3 class="text-dark Questionnaire-title text-center mb-2" style="font-weight: 600; color: #4e73df;" data-i18n="questionnaire.title">
									Natural Breastfeeding Consultation Booking
								</h3>
								<br>
								<br>
								<div class="alert alert-info" role="alert">
									<div class="mb-2">
										<strong><span data-i18n="questionnaire.duration">Consultation Duration:45 minutes</span></strong>
									</div>
									<div class="mb-2">
										<strong data-i18n="questionnaire.fee"><span> Fee:3000 DZD</span></strong>
									</div>
									<div class="mb-2">
										<strong data-i18n="questionnaire.paymentMethod">Payment via:</strong>
										<ul class="mb-2 ps-3">
											<li><strong data-i18n="questionnaire.payment.baridiMob">BaridiMob (RIP):</strong> <span class="text-break">00799999001245839494</span></li>
											<li><strong data-i18n="questionnaire.payment.ccp">CCP:</strong> Ouddah Meriem - <span class="text-break">0012458394 key 94</span></li>
										</ul>
									</div>
									<div class="mb-2">
										<strong data-i18n="questionnaire.sendReceipt">After payment, please send the payment receipt via WhatsApp to:</strong>
										<a href="https://wa.me/213562392055" class="text-primary text-break">0562392055</a>
									</div>
									<div>
										<span data-i18n="questionnaire.zoomNote">The consultation will be held via <strong>Zoom</strong> at the agreed time.</span>
									</div>
								</div>

		
		
								<form class="questionnaire-form" id="questionnaire-form" action="/PreAppointment" method="POST">
									<input type="hidden" name="_csrf" value="<%= csrfToken %>">
									<input type="hidden" name="lang" id="langField">
									<br><br>
									<!-- Step 1-->
									<div class="form-step active">
								
										<div class="form-group mt-3">
											<label for="name" class="form-label"><span data-i18n="form.name">Full Name</span><span class="text-danger">*</span></label>
											<input type="text" class="form-control" id="name" name="name" dir="auto" placeholder="Enter your full name" data-i18n-placeholder="form.placeholder.fullName" required>
										</div>
								
										<div class="form-group mt-3">
											<label for="email" class="form-label"><span data-i18n="form.email" >Email Address </span><span class="text-danger">*</span></label>
											<input type="email" class="form-control" id="email" name="email" placeholder="Enter your email address" data-i18n-placeholder="form.placeholder.email" required>
										</div>
								
								
										<div class="form-group mt-3">
											<label for="whatsapp" class="form-label"><span data-i18n="form.whatsapp">WhatsApp Number</span></label>
											<input type="tel" class="form-control" id="whatsapp" name="whatsapp" placeholder="+213 XXX-XX-XX-XX" data-i18n-placeholder="form.placeholder.whatsapp"
												required>
										</div>
								
										<div class="form-group mt-3">
											<label for="residence" class="form-label"><span data-i18n="form.city">City / Region</span><span class="text-danger">*</span></label>
											<input type="text" class="form-control" id="residence" name="residence" placeholder="Enter your city" data-i18n-placeholder="form.placeholder.city"
												dir="auto" required>
										</div>
								
										<div class="form-group mt-3" data-radio-group>
											<label class="form-label d-block"><span data-i18n="form.videoConsent">Do you consent to a video call for consultation?</span>
												<span class="text-danger">*</span></label>
											<div class="form-check form-check-inline">
												<input class="form-check-input" type="radio" name="video_consent" id="video_yes" value="Yes" required>
												<label class="form-check-label" for="video_yes"><span data-i18n="form.yes">Yes</span></label>
											</div>
											<div class="form-check form-check-inline">
												<input class="form-check-input" type="radio" name="video_consent" id="video_no" value="No" required>
												<label class="form-check-label" for="video_no"><span data-i18n="form.no">No</span></label>
											</div>
										</div>
								
										<div class="mt-4 text-end">
											<button type="button" class="btn btn-primary next-btn" data-i18n="form.next"></button>
										</div>
									</div>
								
									<!-- Step 2: Medical History -->
									<div class="form-step d-none">
								
										<div class="form-group mt-3">
											<div class="checkbox-group-wrapper">
												<label class="form-label"><span data-i18n="form.breastfeedingIssuesQuestion">What breastfeeding issues are you facing?</span></label>
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="diseases[]" value="Nipple/Breast Pain"
														id="disease1">
													<label class="form-check-label" for="disease1" data-i18n="form.issues.nipplePain">Nipple/Breast Pain</label>
												</div>
								
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="diseases[]" value="Difficulty Latching"
														id="disease2">
													<label class="form-check-label" for="disease2"><span data-i18n="form.issues.difficultyLatching">Difficulty Latching</span></label>
												</div>
								
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="diseases[]" value="Inverted/Flat Nipple"
														id="disease3">
													<label class="form-check-label" for="disease3"><span data-i18n="form.issues.flatNipple">Inverted/Flat Nipple</span></label>
												</div>
								
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="diseases[]"
														value="Baby is not gaining weight appropriately" id="disease4">
													<label class="form-check-label" for="disease4"><span data-i18n="form.issues.lowWeightGain">Baby is not gaining weight appropriately</span>
														</label>
												</div>
								
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="diseases[]" value="Low Milk Supply"
														id="disease5">
													<label class="form-check-label" for="disease5" data-i18n="form.issues.lowMilk"><span>Low Milk Supply</span></label>
												</div>
								
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="diseases[]" value="Relactation" id="disease6">
													<label class="form-check-label" for="disease6"><span data-i18n="form.issues.relactation">Relactation</span></label>
												</div>
								
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="diseases[]" value="Going back to work"
														id="disease7">
													<label class="form-check-label" for="disease7"><span data-i18n="form.issues.returnToWork">Going back to work</span>
														</label></label>
												</div>
								
												<div class="form-check">
													<input class="form-check-input" type="checkbox" name="diseases[]" value="Induced Lactation"
														id="disease8">
													<label class="form-check-label" for="disease8"><span data-i18n="form.issues.inducedLactation">Induced Lactation</span></label>
												</div>
								
								
												<!-- Autres maladies -->
												<div class="form-group mt-3">
													<label for="other_diseases"><span data-i18n="form.issues.other">Other (please specify):</span></label>
													<input type="text" class="form-control" id="other_diseases" name="other_diseases"
														placeholder="Specify other concern..." data-i18n-placeholder="form.placeholder.otherIssue" dir="auto">
												</div>
								
												<!-- Placeholder for validation error -->
												<div class="checkbox-error-placeholder mt-2"></div>
											</div>
										</div>
								
								
										<div class="form-group mt-4">
											<label for="concern_summary" class="form-label" data-i18n="form.concernSummary">What is your concern in brief
												words?</label>
											<textarea class="form-control" name="concern_summary" id="concern_summary" data-i18n-placeholder="form.placeholder.concernSummary" rows="3" dir="auto"
												required></textarea>
										</div>
								
										<div class="form-group mt-4" data-radio-group>
											<label class="form-label" data-i18n="form.paymentConfirmedQuestion">Was the appointment confirmed by paying the consultation
												fee? <span class="text-danger">*</span></label>
											<div class="form-check">
												<input class="form-check-input" type="radio" name="payment_confirmed" id="paid_yes" value="Yes"
													required>
												<label class="form-check-label" for="paid_yes" data-i18n="form.yes">Yes</label>
											</div>
											<div class="form-check">
												<input class="form-check-input" type="radio" name="payment_confirmed" id="paid_no" value="No" required>
												<label class="form-check-label" for="paid_no" for="paid_no" data-i18n="form.no">No</label>
											</div>
										</div>
								
										<div class="mt-4 d-flex justify-content-between">
											<button type="button" class="btn btn-secondary prev-btn" data-i18n="form.previous">Previous</button>
											<button id="submit-questionnaire" type="submit" class="btn btn-success"><span data-i18n="form.submit"></span></button>
										</div>
								
									</div>
								
								</form>
							</div>
						</div>
					</div>
				</section>
				<!-- End Patient Questionnaire Section -->
		
		
				<!-- Start Appointment Form Section (hidden by default) -->
				<section class="container-fluid mt-5 p-4" id="appointment-form" style="display: none;">
					<div id="schedules-data" data-schedules='<%= JSON.stringify(doctorSchedules) %>' hidden></div>
					<div class="row justify-content-center">
						<div class="col-12 col-md-8 col-lg-6">
							<div class="App card shadow p-4">
								<h3 class="App-title text-center" data-i18n="appointment.title">Book an Appointment</h3>
								<br><br>
								<form class="App-form" id="appointment">
									<input type="hidden" id="csrfToken" value="<%= csrfToken %>">
									<input type="hidden" name="lang" id="langField">
									<% if (preappointmentId) { %>
										<div id="preappointment-info" data-preappointment-id="<%= preappointmentId %>"
											class="alert alert-success">
											<span data-i18n="appointment.preCreated">Pre-appointment created</span>
										</div>
										<% } %>
											<br>
											<!-- Select a doctor -->
											<div class="mb-3 d-flex flex-column align-items-center" id="doctor-selection">
												<label class="form-label fw-bold" data-i18n="appointment.selectDoctor">Choose a docteur :</label>
												<div class="d-flex flex-column align-items-start gap-2" id="doctor-radio-group">
												</div>
											</div>
		
		
											<!-- Appointment Type -->
											<div class="mb-3">
												<label for="appointmentType" class="form-label fw-bold" data-i18n="appointment.typeLabel">Appointment
													Type:</label>
												<select class="form-select" id="appointmentType" name="appointmentType">
													<option value="" disabled selected data-i18n="appointment.selectType">Select type</option>
													<option value="feeding" data-i18n="appointment.type.feeding">Breastfeeding</option>
													<option value="pediatrics" data-i18n="appointment.type.pediatrics">Pediatrics</option>
												</select>
											</div>
		
											<!-- Feeding Mode (shown only if feeding is selected) -->
											<div class="mb-3" id="feedingModeContainer" style="display: none;">
												<label for="feedingMode" class="form-label fw-bold" data-i18n="appointment.modeLabel">Breastfeeding Appointment
													Mode:</label>
												<select class="form-select" id="feedingMode" name="feedingMode">
													<option value="" disabled selected data-i18n="appointment.selectMode">Select mode</option>
													<option value="online" data-i18n="appointment.mode.online">Online</option>
													<option value="Face-to-face" data-i18n="appointment.mode.facetoface">Face-to-face</option>
												</select>
											</div>
		
		
		
		
		
											<div class="container mt-4">
												<!-- Section: Navigation entre jours -->
												<div class="mb-4 text-center">
													<h5 class="dateSelect" data-i18n="appointment.selectDate">Select a Date:</h5>
													<br>
		
													<!-- Sélecteur de mois et année -->
													<select id="month-year-select" class="form-select w-auto mx-auto">
														<!-- Options seront ajoutées dynamiquement en JS -->
													</select>
		
													<br>
		
													<div class="d-flex align-items-center justify-content-center">
														<button type="button" class="btn btn-outline-primary mx-2"
															id="prev-day">◀</button>
														<strong class="paragraphe1" id="selected-date">Thursday, March
															27</strong>
														<button type="button" class="btn btn-outline-primary mx-2"
															id="next-day">▶</button>
													</div>
												</div>
		
												<!-- Créneaux horaires -->
												<div class="d-flex flex-column align-items-center mt-3" id="time-slots">
													<!-- Créneaux ajoutés dynamiquement -->
												</div>
											</div>
											<br><br>
		
											<div id="alert-container"></div>
								</form>
							</div>
						</div>
					</div>
				</section>
				<!-- End Appointment Form Section -->
				<br><br>
		
			</div>
			<!--End Contenu principal -->
		
		</main>
	
		<!-- Footer Area -->
		<footer id="footer" class="footer">
			<!-- Copyright -->
			<div class="copyright">
				<div class="container">
					<div class="row align-items-center">
						<!-- Copyright Text -->
						<div class="col-md-6 text-md-start text-center">
							<div class="copyright-content">
								<p data-i18n="footer.copyrightText">
									© Copyright 2025 | All Rights Reserved by
									<a href="#" target="_blank">Mommy&Me.com</a>
								</p>
							</div>
						</div>
						<!--/ End Copyright -->
		
						<!-- Social Media Icons -->
						<div class="col-md-6 text-md-end text-center">
							<div class="social-icons">
								<a href="https://web.facebook.com/dr.ouddah" target="_blank"
									class="text-white fs-4 p-2 btn btn-outline-light">
									<i style="font-size: 30px;" class="icofont-facebook display-4"></i>
								</a>
								<a href="https://www.instagram.com/dr.ouddah" target="_blank"
									class="text-white fs-4 p-2 btn btn-outline-light">
									<i style="font-size: 30px;" class="icofont-instagram display-4"></i>
								</a>
								<a href="https://www.linkedin.com/in/meriem-ouddah-88b097213/" target="_blank"
									class="text-white fs-4 p-2 btn btn-outline-light">
									<i style="font-size: 30px;" class="icofont-linkedin"></i>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</footer>
		<!--End Footer Area -->
	
	</div>







