				icon: '<%= message === "Your Preappointment has been successfully submitted." || message === "تم إرسال طلبك المسبق بنجاح" ? "success" : "error" %>',
				title: '<%= message ==="Your Preappointment has been successfully submitted." || message === "تم إرسال طلبك المسبق بنجاح" ? "success" : "Oops..." %>',
				text: "<%= message %>",
				confirmButtonText: 'OK'
			});
		</script>
	<% } %>


			





