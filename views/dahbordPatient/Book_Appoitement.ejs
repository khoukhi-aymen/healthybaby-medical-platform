		<!--Calendrier interactive Bootstrap JS + JavaScript dynamique -->
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const doctorRadios = document.querySelectorAll("input[name='doctor']");
				const selectedDateElem = document.getElementById("selected-date");
				const timeSlotsContainer = document.getElementById("time-slots");
				const prevDayBtn = document.getElementById("prev-day");
				const nextDayBtn = document.getElementById("next-day");
				const monthYearSelect = document.getElementById("month-year-select");

				let selectedDate = new Date();
				let expanded = false;

				// Extraire et parser les données depuis le div caché
				const rawData = document.getElementById("schedules-data").getAttribute("data-schedules");

				let doctorSchedules = {};
				try {
					doctorSchedules = JSON.parse(rawData);
					// console.log("✅ Données des plannings des docteurs chargées :", doctorSchedules);
				} catch (e) {
					// console.error("❌ Erreur lors du parsing des horaires des docteurs :", e);
				}


				//ajout dynamiques des doctors 
				const radioGroup = document.getElementById("doctor-radio-group");

				// Vérifie s'il y a des docteurs
				if (radioGroup && Object.keys(doctorSchedules).length > 0) {
					let isFirst = true;

					Object.keys(doctorSchedules).forEach((doctorKey) => {
						// Crée un élément form-check
						const wrapper = document.createElement("div");
						wrapper.className = "form-check";

						const input = document.createElement("input");
						input.className = "form-check-input";
						input.type = "radio";
						input.name = "doctor";
						input.id = doctorKey.replace(/\s+/g, "_"); // Pour un id sans espaces
						input.value = doctorKey;
						if (isFirst) input.checked = true;

						const label = document.createElement("label");
						label.className = "form-check-label";
						label.htmlFor = input.id;
						label.textContent = doctorKey;

						wrapper.appendChild(input);
						wrapper.appendChild(label);

						radioGroup.appendChild(wrapper);
						isFirst = false;
					});
					// Juste après avoir ajouté les boutons radio
					document.querySelectorAll("input[name='doctor']").forEach(radio => {
						radio.addEventListener("change", () => {
							updateDateDisplay(); // met à jour le planning selon le médecin sélectionné
						});
					});

				}

				function formatDate(date) {
					return date.toISOString().split("T")[0]; // Convertir en "YYYY-MM-DD"
				}

				function getSelectedDoctor() {
					if(document.querySelector("input[name='doctor']")){
					return document.querySelector("input[name='doctor']:checked").value;
					}
				}
				

				function updateTimeSlots() {
					timeSlotsContainer.innerHTML = "";
					const dateStr = formatDate(selectedDate);
					const doctorName = getSelectedDoctor();  // Nom du médecin sélectionné
					const doctorSchedule = doctorSchedules[doctorName]; // Récupérer les horaires du médecin par nom
					const slots = doctorSchedule?.schedules?.[dateStr];

					const availableSlots = Array.isArray(slots?.available) ? slots.available : [];
					const reservedSlots = Array.isArray(slots?.reserved) ? slots.reserved : [];

					const allSlots = [
						...availableSlots.map(s => ({ time: s, reserved: false })),
						...reservedSlots.map(s => ({ time: s, reserved: true }))
					];


					// 🔹 Tri des créneaux avant l'affichage
					allSlots.sort((a, b) => convertToMinutes(a.time) - convertToMinutes(b.time));

					allSlots.forEach((slot, index) => {
						let button = document.createElement("input");
						button.type = "button";
						button.className = `btn fw-bold w-100 text-center my-1 ${slot.reserved ? "btn-secondary disabled" : "btn-success"}`;
						button.style.backgroundColor = `${slot.reserved ? "rgb(73, 77, 83)" : "green"}`;
						button.style.color = `white`;
						button.value = slot.time;
						button.disabled = slot.reserved;

						if (!slot.reserved) {
							button.addEventListener("click", () => {
								// Vérification si le type de rendez-vous est sélectionné
								const appointmentType = document.getElementById("appointmentType").value;
								const appointmentMode = document.getElementById("feedingMode").value;
								if (!appointmentType) {
									Swal.fire({
										icon: "error",
										title: 'Oops...',
										html: '<p data-i18n="swal.selectAppointmentType">Please select an appointment type.</p>',
										didOpen: () => {
											// Ré-appliquer les traductions à l’intérieur de la boîte Swal
											const lang = localStorage.getItem("lang") || "en";
											fetch(`/lang/${lang}.json`)
												.then(res => res.json())
												.then(translations => {
													document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
														const key = el.getAttribute('data-i18n');
														if (translations[key]) el.innerHTML = translations[key];
													});
												});
										}
									});
									return;
								}


								// Si le type est "feeding", vérifier si le mode de rendez-vous est sélectionné
								if (appointmentType === "feeding") {
									if (!appointmentMode) {
										Swal.fire({
											icon: "error",
											title: 'Oops...',
											html: '<p data-i18n="swal.selectFeedingMode">Please select a feeding mode.</p>',
											didOpen: () => {
												// Ré-appliquer la traduction à l’intérieur de la popup Swal
												const lang = localStorage.getItem("lang") || "en";
												fetch(`/lang/${lang}.json`)
													.then(res => res.json())
													.then(translations => {
														document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
															const key = el.getAttribute('data-i18n');
															if (translations[key]) el.innerHTML = translations[key];
														});
													});
											}
										});
										return;
									}
								}
								


								// Si toutes les conditions sont remplies, afficher la confirmation
								if (button.classList.contains("btn-success")) {
									Swal.fire({
										title: '<span data-i18n="swal.appointmentSelected">Appointment Selected!</span>',
										html: `
											<p data-i18n="swal.selectedWith">You have selected an appointment with</p> 
											<strong>${doctorName}</strong> 
											<p><span data-i18n="swal.onDate">on</span> <strong>${dateStr}</strong> 
											<span data-i18n="swal.atTime">at</span> <strong>${slot.time}</strong>.</p>
											
											<br>
											
											<p>
												<span data-i18n="swal.type">Type:</span>
												<strong id="appointmentTypeTranslated" data-i18n=""></strong>
											</p>

											<p>
												<span data-i18n="swal.mode">Mode:</span>
												<strong id="appointmentModeTranslated" data-i18n=""></strong>
											</p>

											
											<br>
											<p data-i18n="swal.confirmBooking">Do you want to confirm this booking?</p>
										`,
										icon: 'question',
										showCancelButton: true,
										confirmButtonText: '<span data-i18n="swal.confirm">Book Appointment</span>',
										cancelButtonText: '<span data-i18n="swal.cancel">Cancel</span>',
										confirmButtonColor: '#28a745',
										cancelButtonColor: '#d33',
										didOpen: () => {
											const lang = localStorage.getItem('lang') || 'en';
											fetch(`/lang/${lang}.json`)
												.then(res => res.json())
												.then(translations => {
													// Traduire tous les éléments simples
													document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
														const key = el.getAttribute('data-i18n');
														if (translations[key]) el.innerHTML = translations[key];
													});

													// Traduire dynamiquement le type d'app
													const dynamicKey = `${appointmentType.toLowerCase()}`;
													const dynamicValue = translations?.[appointmentType.toLowerCase()];
													if (dynamicValue) {
														const typeEl = document.getElementById('appointmentTypeTranslated');
														typeEl.setAttribute('data-i18n', dynamicKey);
														typeEl.textContent = dynamicValue;
													} else {
														// fallback au texte brut si pas trouvé
														document.getElementById('appointmentTypeTranslated').textContent = appointmentType;
													}

													// === Traduction dynamique Mode ===
													const modeEl = document.getElementById('appointmentModeTranslated');

													if (appointmentType.toLowerCase() === 'feeding') {
														const modeKey = `${appointmentMode.toLowerCase()}`;
														const modeValue = translations?.[modeKey];

														if (modeValue) {
															modeEl.setAttribute('data-i18n', modeKey);
															modeEl.textContent = modeValue;
														} else {
															modeEl.textContent = appointmentMode;
														}
													} else {
														// Utilisation d'une clé de traduction commune pour "N/A"
														modeEl.setAttribute('data-i18n', 'na');
														modeEl.textContent = translations?.na || 'N/A';
													}

													// Alignement RTL si langue arabe
													if (lang === 'ar') {
														document.querySelector('.swal2-popup').dir = 'rtl';
													}
												});
										}
									}).then((result) => {
										if (result.isConfirmed) {
											// console.log("Booking confirmed for:", slot.time, doctorName, dateStr);

											// Vérification du créneau et mise à jour des horaires
											const daySchedule = doctorSchedule.schedules[dateStr];

											if (daySchedule) {
												const index = daySchedule.available.indexOf(slot.time);
												if (index !== -1) {
													console.log(index)
													daySchedule.available.splice(index, 1); // Supprimer de available
													if (!daySchedule.reserved) {
														daySchedule.reserved = [];
													}
													daySchedule.reserved.push(slot.time);

													// console.log("📅 Updated Schedule:", doctorSchedules);


													const appointmentType = document.getElementById("appointmentType").value;
													let appointmentMode = null;

													if (appointmentType === "feeding") {
														appointmentMode = document.getElementById("feedingMode").value;
													}

													// Récupérer l'ID du pré-rendez-vous depuis le DOM
													const preAppointmentElement = document.getElementById("preappointment-info");
													const preappointmentId = preAppointmentElement
														? preAppointmentElement.getAttribute("data-preappointment-id")
														: null;


													//récupérer le token depuis le dom
													const csrfInput = document.getElementById("csrfToken");
													if (!csrfInput) return; // Discret : pas de token => pas d'action

													const csrfToken = csrfInput.value;

													//récupérer la langue
													const lang = document.getElementById("langField").value;


													// Envoi de la réservation au serveur
													fetch('/BookAppoitement', {
														method: 'POST',
														headers: {
															"Content-Type":"application/json",
															"X-Requested-With": "XMLHttpRequest", //Ceci déclenche `req.xhr === true`
															"CSRF-Token": csrfToken
														},
														body: JSON.stringify({
															time: slot.time,
															doctor: doctorName,
															date: dateStr,
															doctorSchedule: doctorSchedules[doctorName], //Juste le planning de ce médecin
															preappointmentId: preappointmentId,
															appointmentType: appointmentType,
															appointmentMode: appointmentMode,
															scheduleId: doctorSchedules[doctorName]._id,  //ENVOI DE L'ID DU PLANNING(essentiel pour faire delete et update)
															lang: lang // <== ici on ajoute la langue
														})
													})
													.then(response => response.json())
													.then(data => {
															// Si redirection nécessaire
															if (data.redirectTo) {
																window.location.href = data.redirectTo;
																return;
															}

															if (data.success) {
																localStorage.removeItem("appointmentInProgress");
																Swal.fire({
																	icon: "success",
																	title: "Success!",
																	text: data.message
																}).then(() => {
																	// Recharge la page après que l'utilisateur ait cliqué sur "OK"
																	location.reload();
																});
															} else {
																Swal.fire({
																	icon: "error",
																	title: "Oops...",
																	text: data.message
																}).then(() => {
																	// Recharge la page après que l'utilisateur ait cliqué sur "OK"
																	location.reload();
																});
															}
													})
													.catch(err => {
															// Si la requête échoue, affiche une alerte d'erreur
															Swal.fire({
															icon: 'error',
															title: 'Oops...',
															html: `
															<p data-i18n="error.message">Something went wrong, please try again later.</p>
															`, 
															didOpen: () => {
																const lang = localStorage.getItem('lang') || 'en';
																fetch(`/lang/${lang}.json`)
																	.then(res => res.json())
																	.then(translations => {
																		document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
																			const key = el.getAttribute('data-i18n');
																			if (translations[key]) {
																				el.innerHTML = translations[key];
																			}
																		});

																		if (lang === 'ar') {
																			document.querySelector('.swal2-popup').dir = 'rtl';
																		}
																	});
															}
														}
																
													);
												});
												} else {
													Swal.fire({
														icon: 'warning',
														title: '<h3 data-i18n="warning.unavailableTitle">Unavailable time</h3>',
														html: `<p data-i18n="warning.unavailableText">The selected time slot is not available. Please choose another one.</p>`,
														didOpen: () => {
															const lang = localStorage.getItem('lang') || 'en';
															fetch(`/lang/${lang}.json`)
																.then(res => res.json())
																.then(translations => {
																	document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
																		const key = el.getAttribute('data-i18n');
																		if (translations[key]) {
																			el.innerHTML = translations[key];
																		}
																	});

																	if (lang === 'ar') {
																		document.querySelector('.swal2-popup').dir = 'rtl';
																	}
																});
														}
													});
												}
											} else {
												Swal.fire({
													icon: 'warning',
													title: '<span data-i18n="warning.noScheduleTitle">No schedule found</span>',
													html: `
														<p data-i18n="warning.noScheduleText">
														There is no schedule available for the selected date.
														</p>
													`,
													didOpen: () => {
														const lang = localStorage.getItem('lang') || 'en';
														fetch(`/lang/${lang}.json`)
															.then(res => res.json())
															.then(translations => {
																document.querySelectorAll('.swal2-popup [data-i18n]').forEach(el => {
																	const key = el.getAttribute('data-i18n');
																	if (translations[key]) {
																		el.innerHTML = translations[key];
																	}
																});

																if (lang === 'ar') {
																	document.querySelector('.swal2-popup').dir = 'rtl';
																}
															});
													}
												});

											}

										}
									});
								}
							});
						}

						// Masquer les créneaux au-delà du 3ème si non expand
						if (index >= 3 && !expanded) button.classList.add("d-none");
						timeSlotsContainer.appendChild(button);
					});

					// Vérifier si la date sélectionnée existe bien pour ce docteur
					const isDefined = doctorSchedule && doctorSchedule.schedules[dateStr];

					// Vérifier si la journée est fériée uniquement si elle existe
					const isHoliday = isDefined && Array.isArray(slots.available) && Array.isArray(slots.reserved) && slots.available.length === 0 && slots.reserved.length === 0;

					// Si c'est un jour férié, afficher "Closed"
					if (isHoliday) {
						let actionButton = document.createElement("input");
						actionButton.type = "button";
						actionButton.className = "btn w-100 fw-bold my-1";
						actionButton.value = "Closed"; // valeur par défaut
						actionButton.style.backgroundColor = "#dc3545"; // Rouge
						actionButton.style.color = "white";
						actionButton.disabled = true;

						// Ajout attribut de traduction
						actionButton.setAttribute("data-i18n", "label.closed");

						timeSlotsContainer.appendChild(actionButton);

						// Appliquer la traduction dynamique
						const lang = localStorage.getItem('lang') || 'en';
						fetch(`/lang/${lang}.json`)
							.then(res => res.json())
							.then(translations => {
								const key = actionButton.getAttribute('data-i18n');
								if (translations[key]) {
									actionButton.value = translations[key];
								}
								if (lang === 'ar') {
									actionButton.dir = 'rtl';
								}
							});
					}




					//s'Il n’y a pas de créneaux définis pour ce médecin à cette date => on affiche un bouton Unavailable pour informer l’utilisateur.
					if (!slots) {
						const nonDispoBtn = document.createElement("button");
						nonDispoBtn.className = "btn m-1 fw-bold w-100";
						nonDispoBtn.style.backgroundColor = "#d39e00"; // Jaune foncé
						nonDispoBtn.style.color = "white";
						nonDispoBtn.disabled = true;

						// Ajout de l'attribut de traduction
						nonDispoBtn.setAttribute("data-i18n", "label.unavailable");
						nonDispoBtn.textContent = "Unavailable"; // Valeur par défaut avant chargement traduction

						// Ajout au container
						timeSlotsContainer.appendChild(nonDispoBtn);

						// Appliquer la traduction dynamique
						const lang = localStorage.getItem('lang') || 'en';
						fetch(`/lang/${lang}.json`)
							.then(res => res.json())
							.then(translations => {
								const key = nonDispoBtn.getAttribute('data-i18n');
								if (translations[key]) {
									nonDispoBtn.textContent = translations[key];
								}
								if (lang === 'ar') {
									nonDispoBtn.dir = 'rtl';
								}
							});
					}



					// Bouton "Voir plus..." si nécessaire
					if (allSlots.length > 3) {
						let plusBtn = document.createElement("input");
						plusBtn.type = "button";
						plusBtn.value = expanded ? "See less" : "See more...";
						plusBtn.className = "btn btn-primary w-100 fw-bold my-1";
						plusBtn.style.backgroundColor = "blue";
						plusBtn.style.color = "white";

						plusBtn.addEventListener("click", function () {
							expanded = !expanded;
							document.querySelectorAll("#time-slots .btn:not([data-toggle-btn])").forEach((btn, index) => {
								if (index >= 3) {
									btn.classList.toggle("d-none", !expanded);
								}
							});

							// Mettre à jour la traduction après le clic
							const lang = localStorage.getItem('lang') || 'en';
							fetch(`/lang/${lang}.json`)
								.then(res => res.json())
								.then(translations => {
									const key = expanded ? "label.seeLess" : "label.seeMore";
									if (translations?.[key]) {
										plusBtn.value = translations[key];
									}
								});
						});

						plusBtn.setAttribute("data-toggle-btn", "true");
						timeSlotsContainer.appendChild(plusBtn);

						// Charger la langue initiale
						const lang = localStorage.getItem('lang') || 'en';
						fetch(`/lang/${lang}.json`)
							.then(res => res.json())
							.then(translations => {
								const key = expanded ? "label.seeLess" : "label.seeMore";
								if (translations?.[key]) {
									plusBtn.value = translations[key];
								}
							});
					}

				}

				// Fonction pour convertir une heure "HH:mm" en minutes (pour un tri correct)
				function convertToMinutes(timeStr) {
					let [hours, minutes] = timeStr.split(":").map(Number);
					return hours * 60 + minutes;
				}

				//Remplir le select avec les mois et années
				function populateMonthYearSelect() {
					let currentYear = new Date().getFullYear();
					let startYear = currentYear - 2; // Afficher les années autour de l'année actuelle
					let endYear = currentYear + 2;

					monthYearSelect.innerHTML = ""; // Vider avant de remplir

					for (let year = startYear; year <= endYear; year++) {
						for (let month = 0; month < 12; month++) {
							let date = new Date(Date.UTC(year, month, 1));
							let monthName = date.toLocaleDateString("fr-FR", { month: "long" });
							let option = document.createElement("option");
							option.value = `${year}-${month}`;
							option.textContent = `${monthName} ${year}`;

							// Sélectionner par défaut le mois et année actuels en UTC
							if (year === selectedDate.getUTCFullYear() && month === selectedDate.getUTCMonth()) {
								option.selected = true;
							}

							monthYearSelect.appendChild(option);
						}
					}
				}

				//Mettre à jour l'affichage de la date et synchroniser le select
				function updateDateDisplay() {
					selectedDateElem.textContent = selectedDate.toLocaleDateString("fr-FR", {
						weekday: 'long',
						day: 'numeric',
						month: 'long',
						year: 'numeric'
					});

					// Mettre à jour le select avec le bon mois/année
					monthYearSelect.value = `${selectedDate.getUTCFullYear()}-${selectedDate.getUTCMonth()}`;
					expanded = false;
					updateTimeSlots(); // Mise à jour de l'affichage des créneaux
				}


				//Gérer le changement de jour avec les flèches
				prevDayBtn.addEventListener("click", function () {
					selectedDate.setDate(selectedDate.getDate() - 1);
					updateDateDisplay();
				});

				nextDayBtn.addEventListener("click", function () {
					selectedDate.setDate(selectedDate.getDate() + 1);
					updateDateDisplay();
				});

				//Gérer le changement de mois avec le select
				monthYearSelect.addEventListener("change", function () {
					let [year, month] = this.value.split("-");
					selectedDate.setUTCFullYear(parseInt(year));
					selectedDate.setUTCMonth(parseInt(month));
					selectedDate.setUTCDate(1); // Aller au premier jour du mois sélectionné

					updateDateDisplay();
				});

				// Initialisation
				populateMonthYearSelect();
				updateDateDisplay();
			});
		</script>


		<!-- Script principal avec validation complète du formulaire et navigation entre étapes -->
		<!-- ce script fait les actions suivantes il il faut le remplacer par le script qui existe 
			✅ Ce que ce script fait maintenant :
			✅ Affiche le formulaire de rendez-vous après la soumission du formulaire de pré-rendez-vous.
					
			✅ Garde ce formulaire affiché même après rechargement de la page.
					
			✅ Le formulaire de pré-rendez-vous ne revient pas tant que le formulaire de rendez-vous n'est pas soumis.
					
			✅ L’état isCompleted est met a true le pre-rendez-vous soumis 
			pour que par la suite afficher le form de rendez vous meme aprés déconnexion -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const hasPreAppointmentString = "<%= JSON.stringify(hasPreAppointment) %>";
				const hasPreAppointment = (hasPreAppointmentString === "true");
				// console.log(hasPreAppointment); // true ou false en booléen


				const questionnaireForm = document.getElementById("questionnaire-form");
				const appointmentForm = document.getElementById("appointment-form");
				const submitQuestionnaireBtn = document.getElementById("submit-questionnaire");
				const appointmentSubmitBtn = document.getElementById("submit-appointment");

				const nextBtns = document.querySelectorAll('.next-btn');
				const prevBtns = document.querySelectorAll('.prev-btn');
				const message = "<%= message %>";

				// Affichage selon hasPreAppointment
				if (hasPreAppointment) {
					// L'utilisateur a un pré-rendez-vous complété : afficher le formulaire de rendez-vous
					if (questionnaireForm) questionnaireForm.parentElement.style.display = "none";
					if (appointmentForm) {
						appointmentForm.style.display = "block";
						appointmentForm.scrollIntoView({ behavior: "smooth" });
					}
				} else {
					// Pas de pré-rendez-vous : afficher le formulaire de pré-rendez-vous
					if (questionnaireForm) questionnaireForm.parentElement.style.display = "block";
					if (appointmentForm) appointmentForm.style.display = "none";
				}


				//Validation des groupes de checkboxes
				function validateCheckboxGroup(step) {
					const checkboxGroupWrapper = step.querySelector('.checkbox-group-wrapper');
					if (!checkboxGroupWrapper) return true;

					const checkboxes = checkboxGroupWrapper.querySelectorAll('input[type="checkbox"][name="diseases[]"]');
					const otherInput = checkboxGroupWrapper.querySelector('#other_diseases');
					const errorPlaceholder = checkboxGroupWrapper.querySelector('.checkbox-error-placeholder');

					const isAnyChecked = Array.from(checkboxes).some(cb => cb.checked);
					const hasOtherInput = otherInput && otherInput.value.trim() !== '';

					if (!isAnyChecked && !hasOtherInput) {
						if (!errorPlaceholder.querySelector('.checkbox-error-message')) {
							const error = document.createElement('div');
							error.classList.add('text-danger', 'checkbox-error-message');
							error.innerText = "Please select at least one disease or fill in the 'Other' field.";
							errorPlaceholder.appendChild(error);
						}
						return false;
					} else {
						const existingError = errorPlaceholder.querySelector('.checkbox-error-message');
						if (existingError) existingError.remove();
						return true;
					}
				}

				//Validation des groupes de boutons radio
				function validateRadioGroups(step) {
					let allValid = true;
					const radioGroups = step.querySelectorAll('[data-radio-group]');

					radioGroups.forEach(wrapper => {
						const radios = wrapper.querySelectorAll('input[type="radio"]');
						const name = radios[0]?.name;
						const isChecked = Array.from(radios).some(r => r.checked);
						let errorMsg = wrapper.querySelector('.radio-error-message');

						if (!isChecked) {
							allValid = false;
							if (!errorMsg) {
								errorMsg = document.createElement('div');
								errorMsg.classList.add('text-danger', 'radio-error-message');
								errorMsg.innerText = "Please select an option.";
								wrapper.appendChild(errorMsg);
							}
						} else if (errorMsg) {
							errorMsg.remove();
						}
					});

					return allValid;
				}

				//Validation générale
				function validateForm(step) {
					const requiredFields = step.querySelectorAll('[required]');
					let isValid = true;

					requiredFields.forEach(field => {
						let fieldValid = true;

						if (field.type === 'radio') return;
						else if (field.type === 'checkbox') return;
						else if (field.type === 'file') {
							fieldValid = field.files.length > 0;
						} else {
							fieldValid = field.value.trim() !== '';
						}

						if (!fieldValid) {
							isValid = false;
							field.classList.add('is-invalid');
							if (!field.nextElementSibling || !field.nextElementSibling.classList.contains('invalid-feedback')) {
								const errorMsg = document.createElement('div');
								errorMsg.classList.add('invalid-feedback');
								errorMsg.innerText = "This field is required.";
								field.parentElement.appendChild(errorMsg);
							}
						} else {
							field.classList.remove('is-invalid');
							if (field.nextElementSibling && field.nextElementSibling.classList.contains('invalid-feedback')) {
								field.nextElementSibling.remove();
							}
						}
					});

					if (!validateCheckboxGroup(step)) isValid = false;
					if (!validateRadioGroups(step)) isValid = false;

					return isValid;
				}

				//Navigation "Suivant"
				nextBtns.forEach(btn => {
					btn.addEventListener('click', function () {
						const currentStep = btn.closest('.form-step');
						if (validateForm(currentStep)) {
							const nextStep = currentStep.nextElementSibling;
							if (nextStep) {
								currentStep.classList.add('d-none');
								nextStep.classList.remove('d-none');
							}
						}
					});
				});

				//Navigation "Précédent"
				prevBtns.forEach(btn => {
					btn.addEventListener('click', function () {
						const currentStep = btn.closest('.form-step');
						const prevStep = currentStep.previousElementSibling;
						if (prevStep) {
							currentStep.classList.add('d-none');
							prevStep.classList.remove('d-none');
						}
					});
				});

				//Soumission du pré-rendez-vous
				if (submitQuestionnaireBtn) {
					submitQuestionnaireBtn.addEventListener("click", function (e) {
						const currentStep = questionnaireForm.querySelector('.form-step:not(.d-none)');
						if (validateForm(currentStep)) {
							questionnaireForm.parentElement.style.display = "none";
							appointmentForm.style.display = "block";
							appointmentForm.scrollIntoView({ behavior: "smooth" });
						} else {
							e.preventDefault();
						}
					});
				}

				//Soumission normale du pré-rendez-vous
				questionnaireForm.addEventListener('submit', function (e) {
					const currentStep = questionnaireForm.querySelector('.form-step:not(.d-none)');
					if (!validateForm(currentStep)) {
						e.preventDefault();
					}
				});
			});
		</script>



