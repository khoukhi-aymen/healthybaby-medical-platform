                                        class="bi bi-check-circle"></i> Active Accounts</a></li>
                            <li><a class="nav-link text-white" href="/PendingAccounts"><i
                                        class="bi bi-hourglass-split"></i> Pending Accounts</a></li>
                        </ul>
                    </div>
                </li>

