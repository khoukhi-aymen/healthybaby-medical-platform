        });
    </script>

    <!-- Script pour gérer le focus lors de la fermeture(cancel) de la modale de details témoignage
    (enlever l'erreur qui apprait aprés la fermuture de fenetre de details témoignage) -->
    <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
            const userDetailsModal = document.getElementById("userDetailsModal");
            const closeButton = userDetailsModal.querySelector(".btn-close");
            const openModalBtns = document.querySelectorAll('[data-bs-target="#userDetailsModal"]');

            let lastClickedOpenBtn = null;

            // Enregistrer le bouton qui a ouvert la modale
            openModalBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    lastClickedOpenBtn = btn;
                });
            });

            // ✅ Avant que la modale soit masquée, déplacer le focus ailleurs (évite l’erreur aria-hidden)
            userDetailsModal.addEventListener("hide.bs.modal", function () {
                // Si un élément à l’intérieur de la modale est encore focusé
                if (userDetailsModal.contains(document.activeElement)) {
                    // Déplace le focus temporairement sur le body
                    document.activeElement.blur();
                    document.body.focus();
                }
            });

            // ✅ Après la fermeture complète : remettre le focus sur le bouton qui a ouvert
            userDetailsModal.addEventListener("hidden.bs.modal", function () {
                if (lastClickedOpenBtn) {
                    lastClickedOpenBtn.focus();
                }
            });
        });
    </script>

    <!-- Script pour gérer le focus lors de la fermeture(cancel) de la modale de supprimer le témoignage
    (enlever l'erreur qui apprait aprés la fermuture de fenetre supprimer le témoignage) -->
    <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
            const confirmDeleteModal = document.getElementById("confirmDeleteModal");
            const openDeleteBtns = document.querySelectorAll(".btn-delete");

            let lastClickedDeleteBtn = null;

            // Mémoriser le bouton qui ouvre la modale
            openDeleteBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    lastClickedDeleteBtn = btn;
                });
            });

            // Avant que la modale soit cachée, retirer le focus si à l’intérieur
            confirmDeleteModal.addEventListener("hide.bs.modal", function () {
                const active = document.activeElement;
                if (confirmDeleteModal.contains(active)) {
                    active.blur();
                    document.body.focus(); // Focus neutre, empêche aria-hidden sur focus
                }
            });

            // Après fermeture, remettre le focus sur le bouton qui a ouvert
            confirmDeleteModal.addEventListener("hidden.bs.modal", function () {
                if (lastClickedDeleteBtn) {
                    lastClickedDeleteBtn.focus();
                }
            });
        });
    </script>


    <!-- script pour envoyer la suppression de témoigange -->
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            let selectedTestimonialId = null;

            const deleteErrorBox = document.getElementById('deleteErrorMessage');

            // Bouton delete -> ouvrir modale
            document.querySelectorAll('.btn-delete').forEach(button => {
                button.addEventListener('click', () => {
                    const row = button.closest('tr');
                    const testimonial = JSON.parse(row.getAttribute('data-testimonial'));
                    selectedTestimonialId = testimonial._id;

                    deleteErrorBox.classList.add('d-none');
                    deleteErrorBox.textContent = '';

                    const confirmDeleteModal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
                    confirmDeleteModal.show();
                });
            });

            // Confirmation suppression
            document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
                if (!selectedTestimonialId) return;

                fetch(`/ActiveTestimonials/delete/${selectedTestimonialId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        "X-Requested-With": "XMLHttpRequest", //Ceci déclenche `req.xhr === true`
                        'CSRF-Token': '<%= csrfToken %>'
                    }
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.redirectTo) {
                            window.location.href = data.redirectTo;
                            return;
                        }

                        if (data.success) {
                            const confirmDeleteModalEl = document.getElementById('confirmDeleteModal');
                            const confirmDeleteModal = bootstrap.Modal.getInstance(confirmDeleteModalEl);
                            if (confirmDeleteModal) confirmDeleteModal.hide();

                            confirmDeleteModalEl.addEventListener('hidden.bs.modal', () => {
                                Swal.fire({
                                    icon: "success",
                                    title: "Deleted!",
                                    text: data.message
                                }).then(() => {
                                    location.reload();
                                });
                            }, { once: true });

                        } else {
                            deleteErrorBox.textContent = data.message || 'An unknown error occurred.';
                            deleteErrorBox.classList.remove('d-none');
                        }
                    })
                    .catch(() => {
                        deleteErrorBox.textContent = "An error occurred. Please try again.";
                        deleteErrorBox.classList.remove('d-none');
                    });
            });
        });
    </script>
   
   <!-- script qui détecet automatiquement la langue récupérer depuis la bd et faire l'alignemet du texte 
          selon la langue -->
    <script nonce="<%= nonce %>">
        // Fonction réutilisable
        function applyLanguageDirection() {
            function isArabic(text) {
                return /[\u0600-\u06FF]/.test(text);
            }

            document.querySelectorAll('.dynamic-text').forEach(el => {
                const text = el.textContent.trim();
                if (isArabic(text)) {
                    el.style.direction = 'rtl';
                    el.style.textAlign = 'right';
                    el.lang = 'ar';
                    el.style.fontFamily = "'Arial', 'Tahoma', sans-serif";
                } else {
                    el.style.direction = 'ltr';
                    el.style.textAlign = 'left';
                    el.lang = 'fr';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', applyLanguageDirection);
    </script>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <% if (message) { %>
        <script nonce="<%= nonce %>">
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: "<%= message %>",
                confirmButtonText: 'OK'
            });
        </script>
        <% } %>


</body>

