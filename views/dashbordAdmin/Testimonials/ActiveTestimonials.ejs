                <h2 class="fw-bold">Welcome to Admin Dashboard</h2>
                <p class="text-muted">Manage your system here...</p>
            </div>
        
            <!-- Filter Form -->
            <form method="POST" action="/ActiveTestimonials" class="row g-3 align-items-end mb-4 bg-light p-3 rounded shadow-sm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" value="<%= startDate || '' %>">
                </div>
        
                <div class="col-md-4">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" value="<%= endDate || '' %>">
                </div>
        
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel-fill"></i> Filter
                    </button>
                </div>
                <div class="col-auto">
                    <a href="/ActiveTestimonials" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Reset
                    </a>
                </div>
            </form>

            <!-- Testimonials Table -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Active Testimonials</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="dataTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="w-25">#</th>
                                    <th class="w-25">Name</th>
                                    <th class="w-25">Status</th>
                                    <th class="w-25">Date</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% testimonials.forEach((testimonial, index)=> { %>
                                    <tr data-testimonial='<%- JSON.stringify(testimonial) %>'>
                                        <td class="w-25 text-truncate">
                                            <%= index + 1 %>
                                        </td>
                                        <td class="w-25 text-truncate dynamic-text">
                                            <%= testimonial.name %>
                                        </td>
                                        <td class="w-25 text-truncate">
                                            <span class="badge bg-success text-dark">
                                                <%= testimonial.status %>
                                            </span>
                                        </td>
                                        <td class="w-25 text-truncate">
                                            <%= new Date(testimonial.createdAt).toLocaleDateString("en-GB") %>
                                                <!-- Format : dd/mm/yyyy -->
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-3">
                                                <!-- Bouton View -->
                                                <button class="btn btn-sm text-white view-details-btn" style="background-color: #4ea4b5;" title="View"
                                                    data-bs-toggle="modal" data-bs-target="#userDetailsModal">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            
                                                <!-- Bouton Delete -->
                                                <button class="btn btn-sm text-white btn-delete" style="background-color: red;" title="Delete">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Testimonial Details Modal -->
            <div class="modal fade" id="userDetailsModal" tabindex="-1" aria-labelledby="userDetailsModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Testimonial Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
