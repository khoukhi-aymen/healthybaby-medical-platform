<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Title -->
    <title>Mommy & Me - Caring for Moms and Children</title>
		
    <!-- Favicon -->
    <link rel="icon" href="img/logo_healthy_baby.jpg">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="css/styleAdmin.css">
    <!-- Medipro CSS -->
    <link rel="stylesheet" href="css/normalize.css">
</head>

<body>

    <!-- Preloader -->
    <div class="preloader">
        <div class="loader">
            <div class="loader-outter"></div>
            <div class="loader-inner"></div>

            <div class="indicator">
                <svg width="16px" height="12px">
                    <polyline id="back" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
                    <polyline id="front" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
                </svg>
            </div>
        </div>
    </div>
    <!-- End Preloader -->


    <div class="dashboard-wrapper">
        <!-- Sidebar -->
        <nav class="sidebar d-none d-md-block p-3">
            <div class="text-center mb-4">
                <img src="img/logo_healthy_baby.jpg" alt="Logo" class="rounded-circle" width="80">
                <h5 class="mt-2 text-white">Admin Panel</h5>
            </div>

            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                        href="#userSubmenuDesktop" id="toggleUsersDesktop">
                        <span><i class="bi bi-people"></i> Accounts</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ms-3" id="userSubmenuDesktop">
                        <ul class="list-unstyled">
                            <li><a class="nav-link text-white" href="/ActiveAccounts"><i
                                        class="bi bi-check-circle"></i> Active Accounts</a></li>
                            <li><a class="nav-link text-white" href="/PendingAccounts"><i
                                        class="bi bi-hourglass-split"></i> Pending Accounts</a></li>
                        </ul>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                        href="#BlogsSubmenuDesktop" id="toggleBlogsDesktop">
                        <span><i class="bi bi-newspaper"></i> Blogs</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ms-3" id="BlogsSubmenuDesktop">
                        <ul class="list-unstyled">
                            <li><a class="nav-link text-white" href="/ActiveBlogs"><i
                                        class="bi bi-check-circle"></i> Active Blogs</a></li>
                            <li><a class="nav-link text-white" href="/PendingBlogs"><i
                                        class="bi bi-hourglass-split"></i> Pending Blogs</a></li>
                        </ul>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                        href="#TestimonialsSubmenuDesktop" id="toggleTestimonialsDesktop">
                        <span><i class="bi bi-chat-left-quote"></i> Testimonials</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ms-3" id="TestimonialsSubmenuDesktop">
                        <ul class="list-unstyled">
                            <li><a class="nav-link text-white" href="/ActiveTestimonials"><i
                                        class="bi bi-check-circle"></i> Active Testimonials</a></li>
                            <li><a class="nav-link text-white" href="/PendingTestimonials"><i
                                        class="bi bi-hourglass-split"></i> Pending Testimonials</a></li>
                        </ul>
                    </div>
                </li>

                <!--Nouvelle section : Contact Messages -->
                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center" href="/ContactMessages">
                        <span><i class="bi bi-envelope-paper"></i> Contact Messages</span>
                    </a>
                </li>

                <li class="nav-item">
                    <form method="POST" action="/logout">
                        <button class="nav-link text-danger border-0 bg-transparent" type="submit">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                </li>

            </ul>
        </nav>

        <!-- Main Content -->
        <div class="content-area">
            <!-- Mobile Menu Button -->
            <button class="btn btn-outline-primary d-md-none mb-3" type="button" data-bs-toggle="offcanvas"
                data-bs-target="#sidebar">
                <i class="bi bi-list"></i> Menu
            </button>
        
            <!-- Page Title -->
            <div class="mb-4">
                <h2 class="fw-bold">Welcome to Admin Dashboard</h2>
                <p class="text-muted">Manage your system here...</p>
            </div>

            <!-- Filter Form -->
            <form method="POST" action="/ActiveAccounts" class="row g-3 align-items-end mb-4 bg-light p-3 rounded shadow-sm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" value="<%= startDate || '' %>">
                </div>
        
                <div class="col-md-4">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" value="<%= endDate || '' %>">
                </div>
        
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel-fill"></i> Filter
                    </button>
                </div>
                <div class="col-auto">
                    <a href="/ActiveAccounts" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Reset
                    </a>
                </div>
            </form>

            <!-- Tableau des utilisateurs -->
            <div class="mt-4">
                <h4>Active Accounts</h4>
                <div class="table-responsive p-3">
                    <table class="table table-striped table align-items-center table-flush" id="dataTable">
                        <thead class="thead">
                            <tr>
                                <th class="w-25">#</th>
                                <th class="w-25">Name</th>
                                <th class="w-25">Email</th>
                                <th class="w-25">Date</th>
                                <th class="w-25">Role</th>
                                <th class="w-25">Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% accounts.forEach((account, index)=> { %>
                                <tr data-user='<%= JSON.stringify(account).replace(/' /g, "&apos;" ) %>'>
                                    <td class="w-25 text-truncate">
                                        <%= index + 1 %>
                                    </td>
                                    <td class="w-25 text-truncate dynamic-text">
                                        <%= account.full_name %>
                                    </td>
                                    <td class="w-25 text-truncate dynamic-text">
                                        <%= account.email %>
                                    </td>
                                    <td class="w-25 text-truncate">
                                        <%= new Date(account.createdAt).toLocaleDateString("en-GB") %>
                                    </td>
                                    <td class="w-25 text-truncate role-value">
                                        <%= account.role.charAt(0).toUpperCase() + account.role.slice(1) %>
                                    </td>
                                    <td class="w-25 text-truncate">
                                        <span class="badge bg-success text-dark">Approved</span>
                                    </td>
                                    <td class="d-flex">
                                        <button class="btn btn-sm me-2 view-user-btn" style="background-color: #4ea4b5;"
                                            data-bs-toggle="modal" data-bs-target="#userDetailsModal">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm me-2 btn-delete-active-account" style="background-color: red;">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Fin Tableau des utilisateurs -->


            <!-- Modal pour afficher les détails de l'utilisateur -->
            <div class="modal fade" id="userDetailsModal" tabindex="-1" aria-labelledby="userDetailsModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="userDetailsModalLabel">User Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div id="userDetails">
                                <!-- Les informations de l'utilisateur seront insérées ici par JavaScript -->
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Delete Active Account Confirmation Modal -->
            <div class="modal fade" id="confirmDeleteActiveAccountModal" tabindex="-1"
                aria-labelledby="confirmDeleteActiveAccountModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirm Active Account Deletion</h5>
                            <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to delete this active account?
                            <div id="deleteActiveAccountErrorMessage" class="alert alert-danger mt-3 d-none"></div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn" style="background-color: #6b6b6b; color: white; border: none;"
                                data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button class="btn" id="confirmDeleteActiveAccountBtn"
                                style="background-color: red; color: white; border: none;">
                                Yes, Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>


            
        </div>
    </div>

    <!-- Sidebar mobile (Offcanvas) -->
    <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="sidebar">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-white">Admin Panel</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                        href="#userSubmenuMobile" id="toggleUsersMobile">
                        <span><i class="bi bi-people"></i> Accounts</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ms-3" id="userSubmenuMobile">
                        <ul class="list-unstyled">
                            <li><a class="nav-link text-white" href="/ActiveAccounts"><i
                                        class="bi bi-check-circle"></i> Active Accounts</a></li>
                            <li><a class="nav-link text-white" href="/PendingAccounts"><i
                                        class="bi bi-hourglass-split"></i> Pending Accounts</a></li>
                        </ul>
                    </div>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                        href="#BlogsSubmenuMobile" id="toggleBlogsMobile">
                        <span><i class="bi bi-newspaper"></i> Blogs</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ms-3" id="BlogsSubmenuMobile">
                        <ul class="list-unstyled">
                            <li><a class="nav-link text-white" href="/ActiveBlogs"><i
                                        class="bi bi-check-circle"></i> Active Blogs</a></li>
                            <li><a class="nav-link text-white" href="/PendingBlogs"><i
                                        class="bi bi-hourglass-split"></i> Pending Blogs</a></li>
                        </ul>
                    </div>
                </li>


                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                        href="#TestimonialsSubmenuMobile" id="toggleTestimonialsMobile">
                        <span><i class="bi bi-chat-left-quote"></i> Testimonials</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ms-3" id="TestimonialsSubmenuMobile">
                        <ul class="list-unstyled">
                            <li><a class="nav-link text-white" href="/ActiveTestimonials"><i
                                        class="bi bi-check-circle"></i> Active Testimonials</a></li>
                            <li><a class="nav-link text-white" href="/PendingTestimonials"><i
                                        class="bi bi-hourglass-split"></i> Pending Testimonials</a></li>
                        </ul>
                    </div>
                </li>

                <!--Nouvelle section : Contact Messages -->
                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center" href="/ContactMessages">
                        <span><i class="bi bi-envelope-paper"></i> Contact Messages</span>
                    </a>
                </li>

                
                <form method="POST" action="/logout">
                    <button class="nav-link text-danger border-0 bg-transparent" type="submit">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </ul>
        </div>
    </div>



    <script src="js/jquery.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/main.js"></script>


    <!-- script pour afficher les détails de l'utilisateur dans le modal -->
     
    <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
            const viewButtons = document.querySelectorAll(".view-user-btn");

            // Fonction pour détecter la présence de texte arabe
            function containsArabic(text) {
                return /[\u0600-\u06FF]/.test(text);
            }

            viewButtons.forEach(button => {
                button.addEventListener("click", function () {
                    const row = button.closest("tr");
                    const userData = JSON.parse(row.getAttribute("data-user"));

                    const userId = row.cells[0].innerText.trim();
                    const userName = userData.full_name;
                    const userEmail = userData.email;
                    const userRoleRaw = userData.role.toLowerCase();
                    const userStatus = userData.status || "Pending";

                    // Formatage de la date complète avec heure, minute, seconde
                    const userDate = new Date(userData.createdAt).toLocaleString('en-GB', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    });

                    const isArabic = containsArabic(userName) || containsArabic(userEmail) || containsArabic(userData.Speciality || '') || containsArabic(userData.medical_license || '');

                    const userDetailsContainer = document.getElementById("userDetails");

                    let userDetailsHTML = `
                        <div style="text-align: ${isArabic ? 'right' : 'left'}; direction: ${isArabic ? 'rtl' : 'ltr'};" class="dynamic-text">
                            <p><strong>${isArabic ? 'المعرّف' : 'ID'}:</strong> ${userId}</p>
                            <p><strong>${isArabic ? 'الاسم الكامل' : 'Name'}:</strong> ${userName}</p>
                            <p><strong>${isArabic ? 'البريد الإلكتروني' : 'Email'}:</strong> ${userEmail}</p>
                            <p><strong>${isArabic ? 'الدور' : 'Role'}:</strong> ${userRoleRaw.charAt(0).toUpperCase() + userRoleRaw.slice(1)}</p>
                            <p><strong>${isArabic ? 'حالة الحساب' : 'Account Status'}:</strong> ${userStatus}</p>
                            <p><strong>${isArabic ? 'تاريخ الإنشاء' : 'Created On'}:</strong> ${userDate}</p>
                    `;

                    // Partie spécifique aux médecins
                    if (userRoleRaw === 'doctor') {
                        userDetailsHTML += `
                            <p><strong>${isArabic ? 'التخصص' : 'Speciality'}:</strong> ${userData.Speciality || (isArabic ? 'غير متوفر' : 'N/A')}</p>
                            <p><strong>${isArabic ? 'رقم الرخصة' : 'License Number'}:</strong> ${userData.medical_license || (isArabic ? 'غير متوفر' : 'N/A')}</p>
                            <p><strong>${isArabic ? 'الدبلوم الطبي' : 'Medical Diploma'}:</strong>
                                ${userData.diploma
                                ? `<a href="/uploads/${userData.diploma}" download style="color:blue; margin-left: 5px;">
                                                ${isArabic ? 'تحميل الدبلوم' : 'Download Medical Diploma'}
                                           </a>`
                                : `<span style="margin-left: 5px;">${isArabic ? 'لا يوجد دبلوم مرفوع' : 'No diploma uploaded'}</span>`
                            }
                            </p>
                        `;
                    }

                    if (userData.stats) {
                        if (userRoleRaw === 'parent') {
                            userDetailsHTML += `
                            <hr>
                            <h6 class="text-primary mb-3">${isArabic ? 'إحصائيات الحساب' : 'Account Statistics'}</h6>
                            <div class="row row-cols-1 row-cols-md-2 g-3">

                                <div class="col">
                                    <div class="card shadow-sm border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">${isArabic ? 'عدد المواعيد' : 'Total Appointments'}</h6>
                                            <p class="card-text fs-5 fw-bold text-success">
                                                <i class="bi bi-calendar-check"></i> ${userData.stats.totalAppointments || 0}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="card shadow-sm border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">${isArabic ? 'عدد الشهادات الموافق عليها' : 'Testimonials Approved'}</h6>
                                            <p class="card-text fs-5 fw-bold text-warning">
                                                <i class="bi bi-patch-check"></i> ${userData.stats.totalTestimonialsApproved || 0}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="card shadow-sm border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">${isArabic ? 'عدد التعليقات' : 'Total Comments'}</h6>
                                            <p class="card-text fs-5 fw-bold text-danger">
                                                <i class="bi bi-chat-dots"></i> ${userData.stats.totalComments || 0}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        `;
                        } else if (userRoleRaw === 'doctor') {
                            userDetailsHTML += `
                            <hr>
                            <h6 class="text-primary mb-3">${isArabic ? 'إحصائيات الحساب' : 'Account Statistics'}</h6>
                            <div class="row row-cols-1 row-cols-md-2 g-3">

                                <div class="col">
                                    <div class="card shadow-sm border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">${isArabic ? 'عدد المواعيد المحجوزة' : 'Reserved Appointments'}</h6>
                                            <p class="card-text fs-5 fw-bold text-success">
                                                <i class="bi bi-calendar-check"></i> ${userData.stats.totalAppointmentsAsDoctor || 0}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="card shadow-sm border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">${isArabic ? 'عدد الجداول' : 'Total Schedules'}</h6>
                                            <p class="card-text fs-5 fw-bold text-info">
                                                <i class="bi bi-clipboard-data"></i> ${userData.stats.totalDoctorsWithSchedules || 0}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="card shadow-sm border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">${isArabic ? 'عدد المدونات الموافق عليها' : 'Blogs Approved'}</h6>
                                            <p class="card-text fs-5 fw-bold text-primary">
                                                <i class="bi bi-journal-check"></i> ${userData.stats.totalBlogsApproved || 0}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="card shadow-sm border-0 bg-light h-100">
                                        <div class="card-body">
                                            <h6 class="card-title text-muted">${isArabic ? 'عدد التعليقات' : 'Total Comments'}</h6>
                                            <p class="card-text fs-5 fw-bold text-danger">
                                                <i class="bi bi-chat-dots"></i> ${userData.stats.totalComments || 0}
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        `;
                        }
                        // Si c'est admin : ne rien afficher (pas de stats)
                    }
                    


                    userDetailsHTML += '</div>';

                    userDetailsContainer.innerHTML = userDetailsHTML;

                    applyLanguageDirection(); // Corriger la direction RTL/LTR si nécessaire
                });
            });
        });
    </script>


    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

    <!-- Initialisation De DataTables JS -->
    <script nonce="<%= nonce %>">
        $(document).ready(function () {
            var table = $('#dataTable').DataTable({
                paging: true,
                pagingType: "full_numbers",
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                searching: true,
                ordering: true,
                info: true,
                language: {
                    lengthMenu: "Showing _MENU_ entries",
                    search: "Search:",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: ">",
                        previous: "<"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                }
            });

            // Appliquer les styles en ligne avec JS uniquement
            const wrapper = $('.dataTables_wrapper');

            const lengthControl = wrapper.find('.dataTables_length select');
            const filterControl = wrapper.find('.dataTables_filter');
            const inputsearch = wrapper.find('.dataTables_filter input');

            // Mettre en ligne les deux éléments sans les déplacer
            wrapper.find('.dataTables_length, .dataTables_filter').css({
                display: 'inline-block',
                verticalAlign: 'middle',
                margin: '10px 0'
            });

            // Aligner la barre de recherche à droite
            filterControl.css({
                float: 'right',
            });

            inputsearch.css({
                border: "1px solid black"
            })

            // 👉 Mettre "Search:" à côté de l'input
            filterControl.find('label').css({
                display: 'flex',
                alignItems: 'center',
                gap: '8px',
                marginBottom: '0',
                marginLeft: "2px",
            });

            //Appliquer un style sur le selct des entrées
            lengthControl.css({
                width: '100px',
                padding: '5px',
                borderRadius: '5px',
                border: '1px solid #ccc',
                display: "inline-block"
            });


            // Appliquer le style pagination
            function stylePagination() {
                let pagination = document.querySelector('.dataTables_paginate');
                if (pagination) {
                    pagination.style.display = 'flex';
                    pagination.style.alignItems = 'center';
                    pagination.style.justifyContent = 'flex-end';
                    pagination.style.gap = '5px';
                    pagination.style.borderRadius = '5px';
                    pagination.style.backgroundColor = '#f8f9fa';
                    pagination.style.border = '0px';
                }

                document.querySelectorAll('.paginate_button').forEach(button => {
                    button.style.display = 'inline-block';
                    button.style.color = '#333';
                    button.style.textDecoration = 'none';
                    button.style.border = '0px solid #ddd';
                    button.style.borderRadius = '3px';
                    button.style.cursor = 'pointer';
                    button.style.backgroundColor = '#fff';

                    button.addEventListener('mouseover', () => {
                        button.style.backgroundColor = '#e9ecef';
                    });
                    button.addEventListener('mouseout', () => {
                        button.style.backgroundColor = '#fff';
                    });

                    if (button.classList.contains('current')) {
                        button.style.backgroundColor = '#6c63ff';
                        button.style.color = '#fff';
                        button.style.fontWeight = 'bold';
                    }
                });
            }

            stylePagination();

            table.on('draw.dt', function () {
                stylePagination();
            });

            // Synchronisation externe
            $('#entries').on('change', function () {
                table.page.len($(this).val()).draw();
            });

            $('#searchInput').on('keyup', function () {
                table.search($(this).val()).draw();
            });
        });
    </script>



