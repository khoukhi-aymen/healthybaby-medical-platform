    <!-- Script pour gérer le focus lors de la fermeture de la modale de details account
            (enlever l'erreur qui apprait aprés la fermuture de fenetre de details account) -->
    <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
            const userDetailsModal = document.getElementById("userDetailsModal");
            const closeButton = userDetailsModal.querySelector(".btn-close");
            const openModalBtns = document.querySelectorAll('[data-bs-target="#userDetailsModal"]');

            let lastClickedOpenBtn = null;

            // Enregistrer le bouton qui a ouvert la modale
            openModalBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    lastClickedOpenBtn = btn;
                });
            });

            // ✅ Avant que la modale soit masquée, déplacer le focus ailleurs (évite l’erreur aria-hidden)
            userDetailsModal.addEventListener("hide.bs.modal", function () {
                // Si un élément à l’intérieur de la modale est encore focusé
                if (userDetailsModal.contains(document.activeElement)) {
                    // Déplace le focus temporairement sur le body
                    document.activeElement.blur();
                    document.body.focus();
                }
            });

            // ✅ Après la fermeture complète : remettre le focus sur le bouton qui a ouvert
            userDetailsModal.addEventListener("hidden.bs.modal", function () {
                if (lastClickedOpenBtn) {
                    lastClickedOpenBtn.focus();
                }
            });
        });
    </script>

    <!-- Script pour gérer le focus lors de la fermeture de la modale de suppression de compte -->
    <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
            const confirmDeleteActiveAccountModal = document.getElementById("confirmDeleteActiveAccountModal");
            const openDeleteActiveAccountBtns = document.querySelectorAll(".btn-delete-active-account");

            let lastClickedActiveDeleteBtn = null;

            openDeleteActiveAccountBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    lastClickedActiveDeleteBtn = btn;
                });
            });

            confirmDeleteActiveAccountModal.addEventListener("hide.bs.modal", function () {
                if (confirmDeleteActiveAccountModal.contains(document.activeElement)) {
                    document.activeElement.blur();
                    document.body.focus();
                }
            });

            confirmDeleteActiveAccountModal.addEventListener("hidden.bs.modal", function () {
                if (lastClickedActiveDeleteBtn) {
                    lastClickedActiveDeleteBtn.focus();
                }

                const errorBox = document.getElementById("deleteActiveAccountErrorMessage");
                if (errorBox) {
                    errorBox.textContent = "";
                    errorBox.classList.add("d-none");
                }
            });
        });
    </script>


    <!-- Script pour envoyer la suppression d’un compte -->

    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            let selectedActiveAccountId = null;

            const errorBox = document.getElementById('deleteActiveAccountErrorMessage');

            // Boutons de suppression
            document.querySelectorAll('.btn-delete-active-account').forEach(button => {
                button.addEventListener('click', () => {
                    const row = button.closest('tr');
                    const account = JSON.parse(row.getAttribute('data-user'));
                    selectedActiveAccountId = account.userId;

                    errorBox.classList.add('d-none');
                    errorBox.textContent = '';

                    const confirmModal = new bootstrap.Modal(document.getElementById('confirmDeleteActiveAccountModal'));
                    confirmModal.show();
                });
            });

            // Confirmation suppression
            document.getElementById('confirmDeleteActiveAccountBtn').addEventListener('click', () => {
                if (!selectedActiveAccountId) return;

                fetch(`/ActiveAccounts/delete/${selectedActiveAccountId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'CSRF-Token': '<%= csrfToken %>'
                    }
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.redirectTo) {
                            window.location.href = data.redirectTo;
                            return;
                        }

                        if (data.success) {
                            const confirmModalEl = document.getElementById('confirmDeleteActiveAccountModal');
                            const confirmModal = bootstrap.Modal.getInstance(confirmModalEl);

                            if (confirmModal) confirmModal.hide();

                            confirmModalEl.addEventListener('hidden.bs.modal', () => {
                                Swal.fire({
                                    icon: "success",
                                    title: "Deleted!",
                                    text: data.message
                                }).then(() => {
                                    location.reload();
                                });
                            }, { once: true });
                        } else {
                            errorBox.textContent = data.message || 'An unknown error occurred.';
                            errorBox.classList.remove('d-none');
                        }
                    })
                    .catch(() => {
                        errorBox.textContent = "An error occurred. Please try again.";
                        errorBox.classList.remove('d-none');
                    });
            });
        });
    </script>


    <!-- script qui détecet automatiquement la langue récupérer depuis la bd et faire l'alignemet du texte 
          selon la langue -->
    <script nonce="<%= nonce %>">
        // Fonction réutilisable
        function applyLanguageDirection() {
            function isArabic(text) {
                return /[\u0600-\u06FF]/.test(text);
            }

            document.querySelectorAll('.dynamic-text').forEach(el => {
                const text = el.textContent.trim();
                if (isArabic(text)) {
                    el.style.direction = 'rtl';
                    el.style.textAlign = 'right';
                    el.lang = 'ar';
                    el.style.fontFamily = "'Arial', 'Tahoma', sans-serif";
                } else {
                    el.style.direction = 'ltr';
                    el.style.textAlign = 'left';
                    el.lang = 'fr';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', applyLanguageDirection);
    </script>

