    <script src="js/jquery.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/main.js"></script>

    <!-- Script pour afficher le contenu du blog dans le modal -->
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            const detailButtons = document.querySelectorAll('.view-details-btn');

            // Fonction pour détecter la présence de texte arabe
            function containsArabic(text) {
                return /[\u0600-\u06FF]/.test(text);
            }

            detailButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const row = button.closest('tr');
                    const blog = JSON.parse(row.getAttribute('data-blog'));
                    const blogDetailsContainer = document.getElementById('blogDetails');
                    // Formatage de la date complète avec heure, minute, seconde
                    const blogDate = new Date(blog.createdAt).toLocaleString('en-GB', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit'
                    });

                    const isArabic = containsArabic(blog.title) || containsArabic(blog.author) || containsArabic(blog.content);

                    const metadataBlock = `
                        <div style="text-align: ${isArabic ? 'right' : 'left'}; direction: ${isArabic ? 'rtl' : 'ltr'};">
                            <p><strong>${isArabic ? 'معرّف المدوّنة' : 'Blog ID'}:</strong> ${blog._id}</p>
                            <p><strong>${isArabic ? 'الفئة' : 'Category'}:</strong> ${blog.category}</p>
                            <p><strong>${isArabic ? 'الحالة' : 'Status'}:</strong> ${blog.status}</p>
                            <p><strong>${isArabic ? 'تاريخ الإنشاء' : 'Created At'}:</strong> ${blogDate}</p>
                        </div>
                    `;

                    const blogDetailsHTML = `
                        <div class="dynamic-text">
                            ${metadataBlock}
                            <p><strong>${isArabic ? 'العنوان' : 'Title'}:</strong> ${blog.title.replace(/\n/g, '<br>')}</p>
                            <p><strong>${isArabic ? 'الكاتب' : 'Author'}:</strong> ${blog.author.replace(/\n/g, '<br>')}</p>
                            <p><strong>${isArabic ? 'المحتوى' : 'Content'}:</strong></p>
                            <p>${blog.content ? blog.content.replace(/\n/g, '<br>') : (isArabic ? 'لا يوجد محتوى.' : 'No content available.')}</p>
                            ${blog.image ? `<img src="/uploads/${blog.image}" alt="Blog Image" class="img-fluid mt-3"/>` : ''}
                        </div>
                    `;

                    blogDetailsContainer.innerHTML = blogDetailsHTML;
                    applyLanguageDirection(); // <--- ajouter ici
                });
            });
        });
    </script>








    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

    <!-- Initialisation De DataTables JS -->
    <script nonce="<%= nonce %>">
        $(document).ready(function () {
            var table = $('#dataTable').DataTable({
                paging: true,
                pagingType: "full_numbers",
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                searching: true,
                ordering: true,
                info: true,
                language: {
                    lengthMenu: "Showing _MENU_ entries",
                    search: "Search:",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: ">",
                        previous: "<"
                    },
                    info: "Showing _START_ to _END_ of _TOTAL_ entries"
                }
            });

            // Appliquer les styles en ligne avec JS uniquement
            const wrapper = $('.dataTables_wrapper');

            const lengthControl = wrapper.find('.dataTables_length select');
            const filterControl = wrapper.find('.dataTables_filter');
            const inputsearch = wrapper.find('.dataTables_filter input');

            // Mettre en ligne les deux éléments sans les déplacer
            wrapper.find('.dataTables_length, .dataTables_filter').css({
                display: 'inline-block',
                verticalAlign: 'middle',
                margin: '10px 0'
            });

            // Aligner la barre de recherche à droite
            filterControl.css({
                float: 'right',
            });

            inputsearch.css({
                border: "1px solid black"
            })

            // 👉 Mettre "Search:" à côté de l'input
            filterControl.find('label').css({
                display: 'flex',
                alignItems: 'center',
                gap: '8px',
                marginBottom: '0',
                marginLeft: "2px",
            });

            //Appliquer un style sur le selct des entrées
            lengthControl.css({
                width: '100px',
                padding: '5px',
                borderRadius: '5px',
                border: '1px solid #ccc',
                display: "inline-block"
            });


            // Appliquer le style pagination
            function stylePagination() {
                let pagination = document.querySelector('.dataTables_paginate');
                if (pagination) {
                    pagination.style.display = 'flex';
                    pagination.style.alignItems = 'center';
                    pagination.style.justifyContent = 'flex-end';
                    pagination.style.gap = '5px';
                    pagination.style.borderRadius = '5px';
                    pagination.style.backgroundColor = '#f8f9fa';
                    pagination.style.border = '0px';
                }

                document.querySelectorAll('.paginate_button').forEach(button => {
                    button.style.display = 'inline-block';
                    button.style.color = '#333';
                    button.style.textDecoration = 'none';
                    button.style.border = '0px solid #ddd';
                    button.style.borderRadius = '3px';
                    button.style.cursor = 'pointer';
                    button.style.backgroundColor = '#fff';

                    button.addEventListener('mouseover', () => {
                        button.style.backgroundColor = '#e9ecef';
                    });
                    button.addEventListener('mouseout', () => {
                        button.style.backgroundColor = '#fff';
                    });

                    if (button.classList.contains('current')) {
                        button.style.backgroundColor = '#6c63ff';
                        button.style.color = '#fff';
                        button.style.fontWeight = 'bold';
                    }
                });
            }

            stylePagination();

            table.on('draw.dt', function () {
                stylePagination();
            });

            // Synchronisation externe
            $('#entries').on('change', function () {
                table.page.len($(this).val()).draw();
            });

            $('#searchInput').on('keyup', function () {
                table.search($(this).val()).draw();
            });
        });
    </script>



    <!-- script pour afficher la sous liste de Accounts (cas Desktop) -->
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', function () {
            const desktopLink = document.getElementById('toggleUsersDesktop');
            const desktopSubmenu = document.getElementById('userSubmenuDesktop');

            desktopLink.addEventListener('click', function (e) {
                e.preventDefault();
                const isShown = desktopSubmenu.classList.contains('show');
                const collapse = new bootstrap.Collapse(desktopSubmenu, {
                    toggle: false
                });

                if (isShown) {
                    collapse.hide();
                } else {
                    collapse.show();
                }
            });
        });
    </script>




    <!-- script pour afficher la sous liste de Accounts (cas Mobile) -->
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', function () {
            function initMobileMenuToggle() {
                const isMobile = window.matchMedia("(max-width: 768px)").matches;
                if (!isMobile) return;

                const mobileLink = document.getElementById('toggleUsersMobile');
                const mobileSubmenu = document.getElementById('userSubmenuMobile');

                // Empêche de ré-attacher plusieurs fois l’événement
                if (mobileLink && !mobileLink.dataset.listenerAdded) {
                    mobileLink.addEventListener('click', function (e) {
                        e.preventDefault();
                        const isShown = mobileSubmenu.classList.contains('show');
                        const collapse = new bootstrap.Collapse(mobileSubmenu, {
                            toggle: false
                        });

                        if (isShown) {
                            collapse.hide();
                        } else {
                            collapse.show();
                        }
                    });

                    mobileLink.dataset.listenerAdded = "true"; // évite les doublons
                }
            }

            // Exécuter au chargement
            initMobileMenuToggle();

            // Ré-exécuter si la taille change (ex. resize orientation)
            window.addEventListener('resize', initMobileMenuToggle);
        });
    </script>


