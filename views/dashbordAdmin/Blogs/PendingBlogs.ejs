                            <li><a class="nav-link text-white" href="/ActiveTestimonials"><i
                                        class="bi bi-check-circle"></i> Active Testimonials</a></li>
                            <li><a class="nav-link text-white" href="/PendingTestimonials"><i
                                        class="bi bi-hourglass-split"></i> Pending Testimonials</a></li>
                        </ul>
                    </div>
                </li>

                <!--Nouvelle section : Contact Messages -->
                <li class="nav-item">
                    <a class="nav-link text-white d-flex justify-content-between align-items-center" href="/ContactMessages">
                        <span><i class="bi bi-envelope-paper"></i> Contact Messages</span>
                    </a>
                </li>

                <form method="POST" action="/logout">
