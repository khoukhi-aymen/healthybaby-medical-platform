                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="content-area container-fluid py-4">
            <!-- Mobile Menu Button -->
            <button class="btn btn-outline-primary d-md-none mb-3" type="button" data-bs-toggle="offcanvas"
                data-bs-target="#sidebar">
                <i class="bi bi-list"></i> Menu
            </button>
        
            <!-- Page Title -->
            <div class="mb-4">
                <h2 class="fw-bold">Welcome to Admin Dashboard</h2>
                <p class="text-muted">Manage your system here...</p>
            </div>

            <!-- Filter Form -->
            <form method="POST" action="/PendingBlogs" class="row g-3 align-items-end mb-4 bg-light p-3 rounded shadow-sm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="col-md-4">
                    <label for="startDate" class="form-label">Start Date</label>
                    <input type="date" id="startDate" name="startDate" class="form-control" value="<%= startDate || '' %>">
                </div>
        
                <div class="col-md-4">
                    <label for="endDate" class="form-label">End Date</label>
                    <input type="date" id="endDate" name="endDate" class="form-control" value="<%= endDate || '' %>">
                </div>
        
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel-fill"></i> Filter
                    </button>
                </div>
                <div class="col-auto">
                    <a href="/PendingBlogs" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Reset
                    </a>
                </div>
            </form>
        
            <!-- Blogs Table -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Pending Blogs</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="dataTable">
                            <thead class="table-light">
                                <tr>
                                    <th class="w-25">#</th>
                                    <th class="w-25">Title</th>
                                    <th class="w-25">Author</th>
                                    <th class="w-25">Category</th>
                                    <th class="w-25">Status</th>
                                    <th class="w-25">Date</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% blogs.forEach((blog, index)=> { %>
                                   <tr data-blog="<%= JSON.stringify(blog).replace(/\n/g, '<br>') %>">
                                        <td class="w-25 text-truncate">
                                            <%= index + 1 %>
                                        </td>
                                        <td class="w-25 text-truncate dynamic-text">
                                            <%= blog.title %>
                                        </td>
                                        <td class="w-25 text-truncate dynamic-text">
                                            <%= blog.author %>
                                        </td>
                                        <td class="w-25 text-truncate">
                                            <%= blog.category %>
                                        </td>
                                        <td class="w-25 text-truncate">
                                            <span class="badge bg-warning text-dark">
                                                <%= blog.status %>
                                            </span>
                                        </td>
                                        <td class="w-25 text-truncate">
                                            <%= new Date(blog.createdAt).toLocaleDateString("en-GB") %>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-3">
                                                <!-- View Button -->
                                                <button class="btn btn-sm text-white view-details-btn"
                                                    style="background-color: #4ea4b5;" title="View" data-bs-toggle="modal"
                                                    data-bs-target="#blogDetailsModal">
                                                    <i class="bi bi-eye"></i>
                                                </button>
            
                                                <!-- Delete Button -->
                                                <button type="button" class="btn btn-sm text-white btn-delete-blog" 
                                                    style="background-color: red;" title="Delete">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>

            
                                                <!-- Approve Button -->
                                                <button type="button" class="btn btn-sm text-white btn-approve-blog" 
                                                    style="background-color: green;" title="Approve">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>

                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


            <!-- Blog Details Modal -->
            <div class="modal fade" id="blogDetailsModal" tabindex="-1" aria-labelledby="blogDetailsModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-scrollable modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Blog Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div id="blogDetails"></div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Approve Blog Confirmation Modal -->
            <div class="modal fade" id="confirmApproveBlogModal" tabindex="-1" aria-labelledby="confirmApproveBlogModalLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirm Blog Approval</h5>
                            <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to approve this blog post?
                            <div id="approveBlogErrorMessage" class="alert alert-danger mt-3 d-none"></div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn" style="background-color: #6b6b6b; color: white; border: none;"
                                data-bs-dismiss="modal">
                                Cancel
                            </button>
                            <button class="btn" id="confirmApproveBlogBtn"
                                style="background-color: #28a745; color: white; border: none;">
                                Yes, Approve
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delete Confirmation Modal for Blogs -->
            <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Confirm Deletion</h5>
                            <button class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Are you sure you want to delete this blog post?
                            <div id="deleteErrorMessage" class="alert alert-danger mt-3 d-none"></div>
                        </div>
                        <div class="modal-footer">
                            <!-- IMPORTANT : Utiliser data-bs-dismiss sur Cancel -->
                            <button style="background-color: #6b6b6b; color: #ffffff; border: none;" class="btn"
                                data-bs-dismiss="modal">Cancel</button>
                            <button style="background-color: #df0202; color: white; border: none;" class="btn"
                                id="confirmDeleteBtn">Yes, Delete</button>
                        </div>
                    </div>
                </div>
            </div>






