                    });

                    mobileLink.dataset.listenerAdded = "true"; // évite les doublons
                }
            }

            // Exécuter au chargement
            initMobileMenuToggle();

            // Ré-exécuter si la taille change (ex. resize orientation)
            window.addEventListener('resize', initMobileMenuToggle);
        });
    </script>

    <!-- script pour afficher la sous liste de Testimonials (cas Desktop) -->
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', function () {
            const desktopLink = document.getElementById('toggleTestimonialsDesktop');
            const desktopSubmenu = document.getElementById('TestimonialsSubmenuDesktop');

            desktopLink.addEventListener('click', function (e) {
                e.preventDefault();
                const isShown = desktopSubmenu.classList.contains('show');
                const collapse = new bootstrap.Collapse(desktopSubmenu, {
                    toggle: false
                });

                if (isShown) {
                    collapse.hide();
                } else {
                    collapse.show();
                }
            });
        });
    </script>

    <!-- script pour afficher la sous liste des Testimonials (cas Mobile) -->
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', function () {
            function initMobileMenuToggle() {
                const isMobile = window.matchMedia("(max-width: 768px)").matches;
                if (!isMobile) return;

                const mobileLink = document.getElementById('toggleTestimonialsMobile');
                const mobileSubmenu = document.getElementById('TestimonialsSubmenuMobile');

                // Empêche de ré-attacher plusieurs fois l’événement
                if (mobileLink && !mobileLink.dataset.listenerAdded) {
                    mobileLink.addEventListener('click', function (e) {
                        e.preventDefault();
                        const isShown = mobileSubmenu.classList.contains('show');
                        const collapse = new bootstrap.Collapse(mobileSubmenu, {
                            toggle: false
                        });

                        if (isShown) {
                            collapse.hide();
                        } else {
                            collapse.show();
                        }
                    });

                    mobileLink.dataset.listenerAdded = "true"; // évite les doublons
                }
            }

            // Exécuter au chargement
            initMobileMenuToggle();

            // Ré-exécuter si la taille change (ex. resize orientation)
            window.addEventListener('resize', initMobileMenuToggle);
        });
    </script>

    <!-- Script pour gérer le focus lors de la fermeture(cancel) de la modale de details Blog
    (enlever l'erreur qui apprait aprés la fermuture de fenetre de details Blog) -->
    <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
            const blogDetailsModal = document.getElementById("blogDetailsModal");
            const closeButton = blogDetailsModal.querySelector(".btn-close");
            const openModalBtns = document.querySelectorAll('[data-bs-target="#blogDetailsModal"]');

            let lastClickedOpenBtn = null;

            openModalBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    lastClickedOpenBtn = btn;
                });
            });

            blogDetailsModal.addEventListener("hide.bs.modal", function () {
                if (blogDetailsModal.contains(document.activeElement)) {
                    document.activeElement.blur();
                    document.body.focus();
                }
            });

            blogDetailsModal.addEventListener("hidden.bs.modal", function () {
                if (lastClickedOpenBtn && typeof lastClickedOpenBtn.focus === "function") {
                    lastClickedOpenBtn.focus();
                }
            });
        });
    </script>

    <!-- Script pour gérer le focus lors de la fermeture(cancel) de la modale d'accepter un blog
    (enlever l'erreur qui apparaît après la fermeture de la fenêtre) -->

    <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
            const confirmApproveBlogModal = document.getElementById("confirmApproveBlogModal");
            const openApproveBlogBtns = document.querySelectorAll(".btn-approve-blog");

            let lastClickedApproveBlogBtn = null;

            // Mémoriser le bouton qui déclenche la modale
            openApproveBlogBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    lastClickedApproveBlogBtn = btn;
                });
            });

            // Avant de cacher : enlever le focus des éléments à l'intérieur
            confirmApproveBlogModal.addEventListener("hide.bs.modal", function () {
                if (confirmApproveBlogModal.contains(document.activeElement)) {
                    document.activeElement.blur();
                    document.body.focus();
                }
            });

            // Après fermeture : remettre le focus sur le bouton d'origine
            confirmApproveBlogModal.addEventListener("hidden.bs.modal", function () {
                if (lastClickedApproveBlogBtn) {
                    lastClickedApproveBlogBtn.focus();
                }
            });
        });
    </script>

    <!-- Script pour gérer le focus lors de la fermeture(cancel) de la modale de supprimer un blog
    (enlever l'erreur qui apprait aprés la fermuture de fenetre de supprimer un blog) -->

    <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
            const confirmDeleteModal = document.getElementById("confirmDeleteModal");
            const openDeleteBtns = document.querySelectorAll(".btn-delete-blog");

            let lastClickedDeleteBtn = null;

            // Mémoriser le bouton qui ouvre la modale
            openDeleteBtns.forEach(btn => {
                btn.addEventListener("click", () => {
                    lastClickedDeleteBtn = btn;
                });
            });

            // Avant que la modale soit cachée, retirer le focus si à l’intérieur
            confirmDeleteModal.addEventListener("hide.bs.modal", function () {
                const active = document.activeElement;
                if (confirmDeleteModal.contains(active)) {
                    active.blur();
                    document.body.focus(); // Focus neutre, empêche aria-hidden sur focus
                }
            });

            // Après fermeture, remettre le focus sur le bouton qui a ouvert
            confirmDeleteModal.addEventListener("hidden.bs.modal", function () {
                if (lastClickedDeleteBtn) {
                    lastClickedDeleteBtn.focus();
                }

                // Aussi, on enlève l'éventuelle erreur affichée dans la modale au cas où
                const errorBox = document.getElementById("deleteErrorMessage");
                if (errorBox) {
                    errorBox.textContent = "";
                    errorBox.classList.add("d-none");
                }
            });
        });
    </script>

    <!-- script pour envoyer l'acceptation de blog -->
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            let selectedBlogId = null;

            const errorBox = document.getElementById('approveBlogErrorMessage');

            document.querySelectorAll('.btn-approve-blog').forEach(button => {
                button.addEventListener('click', () => {
                    const row = button.closest('tr');
                    const blog = JSON.parse(row.getAttribute('data-blog'));
                    selectedBlogId = blog._id;

                    // Reset previous error message
                    errorBox.classList.add('d-none');
                    errorBox.textContent = '';

                    const confirmModal = new bootstrap.Modal(document.getElementById('confirmApproveBlogModal'));
                    confirmModal.show();
                });
            });

            document.getElementById('confirmApproveBlogBtn').addEventListener('click', () => {
                if (!selectedBlogId) return;

                fetch(`/PendingBlogs/approve/${selectedBlogId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        "X-Requested-With": "XMLHttpRequest",
                        'CSRF-Token': '<%= csrfToken %>'
                    }
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.redirectTo) {
                            window.location.href = data.redirectTo;
                            return;
                        }

                        if (data.success) {
                            const confirmModalEl = document.getElementById('confirmApproveBlogModal');
                            const confirmModal = bootstrap.Modal.getInstance(confirmModalEl);

                            if (confirmModal) {
                                confirmModal.hide();
                            }

                            confirmModalEl.addEventListener('hidden.bs.modal', () => {
                                Swal.fire({
                                    icon: "success",
                                    title: "Success!",
                                    text: data.message
                                }).then(() => {
                                    location.reload();
                                });
                            }, { once: true });

                        } else {
                            errorBox.textContent = data.message || 'An unknown error occurred.';
                            errorBox.classList.remove('d-none');
                        }
                    })
                    .catch(() => {
                        errorBox.textContent = "An error occurred. Please try again.";
                        errorBox.classList.remove('d-none');
                    });
            });
        });
    </script>


    <!-- script pour envoyer la suppression de blog -->
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            let selectedBlogId = null;

            const deleteErrorBox = document.getElementById('deleteErrorMessage');

            // Mémoriser le dernier bouton delete cliqué pour gestion du focus
            let lastClickedDeleteBtn = null;

            // Bouton delete -> ouvrir modale
            document.querySelectorAll('.btn-delete-blog').forEach(button => {
                button.addEventListener('click', () => {
                    lastClickedDeleteBtn = button; // mémoriser pour le focus plus tard

                    const row = button.closest('tr');
                    const blog = JSON.parse(row.getAttribute('data-blog'));
                    selectedBlogId = blog._id;

                    deleteErrorBox.classList.add('d-none');
                    deleteErrorBox.textContent = '';

                    const confirmDeleteModal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
                    confirmDeleteModal.show();
                });
            });

            // Confirmation suppression
            document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
                if (!selectedBlogId) return;

                fetch(`/PendingBlogs/delete/${selectedBlogId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        "X-Requested-With": "XMLHttpRequest", // Détecter requête Ajax côté serveur
                        'CSRF-Token': '<%= csrfToken %>'
                    }
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.redirectTo) {
                            window.location.href = data.redirectTo;
                            return;
                        }

                        if (data.success) {
                            const confirmDeleteModalEl = document.getElementById('confirmDeleteModal');
                            const confirmDeleteModal = bootstrap.Modal.getInstance(confirmDeleteModalEl);
                            if (confirmDeleteModal) confirmDeleteModal.hide();

                            confirmDeleteModalEl.addEventListener('hidden.bs.modal', () => {
                                Swal.fire({
                                    icon: "success",
                                    title: "Deleted!",
                                    text: data.message
                                }).then(() => {
                                    location.reload();
                                });
                            }, { once: true });

                        } else {
                            deleteErrorBox.textContent = data.message || 'An unknown error occurred.';
                            deleteErrorBox.classList.remove('d-none');
                        }
                    })
                    .catch(() => {
                        deleteErrorBox.textContent = "An error occurred. Please try again.";
                        deleteErrorBox.classList.remove('d-none');
                    });
            });

            // Gestion focus pour accessibilité modale suppression (comme pour témoignages)
            const confirmDeleteModal = document.getElementById("confirmDeleteModal");

            confirmDeleteModal.addEventListener("hide.bs.modal", function () {
                const active = document.activeElement;
                if (confirmDeleteModal.contains(active)) {
                    active.blur();
                    document.body.focus(); // Focus neutre
                }
            });

            confirmDeleteModal.addEventListener("hidden.bs.modal", function () {
                if (lastClickedDeleteBtn) {
                    lastClickedDeleteBtn.focus();
                }

                // Reset message d'erreur après fermeture
                deleteErrorBox.textContent = "";
                deleteErrorBox.classList.add("d-none");
            });
        });
    </script>

    <!-- script qui détecet automatiquement la langue récupérer depuis la bd et faire l'alignemet du texte 
      selon la langue -->
	<script nonce="<%= nonce %>">
		// Fonction réutilisable
		function applyLanguageDirection() {
			function isArabic(text) {
				return /[\u0600-\u06FF]/.test(text);
			}

			document.querySelectorAll('.dynamic-text').forEach(el => {
				const text = el.textContent.trim();
				if (isArabic(text)) {
					el.style.direction = 'rtl';
					el.style.textAlign = 'right';
					el.lang = 'ar';
					el.style.fontFamily = "'Arial', 'Tahoma', sans-serif";
				} else {
					el.style.direction = 'ltr';
					el.style.textAlign = 'left';
					el.lang = 'fr';
				}
			});
		}

		document.addEventListener('DOMContentLoaded', applyLanguageDirection);
	</script>






