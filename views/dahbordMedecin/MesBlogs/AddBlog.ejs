		<!-- Initialisation De DataTables JS -->
		<script nonce="<%= nonce %>">
			$(document).ready(function () {
				var table = $('#dataTable').DataTable({
					"paging": true,
					"pagingType": "full_numbers",
					"lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
					"searching": true,
					"ordering": true,
					"info": true,
					"language": {
						"lengthMenu": "Showing _MENU_ entries",
						"search": "searching :",
						"paginate": {
							"first": "First",
							"last": "Last",
							"next": ">",
							"previous": "<"
						},
						"info": "Showing _START_ à _END_ sur _TOTAL_ entries"
					}
				});

				// Appliquer le style à la pagination au chargement et après chaque changement de page
				function stylePagination() {
					let pagination = document.querySelector('.dataTables_paginate');
					if (pagination) {
						pagination.style.marginTop = "10px";
						pagination.style.display = 'flex';
						pagination.style.alignItems = 'center';
						pagination.style.justifyContent = 'flex-end';
						pagination.style.gap = '5px';
						pagination.style.borderRadius = '5px';
						pagination.style.backgroundColor = '#f8f9fa'; // Fond clair
						pagination.style.border = '0px';
					}

					document.querySelectorAll('.paginate_button').forEach(button => {
						button.style.display = 'inline-block';
						button.style.color = '#333';
						button.style.textDecoration = 'none';
						button.style.border = '0px solid #ddd';
						button.style.borderRadius = '3px';
						button.style.cursor = 'pointer';
						button.style.backgroundColor = '#fff';

						// Effet au survol
						button.addEventListener('mouseover', () => {
							button.style.backgroundColor = '#e9ecef';
						});
						button.addEventListener('mouseout', () => {
							button.style.backgroundColor = '#fff';
						});

						// Mettre en évidence la page active
						if (button.classList.contains('current')) {
							button.style.backgroundColor = '#6c63ff'; // Bleu foncé
							button.style.color = '#fff';
							button.style.fontWeight = 'bold';
						}
					});
				}

				// Appliquer le style au chargement
				stylePagination();

				// Appliquer le style après chaque changement de page
				table.on('draw.dt', function () {
					stylePagination();
				});


				// Synchronisation du sélecteur avec DataTables
				$('#entries').on('change', function () {
					table.page.len($(this).val()).draw();
				});

				// Synchronisation de la barre de recherche avec DataTables
				$('#searchInput').on('keyup', function () {
					table.search($(this).val()).draw();
				});
			});

		</script>


		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<% if (message) { %>
			<script nonce="<%= nonce %>">
				Swal.fire({
					icon: '<%= message === "Thank you! Your blog has been submitted and will be reviewed by our team before publication." ? "success" : "error" %>',
					title: '<%= message ==="Thank you! Your blog has been submitted and will be reviewed by our team before publication." ? "success" : "Oops..." %>',
					text: "<%= message %>",
					confirmButtonText: 'OK'
				});
			</script>
		<% } %>
			
    </body>
</html>