									<div class="logo">
										<a href="/MyAppoitements"
											class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
											<img src="img/logo_healthy_baby.jpg" alt="Logo" width="50">
											<span style="margin-left: 10px;" class="fs-5 ms-3 fw-bold">My Account</span>
										</a>
									</div>
									<!-- End Logo -->
									<!-- Mobile Nav -->
									<div class="mobile-nav"></div>
									<!-- End Mobile Nav -->
								</div>
								<div class="col-lg-7 col-md-9 col-12">
									<!-- Main Menu -->
									<div class="main-menu">
										<nav class="navigation">
											<ul class="nav menu">
												<li class="nav-item">
													<a href="/MyAppoitements" class="nav-link active">
														<span>My Appointments</span>
													</a>
												</li>
												<li>
													<a href="#">Blogs <i class="icofont-rounded-down"></i></a>
													<ul class="dropdown">
														<li><a href="/MyBlogs"><strong>My Blogs</strong></a></li>
												
														<!-- Séparation améliorée -->
														<li style="border-top: 1px solid #ccc; margin: 5px 0;">
															<strong style="display:block; padding: 5px 15px; color: #555; cursor: default; user-select: none;">
																Categories
															</strong>
														</li>
												
														<li class="dropdown-divider"></li>
												
														<li><a href="/MyAppoitements/General">General</a></li>
														<li><a href="/MyAppoitements/Nutrition">Nutrition</a></li>
														<li><a href="/MyAppoitements/mental-health">Mental Health</a></li>
														<li><a href="/MyAppoitements/Pediatrics">Pediatrics</a></li>
														<li><a href="/MyAppoitements/Breastfeeding">Breastfeeding</a></li>
														<li><a href="/MyAppoitements/Parenting-advice">Parenting Advice</a></li>
														<li><a href="/MyAppoitements/Others">Others</a></li>
													</ul>
												</li>
		
												<li class="nav-item">
