		<div class="page-container">
		
			<!-- Preloader -->
			<div class="preloader">
				<div class="loader">
					<div class="loader-outter"></div>
					<div class="loader-inner"></div>
		
					<div class="indicator">
						<svg width="16px" height="12px">
							<polyline id="back" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
							<polyline id="front" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
						</svg>
					</div>
				</div>
			</div>
			<!-- End Preloader -->
		
			<!-- Get Pro Button -->
			<ul class="pro-features">
				<input style="background-color: #ee5086;border: 0px solid #ee5086;" type="button" value="Setup"
					class="get-pro text-white" />
				<!-- Titre principal amélioré -->
				<li class="fw-bold text-center fs-5 text-primary">Blogs Panel</li>
				<div class="button">
					<div class="get-quote">
						<!-- <button id="darkModeToggle" class="btn btn-outline-light mt-3 w-100">
							<i class="icofont-moon"></i> Dark Mode
						</button> -->
						<a href="/AddBlog" class="text-white btn btn-primary w-100">Add Blog</a>
					</div>
				</div>
			</ul>
			<!--End Get Pro Button -->
		
		
		
