							<div class="col-lg-6 col-md-7 col-12">
								<!-- Top Contact -->
								<ul class="top-contact">
									<li class="num"><i class="fa fa-phone"></i>+213 562 39 20 55</li>
									<li class="email"><i class="fa fa-envelope"></i><a
											href="mailto:support@yourmail.com">mommyandmeclinic@outlook.com</a></li>
								</ul>
								<!-- End Top Contact -->
							</div>
							<!-- Contenu principal -->
						</div>
					</div>
				</div>
				<!-- End Topbar -->
				<!-- Header Inner -->
				<div class="header-inner">
					<div class="container">
						<div class="inner">
							<div class="row">
								<div class="col-lg-3 col-md-3 col-12">
