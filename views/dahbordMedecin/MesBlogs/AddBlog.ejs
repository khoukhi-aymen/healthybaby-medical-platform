			<main class="content-wrap">
			
				<!-- Breadcrumbs -->
				<div class="breadcrumbs overlay">
					<div class="container">
						<div class="bread-inner">
							<div class="row">
								<div class="col-12">
									<h2>Add Blog</h2>
									<ul class="bread-list">
										<li><a href="/MyBlogs">My Blogs</a></li>
										<li><i class="icofont-simple-right"></i></li>
										<li class="active">Add Blog</li>
									</ul>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- End Breadcrumbs -->
			
				<!-- Start Medical Blog Form -->
				<section class="container pb-5 mt-5">
					<div class="row justify-content-center">
						<div class="col-md-8">
							<div class="medical-blog-form card shadow p-4">
								<h3 class="titre text-center">Add a Medical Blog</h3>
								<form id="medical-blog-form" method="post" action="/AddBlog" enctype="multipart/form-data">
									<input type="hidden" name="_csrf" value="<%= csrfToken %>">
									<div class="mb-3">
										<label class="paragraphe1 form-label">Blog Title</label>
										<input type="text" name="title" class="form-control" placeholder="Enter blog title" dir="auto"
											required >
									</div>
									<div class="mb-3">
										<label class="paragraphe2 form-label">Author</label>
										<input type="text" name="author" class="form-control" placeholder="Enter author's name" dir="auto"
											required>
									</div>
									<div class="mb-3">
										<label class="paragraphe3 form-label">Category</label>
										<select name="category" class="form-control" required>
											<option value="" disabled selected>Select a category</option>
											<option value="general">General Health</option>
											<option value="nutrition">Nutrition</option>
											<option value="mental-health">Mental Health</option>
											<option value="pediatrics">Pediatrics</option>
											<option value="feeding">Breastfeeding</option>
											<option value="parenting-advice">parenting advice</option>
											<option value="others">others</option>
										</select>
									</div>
									<div class="mb-3">
										<label class="paragraphe4 form-label">Upload an Image</label>
										<input type="file" name="image" class="form-control" accept="image/*" required>
										<small class="form-text text-muted">
											Accepted file types: <strong>.jpg, .jpeg, .png</strong>
										</small>
									</div>
									<div class="mb-3">
										<label class="paragraphe5 form-label">Content</label>
										<textarea name="content" class="form-control" rows="5"
											placeholder="Write your blog content here" dir="auto" required></textarea>
									</div>
									<button type="submit" class="btn btn-primary w-100">
										Publish Blog
									</button>
								</form>
							</div>
						</div>
					</div>
				</section>
				<!-- End Medical Blog Form -->
			
			</main>
		
			<!-- Footer Area -->
			<footer id="footer" class="footer">
				<!-- Copyright -->
				<div class="copyright">
					<div class="container">
						<div class="row align-items-center">
							<!-- Copyright Text -->
							<div class="col-md-6 text-md-start text-center">
