	<!-- Script pour afficher les détails -->
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script nonce="<%= nonce %>">
		document.addEventListener("DOMContentLoaded", () => {
			function containsArabic(text) {
				return /[\u0600-\u06FF]/.test(text);
			}

			document.querySelectorAll(".view-blog-btn").forEach((button) => {
				button.addEventListener("click", () => {
					const row = button.closest("tr");
					const blogTitle = row.cells[1].innerText;
					const blogAuthor = row.cells[2].innerText;
					const blogCategory = row.cells[3].innerText;
					const blogStatus = row.cells[5].innerText;
					const blogDate = row.dataset.createdAt;    

					const blogContent = row.dataset.content;
					const blogImage = "/uploads/" + row.dataset.image;

					const isArabic =
						containsArabic(blogTitle) ||
						containsArabic(blogAuthor) ||
						containsArabic(blogContent) ||
						containsArabic(blogCategory);

					const direction = isArabic ? 'rtl' : 'ltr';
					const align = isArabic ? 'right' : 'left';

					const generateHtml = () => `
	          				<div class="dynamic-text" style="max-height: 400px; overflow-y: auto; text-align: ${align}; direction: ${direction}; white-space: pre-line; line-height: 1.8;">
	            				<p><strong>${isArabic ? 'العنوان' : 'Title'}:</strong> ${blogTitle}</p>
	            				<p><strong>${isArabic ? 'المؤلف' : 'Author'}:</strong> ${blogAuthor}</p>
	            				<p><strong>${isArabic ? 'الصنف' : 'Category'}:</strong> ${blogCategory}</p>
	            				<p><strong>${isArabic ? 'المحتوى' : 'Content'}:</strong><br>${blogContent}</p>
	            				<p><strong>${isArabic ? 'الحالة' : 'Status'}:</strong> ${blogStatus}</p>
	            				<p><strong>${isArabic ? 'تاريخ الإنشاء' : 'Created At'}:</strong> ${blogDate}</p>
	            				<img src="${blogImage}" alt="${blogTitle}" 
	             					 style="width: 150px; height: auto; cursor: pointer; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.2); margin-top: 20px;"
	             					 id="previewImage">
	          				</div>
	       			 `;

					// Première alerte
					Swal.fire({
						html: `<h2 class="dynamic-text text-center mb-3">${blogTitle}</h2>${generateHtml()}`,
						width: 700,
						confirmButtonColor: '#3085d6',
						confirmButtonText: isArabic ? 'إغلاق' : 'Close',
						didOpen: () => {
							const previewImage = document.getElementById("previewImage");
							// Appliquer la direction sur le contenu dynamique
							applyLanguageDirection();

							previewImage.addEventListener("click", () => {
								// Image en grand
								Swal.fire({
									title: `${isArabic ? 'صورة' : 'Image'} - ${blogTitle}`,
									imageUrl: blogImage,
									imageWidth: '100%',
									imageHeight: 'auto',
									imageAlt: blogTitle,
									showConfirmButton: false,
									showCloseButton: true,
								}).then(() => {
									// Retour à la première alerte
									Swal.fire({
										html: `<h2 class="dynamic-text text-center mb-3">${blogTitle}</h2>${generateHtml()}`,
										width: 700,
										confirmButtonText: isArabic ? 'إغلاق' : 'Close',
										confirmButtonColor: '#3085d6',
										didOpen: () => {
											const previewImage = document.getElementById("previewImage");
											// Appliquer la direction sur le contenu dynamique
											applyLanguageDirection();

											previewImage.addEventListener("click", () => {
												Swal.fire({
													title: `${isArabic ? 'صورة' : 'Image'} - ${blogTitle}`,
													imageUrl: blogImage,
													imageWidth: '100%',
													imageHeight: 'auto',
													imageAlt: blogTitle,
													showConfirmButton: false,
													showCloseButton: true,
												});
											});
										}
									});
								});
							});
						}
					});
				});
			});
		});
	</script>


	<!-- Script pour supprimer un blog -->
	<script nonce="<%= nonce %>">
		document.addEventListener("DOMContentLoaded", () => {
			const csrfToken = "<%= csrfToken %>";
			// Sélectionne tous les boutons ayant l'ID deleteBlogBtn
			document.querySelectorAll(".deleteBlogBtn").forEach((button) => {
				button.addEventListener("click", (event) => {
					// Récupère l'ID du blog à supprimer à partir de l'attribut data-blog-id du bouton
					const blogId = event.currentTarget.dataset.blogId;


					// Affiche une alerte de confirmation avant de supprimer le blog
					Swal.fire({
						title: 'Are you sure you want to delete this blog?',
						text: "This action cannot be undone.",
						icon: 'warning',
						showCancelButton: true, // Affiche un bouton pour annuler
						confirmButtonText: 'Yes, delete it!',
						cancelButtonText: 'Cancel',
						confirmButtonColor: '#3085d6',
						cancelButtonColor: '#d33',
					}).then((result) => {
						// Si l'utilisateur confirme la suppression
						if (result.isConfirmed) {
							// Envoie la requête DELETE au backend pour supprimer le blog
							fetch(`/MyBlogs/delete/${blogId}`, {
								method: "POST",
								headers: {
									"Content-Type": "application/json",
									"X-Requested-With": "XMLHttpRequest", //Ceci déclenche `req.xhr === true`
									"CSRF-Token": csrfToken //Important pour Express avec csurf
								}
							})
								.then(response => response.json())
								.then(data => {
									// Si redirection nécessaire
									if (data.redirectTo) {
										window.location.href = data.redirectTo;
										return;
									}

									if (data.success) {
										// Affiche une alerte de succès après la suppression
										Swal.fire({
											icon: "success",
											title: "Deleted!",
											text: data.message
										}).then(() => {
											// Recharge la page pour mettre à jour l'affichage des blogs
											window.location.reload();
										});
									} else {
										// Affiche une alerte d'erreur si la suppression échoue
										Swal.fire({
											icon: "error",
											title: "Oops...",
											text: data.message
										});
									}
								})
								.catch(error => {
									// Si la requête échoue, affiche une alerte d'erreur
									Swal.fire(
										'Oops...',
										'Something went wrong, please try again later.',
										'error'
									);
								});
						}
					});
				});
			});
		});
	</script>



	<!-- Script pour faire update sur un blog -->
	<script nonce="<%= nonce %>">
		document.addEventListener("DOMContentLoaded", () => {
			document.querySelectorAll(".updateBlogBtn").forEach((button) => {
				button.addEventListener("click", (event) => {
					const blogId = event.currentTarget.dataset.blogId;

					// Afficher une confirmation avant d'effectuer la mise à jour
					Swal.fire({
						title: 'Are you sure you want to update this blog?',
						text: "You will be redirected to the update page.",
						icon: 'warning',
						showCancelButton: true,
						confirmButtonText: 'Yes, update it!',
						cancelButtonText: 'Cancel',
						confirmButtonColor: '#3085d6',
						cancelButtonColor: '#d33',
					}).then((result) => {
						if (result.isConfirmed) {
							// Rediriger vers la page de mise à jour avec l'ID du blog
							window.location.href = `/MyBlogs/update/${blogId}`;
						}
					});
				});
			});
		});
	</script>

	<!-- script qui détecet automatiquement la langue récupérer depuis la bd et faire l'alignemet du texte 
      selon la langue -->
	<script nonce="<%= nonce %>">
		// Fonction réutilisable
		function applyLanguageDirection() {
			function isArabic(text) {
				return /[\u0600-\u06FF]/.test(text);
			}

			document.querySelectorAll('.dynamic-text').forEach(el => {
				const text = el.textContent.trim();
				if (isArabic(text)) {
					el.style.direction = 'rtl';
					el.style.textAlign = 'right';
					el.lang = 'ar';
					el.style.fontFamily = "'Arial', 'Tahoma', sans-serif";
				} else {
					el.style.direction = 'ltr';
					el.style.textAlign = 'left';
					el.lang = 'fr';
				}
			});
		}

		document.addEventListener('DOMContentLoaded', applyLanguageDirection);
	</script>





	<!-- jQuery -->
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<!-- DataTables JS -->
	<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

	<!-- Initialisation De DataTables JS -->
	<script nonce="<%= nonce %>">
		$(document).ready(function () {
			var table = $('#dataTable').DataTable({
				"paging": true,
				"pagingType": "full_numbers",
				"lengthMenu": [[10, 25, 50], [10, 25, 50]],
				"searching": true,
				"ordering": true,
				"info": true,
				"language": {
					"lengthMenu": "Showing _MENU_ entries",
					"search": "searching :",
					"paginate": {
						"first": "First",
						"last": "Last",
						"next": ">",
						"previous": "<"
					},
					"info": "Showing _START_ à _END_ sur _TOTAL_ entries"
				}
			});

			// Appliquer le style à la pagination au chargement et après chaque changement de page
			function stylePagination() {
				let pagination = document.querySelector('.dataTables_paginate');
				if (pagination) {
					pagination.style.marginTop = "10px";
					pagination.style.display = 'flex';
					pagination.style.alignItems = 'center';
					pagination.style.justifyContent = 'flex-end';
					pagination.style.gap = '5px';
					pagination.style.borderRadius = '5px';
					pagination.style.backgroundColor = '#f8f9fa'; // Fond clair
					pagination.style.border = '0px';
				}

				document.querySelectorAll('.paginate_button').forEach(button => {
					button.style.display = 'inline-block';
					button.style.color = '#333';
					button.style.textDecoration = 'none';
					button.style.border = '0px solid #ddd';
					button.style.borderRadius = '3px';
					button.style.cursor = 'pointer';
					button.style.backgroundColor = '#fff';

					// Effet au survol
					button.addEventListener('mouseover', () => {
						button.style.backgroundColor = '#e9ecef';
					});
					button.addEventListener('mouseout', () => {
						button.style.backgroundColor = '#fff';
					});

					// Mettre en évidence la page active
					if (button.classList.contains('current')) {
						button.style.backgroundColor = '#6c63ff'; // Bleu foncé
						button.style.color = '#fff';
						button.style.fontWeight = 'bold';
					}
				});
			}

			// Appliquer le style au chargement
			stylePagination();

			// Appliquer le style après chaque changement de page
			table.on('draw.dt', function () {
				stylePagination();
			});


			// Synchronisation du sélecteur avec DataTables
			$('#entries').on('change', function () {
				table.page.len($(this).val()).draw();
			});

			// Synchronisation de la barre de recherche avec DataTables
			$('#searchInput').on('keyup', function () {
				table.search($(this).val()).draw();
			});
		});

	</script>


