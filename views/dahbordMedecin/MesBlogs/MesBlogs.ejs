<body class="light-mode">

	<div class="page-container">
	
		<!-- Preloader -->
		<div class="preloader">
			<div class="loader">
				<div class="loader-outter"></div>
				<div class="loader-inner"></div>
	
				<div class="indicator">
					<svg width="16px" height="12px">
						<polyline id="back" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
						<polyline id="front" points="1 6 4 6 6 11 10 1 12 6 15 6"></polyline>
					</svg>
				</div>
			</div>
		</div>
		<!-- End Preloader -->
	
		<!-- Get Pro Button -->
		<ul class="pro-features">
			<input style="background-color: #ee5086;border: 0px solid #ee5086;" type="button" value="Setup"
				class="get-pro text-white" />
			<!-- Titre principal amélioré -->
			<li class="fw-bold text-center fs-5 text-primary">Blogs Panel</li>
			<div class="button">
				<div class="get-quote">
					<!-- <button id="darkModeToggle" class="btn btn-outline-light mt-3 w-100">
									<i class="icofont-moon"></i> Dark Mode
								</button> -->
					<a href="/AddBlog" class="text-white btn btn-primary w-100">Add Blog</a>
				</div>
			</div>
		</ul>
		<!--End Get Pro Button -->
	
	
		<!-- Header Area -->
		<header class="header">
			<!-- Topbar -->
			<div class="topbar">
				<div class="container">
					<div class="row">
						<div class="col-lg-6 col-md-5 col-12"></div>
						<div class="col-lg-6 col-md-7 col-12">
							<!-- Top Contact -->
							<ul class="top-contact">
								<li class="num"><i class="fa fa-phone"></i>+213 562 39 20 55</li>
								<li class="email"><i class="fa fa-envelope"></i><a
										href="mailto:support@yourmail.com">mommyandmeclinic@outlook.com</a></li>
							</ul>
							<!-- End Top Contact -->
						</div>
						<!-- Contenu principal -->
					</div>
				</div>
			</div>
			<!-- End Topbar -->
			<!-- Header Inner -->
			<div class="header-inner">
				<div class="container">
					<div class="inner">
						<div class="row">
							<div class="col-lg-3 col-md-3 col-12">
								<!-- Start Logo -->
								<div class="logo">
									<a href="/MyAppoitements"
										class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-decoration-none">
										<img src="img/logo_healthy_baby.jpg" alt="Logo" width="50">
										<span style="margin-left: 10px;" class="fs-5 ms-3 fw-bold">My Account</span>
									</a>
								</div>
								<!-- End Logo -->
								<!-- Mobile Nav -->
								<div class="mobile-nav"></div>
								<!-- End Mobile Nav -->
							</div>
							<div class="col-lg-7 col-md-9 col-12">
								<!-- Main Menu -->
								<div class="main-menu">
									<nav class="navigation">
										<ul class="nav menu">
											<li class="nav-item">
												<a href="/MyAppoitements" class="nav-link active">
													<span>My Appointments</span>
												</a>
											</li>
											<li>
												<a href="#">Blogs <i class="icofont-rounded-down"></i></a>
												<ul class="dropdown">
													<li><a href="/MyBlogs"><strong>My Blogs</strong></a></li>
											
													<!-- Séparation améliorée -->
													<li style="border-top: 1px solid #ccc; margin: 5px 0;">
														<strong style="display:block; padding: 5px 15px; color: #555; cursor: default; user-select: none;">
															Categories
														</strong>
													</li>
											
													<li class="dropdown-divider"></li>
											
													<li><a href="/MyAppoitements/General">General</a></li>
													<li><a href="/MyAppoitements/Nutrition">Nutrition</a></li>
													<li><a href="/MyAppoitements/mental-health">Mental Health</a></li>
													<li><a href="/MyAppoitements/Pediatrics">Pediatrics</a></li>
													<li><a href="/MyAppoitements/Breastfeeding">Breastfeeding</a></li>
													<li><a href="/MyAppoitements/Parenting-advice">Parenting Advice</a></li>
													<li><a href="/MyAppoitements/Others">Others</a></li>
												</ul>
											</li>
	
											<li class="nav-item">
												<a href="/MyTimesLot" class="nav-link">
													<span>My timeslots</span>
												</a>
											</li>
	
											<li class="nav-item">
												<a href="/ContactAdminFromDoctor" class="nav-link">
													<span>Contact Us</span>
												</a>
											</li>
	
										</ul>
									</nav>
								</div>
								<!--/ End Main Menu -->
							</div>
							<div class="col-lg-2 col-12 d-flex justify-content-end align-items-center">
								<form method="post" action="/logout" class="m-0">
									<button style="background-color: red;" type="submit" class="btn">
										Logout
									</button>
								</form>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!--/ End Header Inner -->
		</header>
		<!-- End Header Area -->

		<main class="content-wrap">
		
			<!-- Breadcrumbs -->
			<div class="breadcrumbs overlay">
				<div class="container">
					<div class="bread-inner">
						<div class="row">
							<div class="col-12">
								<h2>My Blogs</h2>
								<ul class="bread-list">
									<li><a href="/MyAppoitements">My Account</a></li>
									<li><i class="icofont-simple-right"></i></li>
									<li class="active">My Blogs</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- End Breadcrumbs -->
		
			<!-- Contenu principal -->
			<div class="container-fluid p-4">
		
				<!-- Formulaire de filtrage par date -->
				<form method="POST" action="/MyBlogs" class="row g-3 align-items-end mb-4">
					<input type="hidden" name="_csrf" value="<%= csrfToken %>">
		
					<div class="col-md-3">
						<label for="startDate" class="form-label">Start Date</label>
						<input type="date" id="startDate" name="startDate" class="form-control"
							value="<%= startDate ? startDate : '' %>">
					</div>
		
					<div class="col-md-3">
						<label for="endDate" class="form-label">End Date</label>
						<input type="date" id="endDate" name="endDate" class="form-control"
							value="<%= endDate ? endDate : '' %>">
					</div>
		
					<div class="col-auto">
						<button type="submit" class="btn btn-primary">
							<i class="bi bi-filter"></i> Filter
						</button>
					</div>
					<div class="col-auto">
						<a href="/MyBlogs" class="btn btn-secondary">
							<i class="bi bi-x-circle"></i> Reset
						</a>
					</div>
				</form>
				<!-- Fin formulaire -->
		
		
		
				<!-- Tableau des blogs -->
				<div class="card mb-4">
					<div class="table-responsive p-3">
						<table class="table align-items-center table-flush" id="dataTable">
							<thead class="thead">
								<tr>
									<th class="w-25">#</th>
									<th class="w-25">Title</th>
									<th class="w-25">Author</th>
									<th class="w-25">Category</th>
									<th class="w-25">Date</th>
									<th class="w-25">Status</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody class="tbody">
								<% blogs.forEach((blog, index)=> { %>
									<tr data-content="<%= blog.content.replace(/\n/g, '<br>') %>" data-title="<%= blog.title.replace(/\n/g, '<br>') %>"
										data-author="<%= blog.author.replace(/\n/g, '<br>') %>" data-category="<%= blog.category %>"
										data-image="<%= blog.image %>" data-status="<%= blog.status %>"
										data-created-at="<%= new Date(blog.createdAt).toLocaleString('en-GB', { day: '2-digit' , month: '2-digit' ,
											year: 'numeric' , hour: '2-digit' , minute: '2-digit' , second: '2-digit' })%>">
										<td class="w-25 text-truncate">
											<%= index + 1 %>
										</td>
										<td class="w-25 text-truncate dynamic-text">
											<%= blog.title.replace(/\n/g, '<br>') %>
										</td>
										<td class="w-25 text-truncate dynamic-text">
											<%= blog.author.replace(/\n/g, '<br>') %>
										</td>
										<td class="w-25 text-truncate">
											<%= blog.category %>
										</td>
										<td class="w-25 text-truncate">
											<%= new Date(blog.createdAt).toLocaleDateString("fr-FR", { year: "numeric" ,
												month: "long" , day: "numeric" }) %>
										</td>
										<td class="w-25 text-truncate">
											<span class="badge 
												 <%= blog.status === 'Pending' ? 'bg-warning' : 
												 blog.status === 'Approved' ? 'bg-success' : 
												 'bg-danger' %>">
												<%= blog.status %>
											</span>
										</td>
										<td>
											<div class="d-flex">
												<button class="btn btn-sm me-2 view-blog-btn"
													style="background-color: #4ea4b5; color: white;">
													<i class="bi bi-eye"></i>
												</button>
		
												<button class="btn btn-sm me-2 updateBlogBtn"
													style="background-color: #2196f3; color: white;"
													data-blog-id="<%= blog._id %>">
													<i class="bi bi-pencil"></i>
												</button>
		
		
		
												<button type="submit" class="btn btn-sm me-2 deleteBlogBtn"
													style="background-color: #f44336; color: white;"
													data-blog-id="<%= blog._id %>">
													<i class="bi bi-trash"></i>
												</button>
		
		
											</div>
										</td>
									</tr>
									<% }) %>
							</tbody>
						</table>
					</div>
				</div>
				<!-- Fin du tableau -->
		
			</div>
			<!-- Fin du contenu principal -->
		
		</main>
	
		<!-- Footer Area -->
		<footer id="footer" class="footer">
			<!-- Copyright -->
			<div class="copyright">
				<div class="container">
					<div class="row align-items-center">
						<!-- Copyright Text -->
						<div class="col-md-6 text-md-start text-center">
							<div class="copyright-content">
								<p>
									© Copyright 2025 | All Rights Reserved by
									<a href="#" target="_blank">Mommy&Me.com</a>
								</p>
							</div>
						</div>
						<!--/ End Copyright -->
		
						<!-- Social Media Icons -->
						<div class="col-md-6 text-md-end text-center">
							<div class="social-icons">
								<a href="https://web.facebook.com/dr.ouddah" target="_blank"
									class="text-white fs-4 p-2 btn btn-outline-light">
									<i style="font-size: 30px;" class="icofont-facebook display-4"></i>
								</a>
								<a href="https://www.instagram.com/dr.ouddah" target="_blank"
									class="text-white fs-4 p-2 btn btn-outline-light">
									<i style="font-size: 30px;" class="icofont-instagram display-4"></i>
								</a>
								<a href="https://www.linkedin.com/in/meriem-ouddah-88b097213/" target="_blank"
									class="text-white fs-4 p-2 btn btn-outline-light">
									<i style="font-size: 30px;" class="icofont-linkedin"></i>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</footer>
		<!--End Footer Area -->
	</div>





