      <!-- Script pour gérer le focus lors de la fermeture de la modale d'ajoute de commentaires
       (enlever l'erreur qui apprait aprés la fermuture de fenetre d'ajoute de commentaire) -->
      <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
          const commentModal = document.getElementById("commentModal");
          const closeButton = commentModal.querySelector(".btn-close");
          const openModalBtn = document.querySelector('[data-bs-target="#commentModal"]');

          // 1. Avant que la modale ne soit cachée : enlever le focus de l'élément actif
          commentModal.addEventListener("hide.bs.modal", function () {
            if (document.activeElement === closeButton) {
              document.activeElement.blur(); // ou document.body.focus();
            }
          });

          // 2. Après que la modale soit complètement fermée : rendre le focus au bouton d'ouverture
          commentModal.addEventListener("hidden.bs.modal", function () {
            if (openModalBtn) {
              openModalBtn.focus();
            }
          });
        });
      </script>


      <!-- Script pour gérer le focus lors de la fermeture de la modale de supprimer commentaires
       (enlever l'erreur qui apprait aprés la fermuture de fenetre de supprimer commentaire) -->

      <script nonce="<%= nonce %>">
        document.addEventListener("DOMContentLoaded", function () {
          // Sélectionne toutes les modales dont l'id commence par "deleteCommentModal" ou "deleteReplyModal"
          const modalSelectors = ['[id^="deleteCommentModal"]', '[id^="deleteReplyModal"]'];
          const modals = document.querySelectorAll(modalSelectors.join(','));

          modals.forEach(modal => {
            // Trouve le bouton qui ouvre la modale
            const openModalBtn = document.querySelector(`[data-bs-target="#${modal.id}"]`);

            // Avant fermeture : retirer le focus de n'importe quel élément actif dans la modale
            modal.addEventListener("hide.bs.modal", () => {
              if (modal.contains(document.activeElement)) {
                document.activeElement.blur();
              }
            });

            // Après fermeture complète : remettre le focus au bouton qui a ouvert la modale
            modal.addEventListener("hidden.bs.modal", () => {
              if (openModalBtn) {
                openModalBtn.focus();
              }
            });
          });
        });
      </script>

      <!-- script qui détecet automatiquement la langue récupérer depuis la bd et faire l'alignemet du texte 
      selon la langue -->
      <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
          function isArabic(text) {
            // Vérifie si le texte contient des caractères arabes Unicode
            return /[\u0600-\u06FF]/.test(text);
          }

          document.querySelectorAll('.dynamic-text').forEach(el => {
            const text = el.textContent.trim();
            if (isArabic(text)) {
              el.style.direction = 'rtl';
              el.style.textAlign = 'right';
              el.lang = 'ar';
              el.style.fontFamily = "'Arial', 'Tahoma', sans-serif";
            } else {
              el.style.direction = 'ltr';
              el.style.textAlign = 'left';
              el.lang = 'fr'; // ou autre langue par défaut
            }
          });
        });
      </script>





      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      
      <% if (message) { %>
        <script nonce="<%= nonce %>">
          Swal.fire({
            icon: "<%= messageType === 'success' ? 'success' : 'error' %>",
            title: "<%= messageType === 'success' ? 'Success' : 'Oops...' %>",
            text: "<%= message %>",
            confirmButtonText: 'OK'
          });
        </script>
        <% } %>


</body>

</html>