      <% if (blog) { %>
        <!-- ====== Blog Detail Section Start ====== -->
        <section class="blog-detail section py-5">
          <div class="container">
            <div class="row justify-content-center">
              <div class="col-lg-10">
      
                <!-- Blog Title -->
                <h1 class="dynamic-text mb-3 text-center">
                  <%= blog.title.replace(/\n/g, '<br>') %>
                </h1>
      
                <!-- Metadata -->
                <p class="dynamic-text text-center text-muted mb-4">
                  <i class="bi bi-calendar-event"></i>
                  <%= new Date(blog.createdAt).toLocaleDateString('en-GB') %> &nbsp;|&nbsp;
                    <i class="bi bi-person-circle"></i>
                    <%= blog.author.replace(/\n/g, '<br>') %> &nbsp;|&nbsp;
                      <span class="badge bg-secondary text-capitalize">
                        <%= blog.category.replace('-', ' ' ) %>
                      </span>
                </p>
      
                <!-- Blog Image -->
                <div class="mb-4 text-center">
                  <img src="<%= '/uploads/' + blog.image %>" alt="Blog Image" class="img-fluid rounded"
                    style="max-height: 500px; object-fit: cover;">
                </div>
      
                <!-- Blog Content -->
                <div class="dynamic-text blog-content fw-bold fs-5" style="line-height: 1.8; white-space: pre-line;">
                  <%= blog.content %>
                </div>

      
                <!-- Interactive Buttons -->
                <div class="text-center mt-5 d-flex justify-content-center gap-3">
                  <button class="btn btn-outline-primary d-flex align-items-center gap-1" data-bs-toggle="modal"
                    data-bs-target="#commentModal">
                    <i class="bi bi-chat-left-text"></i> Comments (<%= totalComments %>)
                  </button>
                </div>
      
                <!-- Comments Section -->
                <div class="mt-5">
                  <h4 class="mb-4 text-primary">
                    <i class="bi bi-chat-dots-fill me-2"></i> Comments (<%= totalComments %>)
                  </h4>
      
      
                  <% if (comments && comments.length> 0) { %>
                    <div class="list-group">
                      <% comments.forEach(comment=> { %>
                        <div class="list-group-item py-3 px-4 mb-3 shadow-sm rounded">
                          <% if (comment.user) { %>
                            <p class="fw-semibold d-flex align-items-center gap-1 mb-1">
                              <% if (comment.user.role==='doctor' ) { %>
                                <i class="bi bi-person-badge-fill text-primary"></i>
                                <% } else if (comment.user.role==='parent' ) { %>
                                  <i class="bi bi-person-fill text-success"></i>
                                  <% } else { %>
                                    <i class="bi bi-person text-muted"></i>
                                    <% } %>
                                      <%= comment.user.full_name %>
                            </p>
                            <% } else { %>
                              <p class="text-muted"><i class="bi bi-person-x-fill me-1"></i><em>Unknown author</em></p>
                              <% } %>

                          <p class="mb-2 text-dark">
                            <i class="bi bi-quote me-1 text-secondary"></i>
                            <span style="line-height: 1.8; white-space: pre-line;"><%= comment.text %></span>
                          </p>
      
                          <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                              <i class="bi bi-calendar-event me-1"></i>
                              <%= new Date(comment.createdAt).toLocaleString() %>
                            </small>

                            <!-- Icône de suppression du commentaire seulement pour le user qui a posté comment-->

                            <% if (comment.user && comment.user._id && comment.user._id.toString() === currentUser.toString()) { %>
                              <a href="#" class="position-absolute top-0 end-0 m-2 text-danger" data-bs-toggle="modal"
                                data-bs-target="#deleteCommentModal<%= comment._id %>">
                                <i class="bi bi-trash-fill fs-4"></i>
                              </a>
                            <% } %>
                          </div>

                          <!-- Modal de confirmation pour la suppression du commentaire -->
                          <div class="modal fade" id="deleteCommentModal<%= comment._id %>" tabindex="-1"
                            aria-labelledby="deleteCommentModalLabel<%= comment._id %>" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                              <form method="POST" action="/MyAppoitements/blog/<%= blog._id %>/comment/<%= comment._id %>/delete">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="modal-content">
                                  <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title text-white" id="deleteCommentModalLabel<%= comment._id %>">
                                      <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                  </div>
                                  <div class="modal-body">
                                    Delete this comment? This action cannot be undone.
                                  </div>
                                  <div class="modal-footer">
                                    <button style="background-color: #6b6b6b; color: #ffffff; border: none;" type="button" class="btn" data-bs-dismiss="modal">Cancel</button>
                                    <button style="background-color: #df0202; color: white; border: none;" type="submit" class="btn">Yes, Delete</button>
                                  </div>
                                </div>
                              </form>
                            </div>
                          </div>
      
                              <!-- Répondre avec effet UX -->
                              <div class="mt-3">
                                <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" data-bs-toggle="collapse"
                                  href="#replyForm<%= comment._id %>" role="button" aria-expanded="false" aria-controls="replyForm<%= comment._id %>">
                                  <i class="bi bi-reply-fill"></i> Reply
                                  <% if (comment.replies?.length> 0) { %>
                                    (<%= comment.replies.length %>)
                                      <% } %>
                                </a>
      
                              </div>
      
                              <!-- Formulaire de réponse collapsible -->
                              <div class="collapse mt-3" id="replyForm<%= comment._id %>">
                                <div class="card card-body border-0 shadow-sm">
                                  <form method="POST" action="/MyAppoitements/blog/<%= blog._id %>/comment/<%= comment._id %>/reply">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <div class="mb-2">
                                      <textarea name="reply" class="form-control" rows="2" dir="auto" placeholder="Write your reply..." required></textarea>
                                    </div>
                                    <div class="text-end">
                                      <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="bi bi-send"></i> Send
                                      </button>
                                    </div>
                                  </form>
                                </div>
                              </div>
      
            
                              <!-- Affichage des sous-commentaires -->
                              <% if (comment.replies && comment.replies.length> 0) { %>
                                <div class="mt-3 ps-3 border-start">
                                  <% comment.replies.forEach(reply=> { %>
                                    <div class="mb-3 border rounded p-3 position-relative bg-light">
                                        <!-- Contenu de la réponse -->
                                        <% if (reply.user) { %>
                                          <p class="fw-semibold d-flex align-items-center gap-1 mb-1">
                                            <% if (reply.user.role==='doctor' ) { %>
                                              <i class="bi bi-person-badge-fill text-primary me-1"></i>
                                              <% } else if (reply.user.role==='parent' ) { %>
                                                <i class="bi bi-person-fill text-success me-1"></i>
                                                <% } else { %>
                                                  <i class="bi bi-person text-muted me-1"></i>
                                                  <% } %>
                                                    <%= reply.user.full_name %>
                                          </p>
                                          <% } else { %>
                                            <p><i class="bi bi-person-x-fill text-muted me-1"></i><em>Unknown author</em></p>
                                            <% } %>

                                      <p class="mb-1 text-dark">
                                        <i class="bi bi-arrow-return-right text-secondary me-1"></i>
                                        <span style="line-height: 1.8; white-space: pre-line;"><%= reply.text %></span>
                                      </p>
                                      <small class="text-muted d-block mb-2">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        <%= new Date(reply.createdAt).toLocaleString() %>
                                      </small>
                              
                                      <!-- Icône de suppression de sous commentaire seulement pour le user qui a posté reply -->
                                      <% if (reply.user && reply.user._id && reply.user._id.toString() === currentUser.toString()) { %>
                                        <a href="#" class="position-absolute top-0 end-0 m-2 text-danger" data-bs-toggle="modal"
                                          data-bs-target="#deleteReplyModal<%= reply._id %>">
                                          <i class="bi bi-trash-fill fs-4"></i>
                                        </a>
                                      <% } %>

                              
                                      <!-- Modal de confirmation pour la suppression de la réponse -->
                                      <div class="modal fade" id="deleteReplyModal<%= reply._id %>" tabindex="-1"
                                        aria-labelledby="deleteReplyModalLabel<%= reply._id %>" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                          <form method="POST" action="/MyAppoitements/blog/<%= blog._id %>/comment/<%= comment._id %>/reply/<%= reply._id %>/delete">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <div class="modal-content">
                                              <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title text-white" id="deleteReplyModalLabel<%= reply._id %>">
                                                  <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                              </div>
                                              <div class="modal-body">
                                                Delete this reply? This action cannot be undone.
                                              </div>

                                              <div class="modal-footer">
                                                <button style="background-color: #6b6b6b; color: #ffffff; border: none;" type="button" class="btn" data-bs-dismiss="modal">Cancel</button>
                                                <button style="background-color: #df0202; color: white; border: none;" type="submit" class="btn">Yes, Delete</button>
                                              </div>
                                            </div>
                                          </form>
                                        </div>
                                      </div>
                              
                                    </div>
                                    <% }) %>
                                </div>
                              <% } %>

            
                            </div>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <p class="text-muted">No comments yet.</p>
                      <% } %>
                    </div>
            
                  </div>
                </div>
              </div>
        </section>
        <!-- ====== End Blog Detail Section ====== -->
            
        <!-- Modal Commentaire Principal -->
        <div class="modal fade" id="commentModal" tabindex="-1" aria-labelledby="commentModalLabel" aria-hidden="true">
              <div class="modal-dialog">
                <form method="POST" action="/MyAppoitements/blog/<%= blog._id %>/comment">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title" id="commentModalLabel">Add a comment</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                      <textarea name="comment" class="form-control" rows="4" dir="auto" required></textarea>
                    </div>
                    <div class="modal-footer">
                      <button type="submit" class="btn btn-primary">send</button>
                    </div>
                  </div>
                </form>
              </div>
        </div>
        <!--End Modal Commentaire Principal -->
      
      
      <% } else { %>
          <section class="blog-detail section py-5">
                <div class="container">
                  <div class="alert alert-danger text-center" role="alert">
                    <strong>Error:</strong> Unable to display the blog details. Please try again later.
                  </div>
                </div>
          </section>
      <% } %>


    
