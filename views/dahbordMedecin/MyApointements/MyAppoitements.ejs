										if (data.success) {
											Swal.fire({
												title: "success!",
												text: data.message,
												icon: "success",
												confirmButtonColor: "#4CAF50"
											}).then(() => {
												location.reload(); // Optionnel : recharger la page pour voir le changement
											});
