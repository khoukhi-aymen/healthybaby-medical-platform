							<div class="row">
								<div class="col-12">
									<h2>My Appointments</h2>
									<ul class="bread-list">
										<li><a href="/MyAppoitements">My Account</a></li>
										<li><i class="icofont-simple-right"></i></li>
										<li class="active">My Appointments</li>
									</ul>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- End Breadcrumbs -->


				<!-- Contenu principal -->
				<div class="container-fluid p-4">

					<!-- Formulaire de filtrage par date -->
					<form method="POST" action="/MyAppoitements" class="row g-3 align-items-end mb-4">
						<input type="hidden" name="_csrf" value="<%= csrfToken %>">
					
						<div class="col-md-3">
							<label for="startDate" class="form-label">Start Date</label>
							<input type="date" id="startDate" name="startDate" class="form-control"
								value="<%= startDate ? startDate : '' %>">
						</div>
					
						<div class="col-md-3">
							<label for="endDate" class="form-label">End Date</label>
							<input type="date" id="endDate" name="endDate" class="form-control" value="<%= endDate ? endDate : '' %>">
						</div>
					
						<div class="col-auto">
							<button type="submit" class="btn btn-primary">
								<i class="bi bi-filter"></i> Filter
							</button>
						</div>
						<div class="col-auto">
							<a href="/MyAppoitements" class="btn btn-secondary">
								<i class="bi bi-x-circle"></i> Reset
							</a>
						</div>
					</form>
					<!-- Fin formulaire -->


					<!-- Tableau des rendez-vous -->
					<div class="card mb-4">
						<div class="table-responsive p-3">
							<table class="table align-items-center table-flush" id="dataTable">
								<thead class="thead">
									<tr>
										<th class="w-25" title="Appointment Status">Status</th>
										<th class="w-25" title="Date of Appointment">Date</th>
										<th class="w-25" title="Appointment Hour">Hour</th>
										<th class="w-25" title="Appointment Type">Type</th>
										<th class="w-25" title="Appointment Mode">Mode</th>
										<th title="Available Actions">Action</th>
									</tr>
								</thead>
								<tbody class="tbody">
										<% appointments.forEach(appointment=> { %>
											<tr>
												<td class="w-25 text-truncate">
													<span class="badge 
														<%= appointment.status === 'Pending' ? 'bg-warning' : 
														appointment.status === 'Approved' ? 'bg-success' : 
														appointment.status === 'Rejected' ? 'bg-danger' : 
														appointment.status === 'Completed' ? 'bg-primary' : 
														appointment.status === 'In follow-up' ? 'bg-info' : 
														appointment.status === 'Reviewed' ? 'bg-secondary' : 
														'bg-secondary' %>">
														<%= appointment.status %>
													</span>
												</td>
												<td class="w-25 text-truncate">
													<%= new Date(appointment.appointmentDate).toLocaleDateString() %>
												</td>
												<td class="w-25 text-truncate">
													<%= appointment.appointmentHour %>
												</td>
												<td class="w-25 text-truncate">
													<%= appointment.appointmentType %>
												</td>
												<td class="w-25 text-truncate">
													<%= appointment.appointmentMode ? appointment.appointmentMode : "Not Specified" %>
												</td>
												<td>
													<% if (appointment.status==='Pending' ) { %>
														<div class="d-flex">
															<!-- Supprimer -->
															<a class="btn btn-sm me-2 deleteAppointmentBtn" data-app-id="<%= appointment._id %>"
																data-pre-id="<%= appointment.preAppointmentId %>" data-schedule-id="<%= appointment.scheduleId %>"
																data-doctor-name="<%= appointment.doctorName %>" data-date="<%= appointment.appointmentDate.toISOString() %>"
																data-hour="<%= appointment.appointmentHour %>" style="background-color: #f44336; color: white;">
																<i class="bi bi-trash"></i>
															</a>
												
															<!-- Approuver -->
															<a class="btn btn-sm me-2 approveAppointmentBtn" 
															    data-app-id="<%= appointment._id %>"
																style="background-color: #4CAF50; color: white;">
																<i class="bi bi-check-circle"></i>
															</a>

												
															<!-- Voir pré-rendez-vous -->
															<a class="btn btn-sm me-2 viewAppointmentDetailsBtn" 
															    data-pre-id="<%= appointment.preAppointmentId %>"
																style="background-color: #4ea4b5; color: white;">
																<i class="bi bi-eye"></i>
															</a>
														</div>
													<% } else if (appointment.status==='Approved' ) { %>
														<div class="d-flex">
															<!-- Supprimer -->
															<a class="btn btn-sm me-2 deleteAppointmentBtn" data-app-id="<%= appointment._id %>"
																data-pre-id="<%= appointment.preAppointmentId %>" data-schedule-id="<%= appointment.scheduleId %>"
																data-doctor-name="<%= appointment.doctorName %>" data-date="<%= appointment.appointmentDate.toISOString() %>"
																data-hour="<%= appointment.appointmentHour %>" style="background-color: #f44336; color: white;">
																<i class="bi bi-trash"></i>
															</a>


															<!-- Passer en In follow-up -->
															<a class="btn btn-sm me-2 followUpBtn" data-app-id="<%= appointment._id %>"
																style="background-color: #ff9800; color: white;">
																<i class="bi bi-arrow-repeat"></i>
															</a>

															<!-- Passer en Completed -->
															<a class="btn btn-sm me-2 completeAppointmentBtn" data-app-id="<%= appointment._id %>"
																style="background-color: #3f51b5; color: white;">
																<i class="bi bi-check2-square"></i>
															</a>

													
															<!-- Voir pré-rendez-vous -->
															<a class="btn btn-sm me-2 viewAppointmentDetailsBtn" data-pre-id="<%= appointment.preAppointmentId %>"
																style="background-color: #4ea4b5; color: white;">
																<i class="bi bi-eye"></i>
															</a>
													
														</div>
													<% } else if (appointment.status==='In follow-up' ) { %>
														<div class="d-flex">
															<!-- Supprimer -->
															<a class="btn btn-sm me-2 deleteAppointmentBtn" data-app-id="<%= appointment._id %>"
																data-pre-id="<%= appointment.preAppointmentId %>" data-schedule-id="<%= appointment.scheduleId %>"
																data-doctor-name="<%= appointment.doctorName %>" data-date="<%= appointment.appointmentDate.toISOString() %>"
																data-hour="<%= appointment.appointmentHour %>" style="background-color: #f44336; color: white;">
																<i class="bi bi-trash"></i>
															</a>
														
															<!-- Passer en In follow-up -->
															<a class="btn btn-sm me-2 followUpBtn" data-app-id="<%= appointment._id %>"
																style="background-color: #ff9800; color: white;">
																<i class="bi bi-arrow-repeat"></i>
															</a>

															<!-- Passer en Completed -->
															<a class="btn btn-sm me-2 completeAppointmentBtn" data-app-id="<%= appointment._id %>"
																style="background-color: #3f51b5; color: white;">
																<i class="bi bi-check2-square"></i>
															</a>

														
															<!-- Voir pré-rendez-vous -->
															<a class="btn btn-sm me-2 viewAppointmentDetailsBtn" data-pre-id="<%= appointment.preAppointmentId %>"
																style="background-color: #4ea4b5; color: white;">
																<i class="bi bi-eye"></i>
															</a>
														
														</div>
													<% } else if (appointment.status==='Completed' ) { %>
														<% if (appointment.isReviewed) { %>

																<div class="d-flex">
																	<!-- Archiver le rendez-vous -->
																	<a class="btn btn-sm me-2 archiveAppointmentBtn" data-app-id="<%= appointment._id %>"
																		data-pre-id="<%= appointment.preAppointmentId %>" data-schedule-id="<%= appointment.scheduleId %>"
																		data-doctor-name="<%= appointment.doctorName %>" data-date="<%= appointment.appointmentDate.toISOString() %>"
																		data-hour="<%= appointment.appointmentHour %>" style="background-color: #9e9e9e; color: white;">
																		<i class="bi bi-archive"></i>
																	</a>

																	<!-- voir le témoigange -->
																	<a class="btn btn-sm me-2 viewTestimonialBtn" data-app-id="<%= appointment._id %>"
																		style="background-color: #03a9f4; color: white;">
																		<i class="bi bi-chat-left-text"></i>
																	</a>

																	<!-- Voir pré-rendez-vous -->
																	<a class="btn btn-sm me-2 viewAppointmentDetailsBtn" data-pre-id="<%= appointment.preAppointmentId %>"
																		style="background-color: #4ea4b5; color: white;">
																		<i class="bi bi-eye"></i>
																	</a>
																</div>
														<% } else { %>
															<div class="d-flex">
																<!-- Archiver le rendez-vous -->
																<a class="btn btn-sm me-2 archiveAppointmentBtn" data-app-id="<%= appointment._id %>"
																	data-pre-id="<%= appointment.preAppointmentId %>" data-schedule-id="<%= appointment.scheduleId %>"
																	data-doctor-name="<%= appointment.doctorName %>" data-date="<%= appointment.appointmentDate.toISOString() %>"
																	data-hour="<%= appointment.appointmentHour %>" style="background-color: #9e9e9e; color: white;">
																	<i class="bi bi-archive"></i>
																</a>
															
																<!-- Voir pré-rendez-vous -->
																<a class="btn btn-sm me-2 viewAppointmentDetailsBtn" data-pre-id="<%= appointment.preAppointmentId %>"
																	style="background-color: #4ea4b5; color: white;">
																	<i class="bi bi-eye"></i>
																</a>
															</div>
														<% } %>

													<% } else { %>
															<span class="text-muted">No action</span>
													<% } %>	
												</td>
											</tr>
											<% }) %>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<!-- End Contenu principal -->
		
			
			</main>
		
			<!-- Footer Area -->
			<footer id="footer" class="footer">
