		<!-- script qui détecet automatiquement la langue récupérer depuis la bd et faire l'alignemet du texte 
				      selon la langue -->
		<script nonce="<%= nonce %>">
			// Fonction réutilisable
			function applyLanguageDirection() {
				function isArabic(text) {
					return /[\u0600-\u06FF]/.test(text);
				}

				document.querySelectorAll('.dynamic-text').forEach(el => {
					const text = el.textContent.trim();
					if (isArabic(text)) {
						el.style.direction = 'rtl';
						el.style.textAlign = 'right';
						el.lang = 'ar';
						el.style.fontFamily = "'Arial', 'Tahoma', sans-serif";
					} else {
						el.style.direction = 'ltr';
						el.style.textAlign = 'left';
						el.lang = 'fr';
					}
				});
			}

			document.addEventListener('DOMContentLoaded', applyLanguageDirection);
		</script>

