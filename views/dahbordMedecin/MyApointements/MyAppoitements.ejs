										Swal.fire("Oops...", "Something went wrong, please try again later.", "error");
									});
							}
						});
					});
				});
			});
		</script>

        <!-- script pour supprimer un rendez vous  -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", () => {
				const csrfToken = "<%= csrfToken %>";
				document.querySelectorAll(".deleteAppointmentBtn").forEach((button) => {
					button.addEventListener("click", (event) => {
						const dataset = event.currentTarget.dataset;

						const appointmentId = dataset.appId;
						const preAppointmentId = dataset.preId;
						const scheduleId = dataset.scheduleId;
						const doctorName = dataset.doctorName;
						const appointmentDate = dataset.date;
						const appointmentHour = dataset.hour;

						Swal.fire({
							title: 'delete this appointment?',
							text: "This action cannot be undone.",
							icon: 'warning',
							showCancelButton: true,
							confirmButtonText: 'Yes, delete it!',
							cancelButtonText: 'Cancel',
							confirmButtonColor: '#3085d6',
							cancelButtonColor: '#d33',
						}).then((result) => {
							if (result.isConfirmed) {
								fetch(`/MyAppoitements/DeleteAppointment/${appointmentId}`, {
									method: "POST",
									headers: {
										"Content-Type": "application/json",
										"X-Requested-With": "XMLHttpRequest",
										"CSRF-Token": csrfToken
									},
									body: JSON.stringify({
										preAppointmentId: preAppointmentId,
										scheduleId: scheduleId,
										doctorName: doctorName,
										appointmentDate: appointmentDate,
										appointmentHour: appointmentHour
									})
								})
									.then(response => response.json())
									.then(data => {

										// Si redirection nécessaire
										if (data.redirectTo) {
											window.location.href = data.redirectTo;
											return;
										}


										if (data.success) {
											// Affiche une alerte de succès après la suppression
											Swal.fire({
												icon: "success",
												title: "Deleted!",
												text: data.message
											}).then(() => {
												// Recharge la page pour mettre à jour l'affichage des blogs
												window.location.reload();
											});
										} else {
											// Affiche une alerte d'erreur si la suppression échoue
											Swal.fire({
												icon: "error",
												title: "Oops...",
												text: data.message
											});
										}
									})
									.catch(() => {
										// Si la requête échoue, affiche une alerte d'erreur
										Swal.fire(
											'Oops...',
											'Something went wrong, please try again later.',
											'error'
										);
									});
							}
						});
					});
				});
			});
		</script>


