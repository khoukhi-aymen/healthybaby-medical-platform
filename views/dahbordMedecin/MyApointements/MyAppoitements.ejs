		<!-- script pour afficher le details sur le pre-rendez vous  -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", () => {
				const csrfToken = "<%= csrfToken %>";

				// Fonction utilitaire pour vérifier la présence de texte arabe
				function containsArabic(text) {
					return /[\u0600-\u06FF]/.test(text);
				}

				document.querySelectorAll(".viewAppointmentDetailsBtn").forEach(button => {
					button.addEventListener("click", () => {
						const appId = button.dataset.preId;

						if (!appId) {
							return Swal.fire("Oops...", "No appointment ID found.", "error");
						}

						fetch(`/MyAppoitements/PreappointmentDetails/${appId}`, {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-Requested-With": "XMLHttpRequest",
								"CSRF-Token": csrfToken
							}
						})
							.then(response => response.json())
							.then(data => {
								if (data.redirectTo) {
									window.location.href = data.redirectTo;
									return;
								}

								if (data.success) {
									const diseasesList = Array.isArray(data.diseases) && data.diseases.length > 0
										? data.diseases.join(", ")
										: (containsArabic(data.name) ? 'لا توجد' : 'None');

									const isArabic = containsArabic(data.name) ||
										containsArabic(data.residence) ||
										containsArabic(data.concern_summary);

									const direction = isArabic ? 'rtl' : 'ltr';
									const align = isArabic ? 'right' : 'left';

									const htmlContent = `
										<div class="dynamic-text" style="max-height: 400px; overflow-y: auto; text-align: ${align}; direction: ${direction}; line-height: 1.8; white-space: pre-line;">
											<p><strong>${isArabic ? 'الاسم' : 'Name'}:</strong> ${data.name}</p>
											<p><strong>${isArabic ? 'البريد الإلكتروني' : 'Email'}:</strong> ${data.email}</p>
											<p><strong>${isArabic ? 'الواتساب' : 'WhatsApp'}:</strong> ${data.whatsapp}</p>
											<p><strong>${isArabic ? 'الإقامة' : 'Residence'}:</strong> ${data.residence}</p>
											<p><strong>${isArabic ? 'موافقة الفيديو' : 'Video Consent'}:</strong> ${data.video_consent}</p>
											<p><strong>${isArabic ? 'الأمراض' : 'Diseases'}:</strong> ${diseasesList}</p>
											<p><strong>${isArabic ? 'أمراض أخرى' : 'Other Diseases'}:</strong> ${data.other_diseases || (isArabic ? 'لا توجد' : 'None')}</p>
											<p><strong>${isArabic ? 'ملخص المشكل' : 'Concern Summary'}:</strong></p>
											<p>${data.concern_summary || (isArabic ? 'لا يوجد' : 'None')}</p>
											<p><strong>${isArabic ? 'تم تأكيد الدفع' : 'Payment Confirmed'}:</strong> ${data.payment_confirmed || (isArabic ? 'لا' : 'No')}</p>
										</div>
									`;


									Swal.fire({
										title: isArabic ? 'تفاصيل الموعد المسبق' : 'Pre-Appointment Details',
										html: htmlContent,
										width: 700,
										confirmButtonText: isArabic ? 'إغلاق' : 'Close',
										confirmButtonColor: "#4ea4b5"
									});
								} else {
									Swal.fire({
										icon: "error",
										title: "Oops...",
										text: data.message || "Failed to load details."
									});
								}
							})
							.catch(err => {
								Swal.fire("Oops...", "Something went wrong, please try again later.", "error");
							});
					});
				});
			});
		</script>

		<!-- script pour afficher le details sur le témoignage  -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", () => {
				const csrfToken = "<%= csrfToken %>";

				function containsArabic(text) {
					return /[\u0600-\u06FF]/.test(text);
				}

				document.querySelectorAll(".viewTestimonialBtn").forEach(button => {
					button.addEventListener("click", () => {
						const appointmentId = button.dataset.appId;

						if (!appointmentId) {

							return Swal.fire("Error", "Appointment ID is missing.", "error");

						}

						fetch(`/MyAppoitements/TestimonialView/${appointmentId}`, {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"X-Requested-With": "XMLHttpRequest",
								"CSRF-Token": csrfToken
							}
						})
							.then(res => res.json())
							.then(data => {
								if (data.redirectTo) {
									window.location.href = data.redirectTo;
									return;
								}

								if (data.success) {


									const isArabic = containsArabic(data.name) || containsArabic(data.message);
									const direction = isArabic ? "rtl" : "ltr";
									const align = isArabic ? "right" : "left";
									const blogTitle = isArabic ? "تفاصيل الشهادة" : "Testimonial Details";
									const blogImage = `/uploads/${data.testimonial_image}`;

									function generateHtml() {
										return `
										<div style="text-align: ${align}; direction: ${direction}; line-height: 1.8; max-height: 400px; overflow-y: auto;">
											<p><strong>${isArabic ? "الاسم" : "Name"}:</strong> ${data.name.replace(/\n/g, '<br>')}</p>
											<p><strong>${isArabic ? "الحالة" : "Status"}:</strong> ${data.status}</p>
											<p><strong>${isArabic ? "الرسالة" : "Message"}:</strong></p>
											<p>${data.message.replace(/\n/g, '<br>')}</p>
											<p><strong>${isArabic ? "الصورة" : "Image"}:</strong></p>
											<img id="previewImage" src="${blogImage}" alt="Testimonial Image"
												style="max-width:100%; max-height:300px; cursor: pointer; border-radius: 8px;" />
										</div>
									`;
									}


									function applyLanguageDirection() {
										const container = Swal.getHtmlContainer();
										if (container) {
											container.style.direction = direction;
											container.style.textAlign = align;
										}
									}

									function showMainSwal() {
										Swal.fire({
											html: `<h2 class="dynamic-text text-center mb-3">${blogTitle}</h2>${generateHtml()}`,
											width: 700,
											confirmButtonColor: '#3085d6',
											confirmButtonText: isArabic ? 'إغلاق' : 'Close',
											didOpen: () => {
												applyLanguageDirection();
												const previewImage = document.getElementById("previewImage");
												if (previewImage) {
													previewImage.addEventListener("click", () => {
														Swal.fire({
															title: `${isArabic ? 'صورة' : 'Image'} - ${blogTitle}`,
															imageUrl: blogImage,
															imageWidth: '100%',
															imageHeight: 'auto',
															imageAlt: blogTitle,
															showConfirmButton: false,
															showCloseButton: true,
														}).then(() => {
															// Revenir à l'alerte principale après fermeture
															showMainSwal();
														});
													});
												}
											}
										});
									}

									showMainSwal();
								} else {
									Swal.fire({
										icon: "error",
										title: "Oops...",
										text: data.message || "Failed to load details."
									});
								}
							})
							.catch(err => {
								Swal.fire("Oops...", "Something went wrong, please try again later.", "error");
							});
					});
				});
			});
		</script>



