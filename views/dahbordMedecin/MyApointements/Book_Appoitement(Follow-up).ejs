				const doctorRadios = document.querySelectorAll("input[name='doctor']");
				const selectedDateElem = document.getElementById("selected-date");
				const timeSlotsContainer = document.getElementById("time-slots");
				const prevDayBtn = document.getElementById("prev-day");
				const nextDayBtn = document.getElementById("next-day");
				const monthYearSelect = document.getElementById("month-year-select");

				let selectedDate = new Date();
				let expanded = false;

				// Extraire et parser les données depuis le div caché
				const rawData = document.getElementById("schedules-data").getAttribute("data-schedules");

				let doctorSchedules = {};
				try {
					doctorSchedules = JSON.parse(rawData);
					// console.log("✅ Données des plannings des docteurs chargées :", doctorSchedules);
				} catch (e) {
					// console.error("❌ Erreur lors du parsing des horaires des docteurs :", e);
				}


				//ajout dynamiques des doctors 
				const radioGroup = document.getElementById("doctor-radio-group");

				// Vérifie s'il y a des docteurs
				if (radioGroup && Object.keys(doctorSchedules).length > 0) {
					let isFirst = true;

					Object.keys(doctorSchedules).forEach((doctorKey) => {
						// Crée un élément form-check
						const wrapper = document.createElement("div");
						wrapper.className = "form-check";

						const input = document.createElement("input");
						input.className = "form-check-input";
						input.type = "radio";
						input.name = "doctor";
						input.id = doctorKey.replace(/\s+/g, "_"); // Pour un id sans espaces
						input.value = doctorKey;
						if (isFirst) input.checked = true;

						const label = document.createElement("label");
						label.className = "form-check-label";
						label.htmlFor = input.id;
						label.textContent = doctorKey;

						wrapper.appendChild(input);
						wrapper.appendChild(label);

						radioGroup.appendChild(wrapper);
						isFirst = false;
					});
					// Juste après avoir ajouté les boutons radio
					document.querySelectorAll("input[name='doctor']").forEach(radio => {
						radio.addEventListener("change", () => {
							updateDateDisplay(); // met à jour le planning selon le médecin sélectionné
						});
					});

				}

				function formatDate(date) {
					return date.toISOString().split("T")[0]; // Convertir en "YYYY-MM-DD"
				}

				function getSelectedDoctor() {
					if (document.querySelector("input[name='doctor']")) {
						return document.querySelector("input[name='doctor']:checked").value;
					}
				}

				function updateTimeSlots() {
					timeSlotsContainer.innerHTML = "";
					const dateStr = formatDate(selectedDate);
					const doctorName = getSelectedDoctor();  // Nom du médecin sélectionné
					const doctorSchedule = doctorSchedules[doctorName]; // Récupérer les horaires du médecin par nom
					const slots = doctorSchedule?.schedules?.[dateStr];

					const availableSlots = Array.isArray(slots?.available) ? slots.available : [];
					const reservedSlots = Array.isArray(slots?.reserved) ? slots.reserved : [];

					const allSlots = [
						...availableSlots.map(s => ({ time: s, reserved: false })),
						...reservedSlots.map(s => ({ time: s, reserved: true }))
					];


					// 🔹 Tri des créneaux avant l'affichage
					allSlots.sort((a, b) => convertToMinutes(a.time) - convertToMinutes(b.time));

					allSlots.forEach((slot, index) => {
						let button = document.createElement("input");
						button.type = "button";
						button.className = `btn fw-bold w-100 text-center my-1 ${slot.reserved ? "btn-secondary disabled" : "btn-success"}`;
						button.style.backgroundColor = `${slot.reserved ? "rgb(73, 77, 83)" : "green"}`;
						button.style.color = `white`;
						button.value = slot.time;
						button.disabled = slot.reserved;

						if (!slot.reserved) {
							button.addEventListener("click", () => {
								// Vérification si le type de rendez-vous est sélectionné
								const appointmentType = document.getElementById("appointmentType").value;
								const appointmentMode = document.getElementById("feedingMode").value;
								if (!appointmentType) {
									Swal.fire({
										icon: "error",
										title: "Oops...",
										text: "Please select an appointment type."
									});
									return;
								}

								// Si le type est "feeding", vérifier si le mode de rendez-vous est sélectionné
								if (appointmentType === "feeding") {
									if (!appointmentMode) {
										Swal.fire({
											icon: "error",
											title: "Oops...",
											text: "Please select a feeding mode."
										});
										return;
									}
								}


								// Si toutes les conditions sont remplies, afficher la confirmation
								if (button.classList.contains("btn-success")) {
									Swal.fire({
										title: 'Reset Appointment?',
										html: `
											You have selected an appointment with <br> <strong>${doctorName}</strong>
											on <strong>${dateStr}</strong> at <strong>${slot.time}</strong>.<br><br>
											<strong>Type:</strong> <strong>${appointmentType}</strong><br>
											<strong>Mode:</strong> <strong>${appointmentType === 'feeding' ? appointmentMode : 'N/A'}</strong><br><br>
											Are you sure you want to <strong>reset this appointment</strong>?<br>
											This will <span style="color:#dc3545;"><strong>clear your current selection</strong></span>.
										`,
										icon: 'warning',
										showCancelButton: true,
										confirmButtonText: 'Yes, Reset',
										cancelButtonText: 'No, Keep It',
										confirmButtonColor: '#28a745',  //Vert doux (Action confirmée)
  										cancelButtonColor: '#6c757d'    //Gris neutre (Annulation)

									}).then((result) => {
										if (result.isConfirmed) {
											// console.log("Booking confirmed for:", slot.time, doctorName, dateStr);

											// Vérification du créneau et mise à jour des horaires
											const daySchedule = doctorSchedule.schedules[dateStr];

											if (daySchedule) {
												const index = daySchedule.available.indexOf(slot.time);
												if (index !== -1) {
													daySchedule.available.splice(index, 1); // Supprimer de available
													if (!daySchedule.reserved) {
														daySchedule.reserved = [];
													}
													daySchedule.reserved.push(slot.time);

													// console.log("📅 Updated Schedule:", doctorSchedules);


													const appointmentType = document.getElementById("appointmentType").value;
													let appointmentMode = null;

													if (appointmentType === "feeding") {
														appointmentMode = document.getElementById("feedingMode").value;
													}

													// Récupérer l'ID du pré-rendez-vous depuis le DOM
													const preAppointmentElement = document.getElementById("preappointment-info");
													const preappointmentId = preAppointmentElement
														? preAppointmentElement.getAttribute("data-preappointment-id")
														: null;

													// Récupérer l'appointmentId depuis le DOM
													const appointmentIdInput = document.getElementById("appointmentId");
													const appointmentId = appointmentIdInput ? appointmentIdInput.value : null;
                                
													
													//récupérer le token depuis le dom
													const csrfInput = document.getElementById("csrfToken");
													if (!csrfInput) return; // Discret : pas de token => pas d'action

													const csrfToken = csrfInput.value;

													// Envoi de la réservation au serveur
													fetch(`/MyAppoitements/BookAppoitement-follow-up/${appointmentId}`, {
														method: 'POST',
														headers: {
															"Content-Type": "application/json",
															"X-Requested-With": "XMLHttpRequest", //Ceci déclenche `req.xhr === true`
															"CSRF-Token": csrfToken
														},
														body: JSON.stringify({
															time: slot.time,
															doctor: doctorName,
															date: dateStr,
															doctorSchedule: doctorSchedules[doctorName], //Juste le planning de ce médecin
															preappointmentId: preappointmentId,
															appointmentType: appointmentType,
															appointmentMode: appointmentMode,
															scheduleId: doctorSchedules[doctorName]._id  //ENVOI DE L'ID DU PLANNING(essentiel pour faire delete et update)
														})
													})
														.then(response => response.json())
														.then(data => {
															// Si redirection nécessaire
															if (data.redirectTo) {
																window.location.href = data.redirectTo;
																return;
															}

															if (data.success) {
																localStorage.removeItem("appointmentInProgress");
																Swal.fire({
																	icon: "success",
																	title: "Success!",
																	text: data.message
																}).then(() => {
																	// Recharge la page après que l'utilisateur ait cliqué sur "OK"
																	location.reload();
																});
															} else {
																Swal.fire({
																	icon: "error",
																	title: "Oops...",
																	text: data.message
																}).then(() => {
																	// Recharge la page après que l'utilisateur ait cliqué sur "OK"
																	location.reload();
																});
															}
														})
														.catch(err => {
															// Si la requête échoue, affiche une alerte d'erreur
															Swal.fire(
																'Oops...',
																'Something went wrong, please try again later.',
																'error'
															);
														});
												} else {
													Swal.fire({
														icon: 'warning',
														title: 'Unavailable time',
														text: 'The selected time slot is not available. Please choose another one.'
													});
												}
											} else {
												Swal.fire({
													icon: 'warning',
													title: 'No schedule found',
													text: 'There is no schedule available for the selected date.'
												});
											}

										}
									});
								}
							});
						}

						// Masquer les créneaux au-delà du 3ème si non expand
						if (index >= 3 && !expanded) button.classList.add("d-none");
						timeSlotsContainer.appendChild(button);
					});

					// Vérifier si la date sélectionnée existe bien pour ce docteur
					const isDefined = doctorSchedule && doctorSchedule.schedules[dateStr];

					// Vérifier si la journée est fériée uniquement si elle existe
					const isHoliday = isDefined && Array.isArray(slots.available) && Array.isArray(slots.reserved) && slots.available.length === 0 && slots.reserved.length === 0;

					// Si c'est un jour férié, afficher "Closed"
					if (isHoliday) {
						let actionButton = document.createElement("input");
						actionButton.type = "button";
						actionButton.className = "btn w-100 fw-bold my-1";
						actionButton.value = "Closed";
						actionButton.style.backgroundColor = "#dc3545"; // Rouge
						actionButton.style.color = "white";
						actionButton.disabled = true;
						timeSlotsContainer.appendChild(actionButton);
					}



					//s'Il n’y a pas de créneaux définis pour ce médecin à cette date => on affiche un bouton Unavailable pour informer l’utilisateur.
					if ((!slots)) {
						const nonDispoBtn = document.createElement("button");
						nonDispoBtn.className = "btn m-1 fw-bold w-100";
						nonDispoBtn.style.backgroundColor = "#d39e00"; // Jaune foncé
						nonDispoBtn.style.color = "white";
						nonDispoBtn.textContent = "Unavailable";
						nonDispoBtn.disabled = true;
						timeSlotsContainer.appendChild(nonDispoBtn);
					}


					// Bouton "Voir plus..." si nécessaire
					if (allSlots.length > 3) {
						let plusBtn = document.createElement("input");
						plusBtn.type = "button";
						plusBtn.value = expanded ? "See less" : "See more...";
						plusBtn.className = "btn btn-primary w-100 fw-bold my-1";
						plusBtn.style.backgroundColor = "blue";
						plusBtn.style.color = "white";

						plusBtn.addEventListener("click", function () {
							expanded = !expanded;
							document.querySelectorAll("#time-slots .btn:not([data-toggle-btn])").forEach((btn, index) => {
								if (index >= 3) {
									btn.classList.toggle("d-none", !expanded);
								}
							});

							plusBtn.value = expanded ? "See less" : "See more...";
						});

						plusBtn.setAttribute("data-toggle-btn", "true");
						timeSlotsContainer.appendChild(plusBtn);
					}
				}

				// Fonction pour convertir une heure "HH:mm" en minutes (pour un tri correct)
				function convertToMinutes(timeStr) {
					let [hours, minutes] = timeStr.split(":").map(Number);
					return hours * 60 + minutes;
				}

				//Remplir le select avec les mois et années
				function populateMonthYearSelect() {
					let currentYear = new Date().getFullYear();
					let startYear = currentYear - 2; // Afficher les années autour de l'année actuelle
					let endYear = currentYear + 2;

					monthYearSelect.innerHTML = ""; // Vider avant de remplir

					for (let year = startYear; year <= endYear; year++) {
						for (let month = 0; month < 12; month++) {
							let date = new Date(Date.UTC(year, month, 1));
							let monthName = date.toLocaleDateString("en-US", { month: "long" });
							let option = document.createElement("option");
							option.value = `${year}-${month}`;
							option.textContent = `${monthName} ${year}`;

							// Sélectionner par défaut le mois et année actuels en UTC
							if (year === selectedDate.getUTCFullYear() && month === selectedDate.getUTCMonth()) {
								option.selected = true;
							}

							monthYearSelect.appendChild(option);
						}
					}
				}

				//Mettre à jour l'affichage de la date et synchroniser le select
				function updateDateDisplay() {
					selectedDateElem.textContent = selectedDate.toLocaleDateString("en-US", {
						weekday: 'long',
						day: 'numeric',
						month: 'long',
						year: 'numeric'
					});

					// Mettre à jour le select avec le bon mois/année
					monthYearSelect.value = `${selectedDate.getUTCFullYear()}-${selectedDate.getUTCMonth()}`;
					expanded = false;
					updateTimeSlots(); // Mise à jour de l'affichage des créneaux
				}


				//Gérer le changement de jour avec les flèches
				prevDayBtn.addEventListener("click", function () {
					selectedDate.setDate(selectedDate.getDate() - 1);
					updateDateDisplay();
				});

				nextDayBtn.addEventListener("click", function () {
					selectedDate.setDate(selectedDate.getDate() + 1);
					updateDateDisplay();
				});

				//Gérer le changement de mois avec le select
				monthYearSelect.addEventListener("change", function () {
					let [year, month] = this.value.split("-");
					selectedDate.setUTCFullYear(parseInt(year));
					selectedDate.setUTCMonth(parseInt(month));
					selectedDate.setUTCDate(1); // Aller au premier jour du mois sélectionné

					updateDateDisplay();
				});

				// Initialisation
				populateMonthYearSelect();
				updateDateDisplay();
			});
		</script>

		<!-- JavaScript pour afficher/masquer selon le choix (feeding ou bien pediatrics): -->
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const appointmentTypeSelect = document.getElementById("appointmentType");
				const feedingModeContainer = document.getElementById("feedingModeContainer");

				appointmentTypeSelect.addEventListener("change", function () {
					if (this.value === "feeding") {
						feedingModeContainer.style.display = "block";
					} else {
						feedingModeContainer.style.display = "none";
					}
				});
			});
		</script>

		 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<% if (message) { %>
			<script nonce="<%= nonce %>">
				Swal.fire({
					icon: 'error',
					title: 'Oops...',
					text: "<%= message %>",
					confirmButtonText: 'OK'
				});
			</script>
		<% } %>
			
    </body>
</html>