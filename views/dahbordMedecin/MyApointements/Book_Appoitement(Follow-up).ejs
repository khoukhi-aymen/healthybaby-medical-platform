					<!-- Start Appointment Form Section (hidden by default) -->
					<section class="container-fluid mt-5 p-4" id="appointment-form">
						<div id="schedules-data" data-schedules='<%= JSON.stringify(doctorSchedules) %>' hidden></div>
						<div class="row justify-content-center">
							<div class="col-12 col-md-8 col-lg-6">
								<div class="App card shadow p-4">
									<h3 class="App-title text-center">Book an Appointment</h3>
									<br><br>
									<form class="App-form" id="appointment">
										<input type="hidden" id="csrfToken" value="<%= csrfToken %>">
										<input type="hidden" id="appointmentId" value="<%= appointmentId %>">
										<% if (preappointmentId) { %>
											<div id="preappointment-info" data-preappointment-id="<%= preappointmentId %>" class="alert alert-success">
												Pre-appointment created with ID: <%= preappointmentId %>
											</div>
											<% } %>
												<br>
												<!-- Select a doctor -->
												<div class="mb-3 d-flex flex-column align-items-center" id="doctor-selection">
													<label class="form-label fw-bold">Choose a docteur :</label>
													<div class="d-flex flex-column align-items-start gap-2" id="doctor-radio-group">
													</div>
												</div>
					
					
												<!-- Appointment Type -->
												<div class="mb-3">
													<label for="appointmentType" class="form-label fw-bold">Appointment
														Type:</label>
													<select class="form-select" id="appointmentType" name="appointmentType">
														<option value="" disabled selected>Select type</option>
														<option value="feeding">Breastfeeding</option>
														<option value="pediatrics">Pediatrics</option>
													</select>
												</div>
					
												<!-- Feeding Mode (shown only if feeding is selected) -->
												<div class="mb-3" id="feedingModeContainer" style="display: none;">
													<label for="feedingMode" class="form-label fw-bold">Breastfeeding Appointment
														Mode:</label>
													<select class="form-select" id="feedingMode" name="feedingMode">
														<option value="" disabled selected>Select mode</option>
														<option value="online">Online</option>
														<option value="Face-to-face">Face-to-face</option>
													</select>
												</div>
					
					
					
					
					
												<div class="container mt-4">
													<!-- Section: Navigation entre jours -->
													<div class="mb-4 text-center">
