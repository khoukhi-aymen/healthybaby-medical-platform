						) {
							delete doctorSchedules[doctor][dateStr];
							// console.log(`🗑️ Suppression de ${dateStr} (créneaux vidés).`);
						}
							
						// console.log(doctorSchedules)
             		}	

					updateTimeSlots();
					Swal.fire({
						icon: "success",
						title: "Deleted!",
						html: `Timeslot deleted successfully <strong>${repetitionText}</strong><br>Please confirm your submission.`
					});
				}


				//repeat every week
				function deleteWeeklySlots(time) {
					let startDate = new Date(selectedDate);
					let firstDayOfWeek = new Date(startDate);
					firstDayOfWeek.setDate(startDate.getDate() - (startDate.getDay() + 1) % 7); // Trouver le samedi

					// console.log("📅 Début de la suppression hebdomadaire à partir de :", formatDate(firstDayOfWeek));

					for (let i = 0; i < 7; i++) {
						let nextDate = new Date(firstDayOfWeek);
						nextDate.setDate(firstDayOfWeek.getDate() + i);
						let nextDateStr = formatDate(nextDate);

						if (doctorSchedules[doctor][nextDateStr]) {
							let slots = doctorSchedules[doctor][nextDateStr];
							let index = slots.available.indexOf(time);

							if (index !== -1) {
								slots.available.splice(index, 1);
								// console.log(`✅ Créneau "${time}" supprimé pour ${nextDateStr}`);
							} else {
								// console.log(`⚠️ Aucun créneau "${time}" trouvé pour ${nextDateStr}, rien à supprimer.`);
