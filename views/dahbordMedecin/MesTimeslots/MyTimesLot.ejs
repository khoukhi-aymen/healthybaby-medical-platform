									<input type="hidden" id="csrfToken" value="<%= csrfToken %>">
									<div id="schedules-data" data-schedules='<%= JSON.stringify(schedules) %>' hidden></div>
									<div class="container mt-4">
										<div id="holiday-selection" style="display: none;">
											<!-- Holiday Selection Title -->
											<h5 class="selectHolidays form-label mb-3">Select Holidays:</h5>
		
											<!-- Holidays List -->
											<div class="HolidayItems d-flex flex-column">
												<div class="d-flex form-check align-items-center">
													<input class="form-check-input me-2" type="checkbox" id="holiday-saturday"
														value="Saturday" name='holiday'>
													<label class="form-check-label" for="holiday-saturday">Saturday</label>
												</div>
												<div class="d-flex form-check align-items-center">
													<input class="form-check-input me-2" type="checkbox" id="holiday-sunday"
														value="Sunday" name='holiday'>
													<label class="form-check-label" for="holiday-sunday">Sunday</label>
												</div>
												<div class=" d-flex form-check align-items-center">
													<input class="form-check-input me-2" type="checkbox" id="holiday-monday"
														value="Monday" name='holiday'>
													<label class="form-check-label" for="holiday-monday">Monday</label>
												</div>
												<div class="d-flex  form-check align-items-center">
													<input class="form-check-input me-2" type="checkbox" id="holiday-tuesday"
														value="Tuesday" name='holiday'>
													<label class="form-check-label" for="holiday-tuesday">Tuesday</label>
												</div>
												<div class="d-flex  form-check align-items-center">
													<input class="form-check-input me-2" type="checkbox" id="holiday-wednesday"
														value="Wednesday" name='holiday'>
													<label class="form-check-label" for="holiday-wednesday">Wednesday</label>
												</div>
												<div class="d-flex  form-check align-items-center">
													<input class="form-check-input me-2" type="checkbox" id="holiday-thursday"
														value="Thursday" name='holiday'>
													<label class="form-check-label" for="holiday-thursday">Thursday</label>
												</div>
												<div class="d-flex  form-check align-items-center">
													<input class="form-check-input me-2" type="checkbox" id="holiday-friday"
														value="Friday" name='holiday'>
													<label class="form-check-label" for="holiday-friday">Friday</label>
												</div>
											</div>
										</div>
		
										<br><br>
		
										<div class="d-flex align-items-center justify-content-center text-center">
											<!-- Sélection de répétition -->
											<select id="repeat-option" class="form-select">
												<option value="none">No Repeat</option>
												<option value="week">Repeat this week</option>
												<option value="month">Repeat this month</option>
												<option value="year">Repeat this year</option>
		
											</select>
										</div>
