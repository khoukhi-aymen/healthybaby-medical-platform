					}

					// console.log("📅 Emplois du temps après Suppression hebdomadaire:", doctorSchedules);
				}


				//repeat every mounth
				function deleteMonthSlots(time) {
					let startDate = new Date(selectedDate);
					let thisMonthDate = new Date(startDate);
					thisMonthDate.setMonth(startDate.getMonth());
					thisMonthDate.setDate(1);

					let lastDayOfMonth = new Date(thisMonthDate.getFullYear(), thisMonthDate.getMonth() + 1, 0).getDate();

					// console.log(`📅 Début de la suppression mensuelle à partir de : ${formatDate(thisMonthDate)}`);

					for (let day = 1; day <= lastDayOfMonth; day++) {
						let nextDate = new Date(thisMonthDate);
						nextDate.setDate(day);
						let nextDateStr = formatDate(nextDate);

						if (doctorSchedules[doctor][nextDateStr]) {
							let slots = doctorSchedules[doctor][nextDateStr];
							let index = slots.available.indexOf(time);

							if (index !== -1) {
								slots.available.splice(index, 1);
								// console.log(`✅ Créneau "${time}" supprimé pour ${nextDateStr}`);
							} else {
								// console.log(`⚠️ Aucun créneau "${time}" trouvé pour ${nextDateStr}, rien à supprimer.`);
							}

							// Ne supprimer le jour que s'il a été vidé et qu'il ne faisait pas partie des jours vides initiaux
							if (
								slots.available.length === 0 &&
								slots.reserved.length === 0 &&
								!emptyDaysInitially.has(nextDateStr)
							) {
								delete doctorSchedules[doctor][nextDateStr];
								// console.log(`🗑️ Suppression de ${nextDateStr} (vidé par l’utilisateur, non jour férié).`);
							}
						} else {
							// console.log(`🔹 Aucun créneau existant pour ${nextDateStr}, rien à supprimer.`);
						}
					}

					// console.log("📅 Emplois du temps après suppression mensuelle:", doctorSchedules);
				}


                //repeat every Year
				function deleteYearSlots(time) {
					let startDate = new Date(selectedDate);
					let currentYear = startDate.getFullYear();

					// console.log(`📅 Début de la suppression annuelle pour l'année ${currentYear}, créneau: "${time}"`);

					for (let month = 0; month < 12; month++) {
						let thisMonthDate = new Date(currentYear, month, 1); // Premier jour du mois
						let lastDayOfMonth = new Date(currentYear, month + 1, 0).getDate(); // Dernier jour du mois

						// console.log(`📆 Traitement du mois : ${thisMonthDate.toLocaleDateString("fr-FR", { month: "long", year: "numeric" })}`);

						for (let day = 1; day <= lastDayOfMonth; day++) {
							let nextDate = new Date(currentYear, month, day);
							let nextDateStr = formatDate(nextDate);

							// Vérifier si un créneau existe pour ce jour
							if (doctorSchedules[doctor][nextDateStr]) {
								let slots = doctorSchedules[doctor][nextDateStr];
								let index = slots.available.indexOf(time);

								if (index !== -1) {
									slots.available.splice(index, 1);
									// console.log(`✅ Créneau "${time}" supprimé pour ${nextDateStr}`);
								} else {
									// console.log(`⚠️ Aucun créneau "${time}" trouvé pour ${nextDateStr}, rien à supprimer.`);
								}

								// Supprimer la date uniquement si aucun créneau ET ce n’est pas un jour férié (exclure les jours fériés)
								if (
									slots.available.length === 0 &&
									slots.reserved.length === 0 &&
									!emptyDaysInitially.has(nextDateStr) // Assure que le jour n'est pas férié
								) {
									delete doctorSchedules[doctor][nextDateStr];
									// console.log(`🗑️ Tous les créneaux supprimés pour ${nextDateStr}, suppression de la date (non fériée).`);
								}
							} else {
								// console.log(`🔹 Aucun créneau existant pour ${nextDateStr}, rien à supprimer.`);
							}
						}
					}

					// console.log("📅 Emplois du temps après suppression annuelle:", doctorSchedules);
				}


				
				/*********************remove Time Slots *********************/





				/*********************remove Closed Day *********************/

				function deleteClosedDay(dateStr, repeatType) {
					if (!doctorSchedules[doctor] || !doctorSchedules[doctor][dateStr]) {
						Swal.fire({ icon: "error", title: "Oops...", text: "This day is not marked as closed!" });
						return;
					}

					let slots = doctorSchedules[doctor][dateStr];

					let isActuallyClosed =
						Array.isArray(slots.available) &&
						Array.isArray(slots.reserved) &&
						slots.available.length === 0 &&
						slots.reserved.length === 0;

					if (!isActuallyClosed) {
						Swal.fire({ icon: "error", title: "Oops...", text: "This day is not fully closed!" });
						return;
					}

			
					//Gérer les suppressions répétées
					if (repeatType === "week") {
						repetitionText = "for this week";
						deleteWeeklyClosedDays();
					} else if (repeatType === "month") {
						repetitionText = "for this month";
						deleteMonthlyClosedDays();
					} else if (repeatType === "year") {
						repetitionText = "for this year";
						deleteYearlyClosedDays();
					} else if (repeatType === "none"){
						repetitionText = "for this day only";
						//Supprimer le jour fermé uniquement pour cette date
						delete doctorSchedules[doctor][dateStr];
						// console.log(`🗑️ Jour fermé supprimé : ${dateStr}`);
					}

					updateTimeSlots();
					Swal.fire({
						icon: "success",
						title: "Closed day removed!",
						html: `Day reopened successfully <strong>${repetitionText}</strong><br>Please confirm your submission.`
					});
				}


				//repeat every week
				function deleteWeeklyClosedDays() {
					const startDate = new Date(selectedDate);
					const firstDayOfWeek = new Date(startDate);
					firstDayOfWeek.setDate(startDate.getDate() - ((startDate.getDay() + 1) % 7)); // Trouve le samedi

					// console.log("📅 Début de la suppression des jours fermés (Closed) à partir de :", formatDate(firstDayOfWeek));

					for (let i = 0; i < 7; i++) {
						const currentDate = new Date(firstDayOfWeek);
						currentDate.setDate(firstDayOfWeek.getDate() + i);
						const currentDateStr = formatDate(currentDate);

						if (doctorSchedules[doctor] && doctorSchedules[doctor][currentDateStr]) {
							const slots = doctorSchedules[doctor][currentDateStr];

							const isClosed =
								Array.isArray(slots.available) &&
								Array.isArray(slots.reserved) &&
								slots.available.length === 0 &&
								slots.reserved.length === 0;

							if (isClosed) {
								delete doctorSchedules[doctor][currentDateStr];
								// console.log(`🗑️ Jour fermé supprimé : ${currentDateStr}`);
							} else {
								// console.log(`✅ ${currentDateStr} n'est pas fermé, rien à supprimer.`);
							}
						} else {
							// console.log(`🔹 Aucun emploi du temps trouvé pour ${currentDateStr}`);
						}
					}

					// console.log("📅 Résultat après suppression des jours fermés :", doctorSchedules);
				}

  
				//repeat every Month
				function deleteMonthlyClosedDays() {
					const startDate = new Date(selectedDate);
					const monthStartDate = new Date(startDate.getFullYear(), startDate.getMonth(), 1); // Premier jour du mois
					const monthEndDate = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 0); // Dernier jour du mois

					// console.log("📅 Début de la suppression des jours fermés (Closed) pour le mois à partir de :", formatDate(monthStartDate));

					// Boucle sur tous les jours du mois
					for (let day = monthStartDate.getDate(); day <= monthEndDate.getDate(); day++) {
						const currentDate = new Date(monthStartDate);
