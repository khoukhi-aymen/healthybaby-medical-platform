							const isClosed =
								Array.isArray(slots.available) &&
								Array.isArray(slots.reserved) &&
								slots.available.length === 0 &&
								slots.reserved.length === 0;

							if (isClosed) {
								delete doctorSchedules[doctor][currentDateStr];
								// console.log(`🗑️ Jour fermé supprimé : ${currentDateStr}`);
							} else {
								// console.log(`✅ ${currentDateStr} n'est pas fermé, rien à supprimer.`);
							}
						} else {
							// console.log(`🔹 Aucun emploi du temps trouvé pour ${currentDateStr}`);
						}
					}

					// console.log("📅 Résultat après suppression des jours fermés pour le mois :", doctorSchedules);
				}


				//repeat every Year
				function deleteYearlyClosedDays() {
					const startDate = new Date(selectedDate);
					const currentYear = startDate.getFullYear(); // Année actuelle de la date sélectionnée

					//console.log("📅 Début de la suppression des jours fermés (Closed) pour l'année :", currentYear);

					// Boucle sur tous les mois de l'année
					for (let month = 0; month < 12; month++) {
						const monthStartDate = new Date(currentYear, month, 1); // Premier jour du mois
						const monthEndDate = new Date(currentYear, month + 1, 0); // Dernier jour du mois

						//console.log(`📆 Traitement du mois : ${monthStartDate.toLocaleDateString("fr-FR", { month: "long", year: "numeric" })}`);

						// Boucle sur tous les jours du mois
						for (let day = monthStartDate.getDate(); day <= monthEndDate.getDate(); day++) {
							const currentDate = new Date(currentYear, month, day); // Ajuste au jour courant
							const currentDateStr = formatDate(currentDate);

							if (doctorSchedules[doctor] && doctorSchedules[doctor][currentDateStr]) {
								const slots = doctorSchedules[doctor][currentDateStr];

								const isClosed =
									Array.isArray(slots.available) &&
									Array.isArray(slots.reserved) &&
									slots.available.length === 0 &&
									slots.reserved.length === 0;

								if (isClosed) {
									delete doctorSchedules[doctor][currentDateStr]; // Supprime le jour fermé
									// console.log(`🗑️ Jour fermé supprimé : ${currentDateStr}`);
								} else {
									//console.log(`✅ ${currentDateStr} n'est pas fermé, rien à supprimer.`);
								}
							} else {
								//console.log(`🔹 Aucun emploi du temps trouvé pour ${currentDateStr}`);
							}
						}
					}

					//console.log("📅 Résultat après suppression des jours fermés pour l'année :", doctorSchedules);
				}

				
                /*********************remove Closed Day *********************/




                //Remplir le select avec les mois et années
				function populateMonthYearSelect() {
					let currentYear = new Date().getFullYear();
					let startYear = currentYear - 2; // Afficher les années autour de l'année actuelle
					let endYear = currentYear + 2;

					monthYearSelect.innerHTML = ""; // Vider avant de remplir

					for (let year = startYear; year <= endYear; year++) {
						for (let month = 0; month < 12; month++) {
							let date = new Date(Date.UTC(year, month, 1));
							let monthName = date.toLocaleDateString("en-US", { month: "long" });
							let option = document.createElement("option");
							option.value = `${year}-${month}`;
							option.textContent = `${monthName} ${year}`;

							// Sélectionner par défaut le mois et année actuels en UTC
							if (year === selectedDate.getUTCFullYear() && month === selectedDate.getUTCMonth()) {
								option.selected = true;
							}

							monthYearSelect.appendChild(option);
						}
					}
				}

				//Mettre à jour l'affichage de la date et synchroniser le select
				function updateDateDisplay() {
					selectedDateElem.textContent = selectedDate.toLocaleDateString("en-US", {
						weekday: 'long',
						day: 'numeric',
						month: 'long',
						year: 'numeric'
					});

					// Mettre à jour le select avec le bon mois/année
					monthYearSelect.value = `${selectedDate.getUTCFullYear()}-${selectedDate.getUTCMonth()}`;
					expanded = false;
					updateTimeSlots(); // Mise à jour de l'affichage des créneaux
				}

				//Gérer le changement de jour avec les flèches
				prevDayBtn.addEventListener("click", function () {
					selectedDate.setDate(selectedDate.getDate() - 1);
					updateDateDisplay();
				});

				nextDayBtn.addEventListener("click", function () {
					selectedDate.setDate(selectedDate.getDate() + 1);
					updateDateDisplay();
				});

				//Gérer le changement de mois avec le select
				monthYearSelect.addEventListener("change", function () {
					let [year, month] = this.value.split("-");
					selectedDate.setUTCFullYear(parseInt(year));
					selectedDate.setUTCMonth(parseInt(month));
					selectedDate.setUTCDate(1); // Aller au premier jour du mois sélectionné

					updateDateDisplay();
				});


				// Ajouter l'écouteur d'événements pour le formulaire
				const form = document.getElementById("appointment");
				form.addEventListener("submit", function (e) {
					e.preventDefault(); // Empêche l'envoi du formulaire par défaut
					// Appeler la fonction de soumission après avoir préparé les données
					setupFormSubmission(doctorSchedules);
				});

				// Initialisation
				populateMonthYearSelect();
				updateDateDisplay();
			});

		</script>

		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<% if (message) { %>
			<script nonce="<%= nonce %>">
				Swal.fire({
					icon: 'error',
					title: 'Oops...',
					text: "<%= message %>",
					confirmButtonText: 'OK'
				});
			</script>
		<% } %>
			
