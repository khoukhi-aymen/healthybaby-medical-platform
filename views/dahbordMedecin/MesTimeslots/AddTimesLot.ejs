										<div class="d-flex flex-column align-items-center mt-3" id="time-slots">
											<!-- Créneaux ajoutés dynamiquement -->
										</div>
									</div>
									<br><br>
		
									<div id="alert-container"></div>
		
									<button type="submit" class="btn btn-primary w-100">
										confirm your submission
									</button>
								</form>
							</div>
