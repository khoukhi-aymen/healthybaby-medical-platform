		<!--Calendrier interactive Bootstrap JS + JavaScript dynamique -->
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
		<script nonce="<%= nonce %>">
			document.addEventListener("DOMContentLoaded", function () {
				const selectedDateElem = document.getElementById("selected-date");
				const timeSlotsContainer = document.getElementById("time-slots");
				const prevDayBtn = document.getElementById("prev-day");
				const nextDayBtn = document.getElementById("next-day");
				const monthYearSelect = document.getElementById("month-year-select");
				const repeatOption = document.getElementById("repeat-option");
				const holidaySelection = document.getElementById("holiday-selection"); // Sélection du div


				//récupérer les jours fériées séléctionnées
				function getExcludedDays() {
					return Array.from(document.querySelectorAll('input[name="holiday"]:checked'))
						.map(checkbox => checkbox.value);
				}



				// Ajoute un écouteur d'événements pour détecter les changements sur les cases à cocher
				document.querySelectorAll('input[name="holiday"]').forEach(checkbox => {
					checkbox.addEventListener('change', function () {
						let dayLabel = this.dataset.label || this.value;
						let dayName = this.value;

						// Fonction utilitaire pour compter les jours touchés
						function countAffectedSlots() {
							let totalSlots = 0;
							let affectedCount = 0;

							for (let doctorName in doctorSchedules) {
								for (let dateStr in doctorSchedules[doctorName]) {
									let date = new Date(dateStr);
									let day = date.toLocaleDateString('en-US', { weekday: 'long' });

									if (day.toLowerCase() === dayName.toLowerCase()) {
										let data = doctorSchedules[doctorName][dateStr];
										let count = (data.available?.length || 0) + (data.reserved?.length || 0);
										if (count > 0) {
											totalSlots += count;
											affectedCount++;
										}
									}
								}
							}
							return { totalSlots, affectedCount };
						}

						if (this.checked) {
							let { totalSlots, affectedCount } = countAffectedSlots();

							if (totalSlots > 0) {
								Swal.fire({
									icon: 'warning',
									title: `Confirm Public Holiday`,
									html: `
						                   Setting <b>${dayLabel}</b> as a public holiday will remove<br>
						    			   <b>${totalSlots}</b> time slot(s) across <b>${affectedCount}</b> day(s).<br><br>
						                   This action cannot be undone.<br>Do you want to proceed?
					                      `,
									showCancelButton: true,
									confirmButtonText: 'Yes, confirm',
									cancelButtonText: 'Cancel',
									confirmButtonColor: '#3085d6',
									cancelButtonColor: '#d33',
								}).then(result => {
									if (result.isConfirmed) {
										addHolidaysForYear();
										Swal.fire({
											icon: 'info',
											title: 'Public Holiday Confirmed',
											html: `${dayLabel} is now set as a yearly holiday.<br>Please confirm your submission.`
										});
									} else {
										this.checked = false; // Rétablir la case si l'utilisateur annule
									}
								});
							} else {
								addHolidaysForYear();
								Swal.fire({
									icon: 'info',
									title: 'Public Holiday Selected',
									html: `${dayLabel} is now set as a yearly holiday.<br>Please confirm your submission.`
								});
							}
						} else {
							removeHolidaysForYear(dayName);
							Swal.fire({
								icon: 'info',
								title: 'Holiday Removed',
								text: `${dayLabel} has been removed from public holidays.`
							});
						}

						let excludedDays = getExcludedDays();
						// console.log("⛔ Jours fériés sélectionnés:", excludedDays);
						// console.log("📅 doctorSchedules:", doctorSchedules);
					});
				});


				let selectedDate = new Date();
				let expanded = false;

                //doctorSchedules est récupérée à partir de la BD aussi(user connecté) 
				const doctor = "<%= doctorName %>";
				const rawData = document.getElementById("schedules-data").dataset.schedules;
				const rawSchedules = JSON.parse(rawData);

				const doctorSchedules = {
					[doctor]: {}
				};

				rawSchedules.forEach(entry => {
					doctorSchedules[doctor][entry.date] = {
						available: entry.available || [],
						reserved: entry.reserved || []
					};
				});

				// console.log(doctorSchedules);



				/******mettre les jours marqué comme fériés dans doctorSchedules coché pour aider le user ****/

				const weekDayCounters = {
					Sunday: 0,
					Monday: 0,
					Tuesday: 0,
					Wednesday: 0,
					Thursday: 0,
					Friday: 0,
					Saturday: 0
				};

				const emptyDayCounters = {
					Sunday: 0,
					Monday: 0,
					Tuesday: 0,
					Wednesday: 0,
					Thursday: 0,
					Friday: 0,
					Saturday: 0
				};

				for (const dateStr in doctorSchedules[doctor]) {
					const date = new Date(dateStr);
					const weekday = date.toLocaleDateString("en-US", { weekday: "long" });

					const entry = doctorSchedules[doctor][dateStr];
					const isEmpty = Array.isArray(entry.available) &&
						Array.isArray(entry.reserved) &&
						entry.available.length === 0 &&
						entry.reserved.length === 0;

					weekDayCounters[weekday]++;
					if (isEmpty) {
						emptyDayCounters[weekday]++;
					}
				}


				// Étape 1 : Compter combien de jours sont totalement vides
				let totalEmptyDays = 0;

				for (const dateStr in doctorSchedules[doctor]) {
					const entry = doctorSchedules[doctor][dateStr];
					const isEmpty = Array.isArray(entry.available) &&
						Array.isArray(entry.reserved) &&
						entry.available.length === 0 &&
						entry.reserved.length === 0;

					if (isEmpty) totalEmptyDays++;
				}

				// Si tous les créneaux d’un jour de la semaine sont vides, alors c’est sûrement un jour férié récurrent
				document.querySelectorAll("input[name='holiday']").forEach(cb => {
					const label = cb.getAttribute("data-label");

					if (totalEmptyDays === 0) {
						// Aucun jour libre détecté → laisser tout activé
						cb.checked = false;
						cb.disabled = false;
						cb.title = "You can select this day as a public holiday if needed";
						return;
					}

					// Sinon, on applique la logique automatique
					const isAutoHoliday =
						label &&
						emptyDayCounters[label] > 0 &&
						emptyDayCounters[label] === weekDayCounters[label];

					if (isAutoHoliday) { //jour n'est pas couché comme holiday alos il est disabled 
						cb.checked = true;
						cb.disabled = true;
						cb.setAttribute("data-auto", "true");
						cb.title = "Automatically marked as public holiday based on schedule";
					} else { //jour couché comme holiday alors il est disabled
						cb.checked = false;
						cb.disabled = true;
						cb.setAttribute("data-locked", "true");
						cb.title = "This day is not marked as a public holiday";
					}
				});


				/******mettre les jours marqué comme fériés dans doctorSchedules coché pour aider le user ****/


				function formatDate(date) {
					return date.getFullYear() + '-' +
						String(date.getMonth() + 1).padStart(2, '0') + '-' +
						String(date.getDate()).padStart(2, '0');
				}



				function updateTimeSlots() {
					timeSlotsContainer.innerHTML = "";
					const dateStr = formatDate(selectedDate);
					const slots = doctorSchedules[doctor][dateStr] || { available: [], reserved: [] };

					const allSlots = [
						...slots.available.map(s => ({ time: s, reserved: false })),
						...slots.reserved.map(s => ({ time: s, reserved: true }))
					];


					// 🔹 Tri des créneaux avant l'affichage
					allSlots.sort((a, b) => convertToMinutes(a.time) - convertToMinutes(b.time));

					allSlots.forEach((slot, index) => {
						let button = document.createElement("input");
						button.type = "button";
						button.className = `btn fw-bold w-100 text-center my-1 ${slot.reserved ? "btn-secondary disabled" : "btn-success"}`;
						button.style.backgroundColor = slot.reserved ? "rgb(73, 77, 83)" : "green";
						button.style.color = "white";
						button.value = slot.time;
						button.disabled = slot.reserved;

						if (index >= 3 && !expanded) button.classList.add("d-none");
						timeSlotsContainer.appendChild(button);
					});


					// Bouton "Voir plus..." si nécessaire
					if (allSlots.length > 3) {
						let plusBtn = document.createElement("input");
						plusBtn.type = "button";
						plusBtn.value = expanded ? "See less" : "See more...";
						plusBtn.className = "btn btn-primary w-100 fw-bold my-1";
						plusBtn.style.backgroundColor = "blue";
						plusBtn.style.color = "white";

						plusBtn.addEventListener("click", function () {
							expanded = !expanded;
							document.querySelectorAll("#time-slots .btn:not([data-toggle-btn])").forEach((btn, index) => {
								if (index >= 3) {
									btn.classList.toggle("d-none", !expanded);
								}
							});

							plusBtn.value = expanded ? "See less" : "See more...";
						});

						plusBtn.setAttribute("data-toggle-btn", "true");
						timeSlotsContainer.appendChild(plusBtn);
					}


					// Vérifier si la date sélectionnée existe bien pour ce docteur
					const isDefined = doctorSchedules[doctor] && doctorSchedules[doctor][dateStr];

					// Vérifier si la journée est fériée uniquement si elle existe
					const isHoliday = isDefined && Array.isArray(slots.available) && Array.isArray(slots.reserved) && slots.available.length === 0 && slots.reserved.length === 0;

					let actionButton = document.createElement("input");
					actionButton.type = "button";
					actionButton.className = "btn w-100 fw-bold my-1";

					// Si c'est un jour férié, afficher "Closed"
					if (isHoliday) {
						actionButton.value = "Closed";
						actionButton.style.backgroundColor = "#dc3545"; // Rouge
						actionButton.style.color = "white";
						actionButton.disabled = true;
					} else {
						// Sinon, afficher "Add a Timeslot"(affichée dans les jours de travail)
						actionButton.value = "Add a Timeslot";
						actionButton.style.backgroundColor = "#0b5ed7"; // Bleu
						actionButton.style.color = "white";
						actionButton.style.border = "0px";
						actionButton.classList.add("btn-primary");
						actionButton.setAttribute("data-toggle-btn", "true"); //Ajout de cet attribut pour exclure du masquage
						// Ajouter un événement pour ouvrir l'input de saisie
						actionButton.addEventListener("click", function () {
							Swal.fire({
								title: "Add a Timeslot",
								input: "time",
								inputLabel: "Enter a timeslot (HH:MM):",
								confirmButtonText: "Add",
								showCancelButton: true,
								cancelButtonText: "Cancel",
								inputValidator: (value) => {
									if (!value) return "You need to enter a time!";
									return null;
								}
							}).then((result) => {
								if (result.isConfirmed) {
									let newTime = result.value;
									let repeatType = repeatOption.value;
									addTimeSlot(dateStr, newTime, repeatType);
								}
							});
						});
					}

					timeSlotsContainer.appendChild(actionButton);
				}

				
                // Fonction de soumission du formulaire
				function setupFormSubmission(doctorSchedules) {
					const csrfInput = document.getElementById("csrfToken");
					if (!csrfInput) return; // Discret : pas de token => pas d'action

					const csrfToken = csrfInput.value;

					// Envoi de la requête au serveur
					fetch("/AddTimesLot", {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							"X-Requested-With": "XMLHttpRequest", //Ceci déclenche `req.xhr === true`
							"CSRF-Token": csrfToken
						},
						body: JSON.stringify({ doctorSchedules }),
					})
					.then(res => res.json())
					.then(data => {
							// Si redirection nécessaire
							if (data.redirectTo) {
								window.location.href = data.redirectTo;
								return;
							}

							if (data.success) {
								Swal.fire({
									icon: "success",
									title: "Success!",
									text: data.message
								}).then(() => {
									// Recharge la page après que l'utilisateur ait cliqué sur "OK"
									location.reload();
								});
							} else {
								Swal.fire({
									icon: "error",
									title: "Oops...",
									text: data.message
								}).then(() => {
									// Recharge la page après que l'utilisateur ait cliqué sur "OK"
									location.reload();
								});
							}
					})
					.catch(err => {
						// Si la requête échoue, affiche une alerte d'erreur
						Swal.fire(
							'Oops...',
							'Something went wrong, please try again later.',
							'error'
						);
					});
				}

				
				
				// Fonction pour convertir une heure "HH:mm" en minutes (pour un tri correct)
				function convertToMinutes(timeStr) {
					let [hours, minutes] = timeStr.split(":").map(Number);
					return hours * 60 + minutes;
				}


				// Fonction pour ajouter les jours fériés sur toute l'année
				function addHolidaysForYear() {
					let currentYear = new Date().getFullYear();
					let startOfYear = new Date(currentYear, 0, 1); // 1er janvier

					//S'assurer que l'objet pour le docteur existe
					if (!doctorSchedules[doctor]) {
						doctorSchedules[doctor] = {};
					}

					// Liste des jours fériés à exclure (exemple: ["Sunday", "Wednesday"])
					let excludedDays = getExcludedDays();
					// console.log("🚫 Jours fériés pour l'année:", excludedDays);

					for (let i = 0; i < 365; i++) {
						let currentDate = new Date(startOfYear);
						currentDate.setDate(startOfYear.getDate() + i);

						let dayName = currentDate.toLocaleDateString('en-US', { weekday: 'long' });
						let dateStr = formatDate(currentDate);

						// Si c'est un jour férié, on vide les créneaux
						if (excludedDays.includes(dayName)) {
							if (!doctorSchedules[doctor].hasOwnProperty(dateStr)) {
								doctorSchedules[doctor][dateStr] = { available: [], reserved: [] };
							} else {
								doctorSchedules[doctor][dateStr].available = [];
								doctorSchedules[doctor][dateStr].reserved = [];
							}
							// console.log(`🚫 Jour férié ${dayName} - Créneaux vidés pour ${dateStr}`);
						}
					}
				}



				// Fonction pour supprimer les jours fériés sur toute l'année
				function removeHolidaysForYear(dayName) {
					const currentYear = new Date().getFullYear();
					const startOfYear = new Date(currentYear, 0, 1); // 1er janvier

					for (let i = 0; i < 365; i++) {
						let currentDate = new Date(startOfYear);
						currentDate.setDate(startOfYear.getDate() + i);

						let currentDay = currentDate.toLocaleDateString('en-US', { weekday: 'long' });
						let dateStr = formatDate(currentDate);

						if (currentDay === dayName) {
							// Supprimer la date uniquement si elle a été marquée comme jour férié (donc sans créneaux)
							if (
								doctorSchedules[doctor] &&
								doctorSchedules[doctor][dateStr] &&
								doctorSchedules[doctor][dateStr].available.length === 0 &&
								doctorSchedules[doctor][dateStr].reserved.length === 0
							) {
								delete doctorSchedules[doctor][dateStr]; // Retire du planning
								// console.log(`✅ Jour restauré: ${dayName} pour ${dateStr}`);
							}
						}
					}
				}



				function addTimeSlot(dateStr, newTime, repeatType) {
					if (!doctorSchedules[doctor][dateStr]) {
						doctorSchedules[doctor][dateStr] = { available: [], reserved: [] };
					}
					let slots = doctorSchedules[doctor][dateStr];

					if (slots.available.includes(newTime) || slots.reserved.includes(newTime)) {
						Swal.fire({ icon: "error", title: "Oops...", text: "This timeslot already exists!" });
						return;
					}

					// Ajouter le créneau dans "available"
					slots.available.push(newTime);

					// Fusionner les créneaux disponibles et réservés pour un tri global
					let allSlots = [...slots.available, ...slots.reserved];

					let repetitionText = "";
					// Gérer la répétition si nécessaire
					if (repeatType === "week") {
						repetitionText = "for this week";
						addWeeklySlots(newTime);
					} else if (repeatType === "month") {
						repetitionText = "for this month";
						addMonthSlots(newTime);
					} else if (repeatType === "year") {
						repetitionText = "for this year";
						addYearSlots(newTime);
					} else if (repeatType === "none") {
						repetitionText = "for this day only";
						// console.log(`✅ Créneau ajouté pour ${dateStr}: → ${newTime}`);
						// console.log(doctorSchedules)
					}

					updateTimeSlots();
					Swal.fire({
						icon: "success",
						title: "Success!",
						html: `Timeslot added successfully <strong>${repetitionText}</strong><br>Please confirm your submission.`
					});
					// console.log(doctorSchedules[doctor])
				}


				
                //repeat every week
				function addWeeklySlots(newTime) {
					let startDate = new Date(selectedDate);

					// Aller au samedi de cette semaine
					let currentDay = startDate.getDay(); // 0 = Dimanche, 6 = Samedi
					let firstDayOfWeek = new Date(startDate);
					firstDayOfWeek.setDate(startDate.getDate() - (currentDay + 1) % 7);

					// console.log("📅 Semaine commencée le:", formatDate(firstDayOfWeek));

					// Récupérer les jours cochés comme fériés
					let excludedDays = getExcludedDays();
					// console.log("⛔ Jours cochés comme fériés:", excludedDays);

					// Liste des jours de la semaine
					const weekDays = ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];

					for (let i = 0; i < 7; i++) {
						let nextDayDate = new Date(firstDayOfWeek);
						nextDayDate.setDate(firstDayOfWeek.getDate() + i);

						let dayName = weekDays[i];
						let nextDateStr = formatDate(nextDayDate);

						// Vérifier si cette date existe déjà dans l'objet doctorSchedules[doctor]
						let isExistingDate = doctorSchedules[doctor].hasOwnProperty(nextDateStr);

						// Vérifier si c'est un jour férié (coché ou déjà vide)
						let isHoliday = excludedDays.includes(dayName) ||
							(isExistingDate && doctorSchedules[doctor][nextDateStr].available.length === 0 && doctorSchedules[doctor][nextDateStr].reserved.length === 0);

						if (isHoliday) {
							// Si c'est un jour férié, on vide les créneaux
							if (!isExistingDate) {
								doctorSchedules[doctor][nextDateStr] = { available: [], reserved: [] };
							} else {
								doctorSchedules[doctor][nextDateStr].available = [];
								doctorSchedules[doctor][nextDateStr].reserved = [];
							}
							// console.log(`🚫 Jour férié ${dayName} - Créneaux vidés pour ${nextDateStr}`);
							continue;
						}

						// Si la date n'existe pas encore, on l'initialise
						if (!isExistingDate) {
							doctorSchedules[doctor][nextDateStr] = { available: [], reserved: [] };
						}

						// Ajouter un créneau s'il n'existe pas encore ni dans available et ni dans reserved
						if (
							!doctorSchedules[doctor][nextDateStr].available.includes(newTime) &&
							!doctorSchedules[doctor][nextDateStr].reserved.includes(newTime)
						) {
							doctorSchedules[doctor][nextDateStr].available.push(newTime);
							// console.log(`✅ Créneau ajouté pour ${nextDateStr}: → ${newTime}`);
						} else {
							// console.log(`⚠️ Créneau ${newTime} déjà existant pour ${nextDateStr}`);
						}


					}

					// console.log("📅 Emplois du temps mis à jour:", doctorSchedules);
					return doctorSchedules[doctor]; // Retourne l'objet mis à jour
				}


                //repeat every mounth
				function addMonthSlots(newTime) {
					let startDate = new Date(selectedDate);
					let ThisMonthDate = new Date(startDate);
					ThisMonthDate.setMonth(startDate.getMonth()); // Aller au mois actuel
					ThisMonthDate.setDate(1); // Commencer au premier jour du mois

					let lastDayOfMonth = new Date(ThisMonthDate.getFullYear(), ThisMonthDate.getMonth() + 1, 0).getDate();

					// Récupérer les jours fériés cochés
					let excludedDays = getExcludedDays();
					// console.log("⛔ Jours cochés comme fériés:", excludedDays);

					// Liste des jours de la semaine
					const weekDays = ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];

					for (let day = 1; day <= lastDayOfMonth; day++) {
						let nextDate = new Date(ThisMonthDate);
						nextDate.setDate(day);

						let dayName = nextDate.toLocaleDateString('en-US', { weekday: 'long' });
						let nextDateStr = formatDate(nextDate);

						// Vérifier si cette date existe déjà dans l'objet doctorSchedules[doctor]
						let isExistingDate = doctorSchedules[doctor].hasOwnProperty(nextDateStr);

						// Vérifier si c'est un jour férié (coché ou déjà vide)
						let isHoliday = excludedDays.includes(dayName) ||
							(isExistingDate && doctorSchedules[doctor][nextDateStr].available.length === 0 && doctorSchedules[doctor][nextDateStr].reserved.length === 0);

						if (isHoliday) {
							// Si c'est un jour férié, on vide les créneaux
							if (!isExistingDate) {
								doctorSchedules[doctor][nextDateStr] = { available: [], reserved: [] };
							} else {
								doctorSchedules[doctor][nextDateStr].available = [];
								doctorSchedules[doctor][nextDateStr].reserved = [];
							}
							// console.log(`🚫 Jour férié ${dayName} - Créneaux vidés pour ${nextDateStr}`);
							continue;
						}

						// Si la date n'existe pas encore, on l'initialise
						if (!isExistingDate) {
							doctorSchedules[doctor][nextDateStr] = { available: [], reserved: [] };
						}

						// Ajouter un créneau s'il n'existe pas encore ni dans available et ni dans reserved
						if (
							!doctorSchedules[doctor][nextDateStr].available.includes(newTime) &&
							!doctorSchedules[doctor][nextDateStr].reserved.includes(newTime)
						) {
							doctorSchedules[doctor][nextDateStr].available.push(newTime);
							// console.log(`✅ Créneau ajouté pour ${nextDateStr}: → ${newTime}`);
						} else {
							// console.log(`⚠️ Créneau ${newTime} déjà existant pour ${nextDateStr}`);
						}
					}

					// console.log("📅 Emplois du temps mis à jour:", doctorSchedules);
					return doctorSchedules[doctor]; // Retourne l'objet mis à jour
				}


                //repeat every year
                function addYearSlots(newTime) {
					let startDate = new Date(selectedDate);
					let currentYear = startDate.getFullYear();

					// Récupérer les jours fériés cochés
					let excludedDays = getExcludedDays();
					// console.log("⛔ Jours cochés comme fériés:", excludedDays);

					for (let month = 0; month < 12; month++) {
						let ThisMonthDate = new Date(currentYear, month, 1);
						let lastDayOfMonth = new Date(currentYear, month + 1, 0).getDate();

						for (let day = 1; day <= lastDayOfMonth; day++) {
							let nextDate = new Date(ThisMonthDate);
							nextDate.setDate(day);

							let dayName = nextDate.toLocaleDateString('en-US', { weekday: 'long' });
							let nextDateStr = formatDate(nextDate);

							// Vérifier si cette date existe déjà dans l'objet doctorSchedules[doctor]
							let isExistingDate = doctorSchedules[doctor].hasOwnProperty(nextDateStr);

							// Vérifier si c'est un jour férié (coché ou déjà vide)
							let isHoliday = excludedDays.includes(dayName) ||
								(isExistingDate && doctorSchedules[doctor][nextDateStr].available.length === 0 && doctorSchedules[doctor][nextDateStr].reserved.length === 0);

							if (isHoliday) {
								if (!isExistingDate) {
									doctorSchedules[doctor][nextDateStr] = { available: [], reserved: [] };
								} else {
									doctorSchedules[doctor][nextDateStr].available = [];
									doctorSchedules[doctor][nextDateStr].reserved = [];
								}
								// console.log(`🚫 Jour férié ${dayName} - Créneaux vidés pour ${nextDateStr}`);
								continue;
							}

							// Si la date n'existe pas encore, on l'initialise
							if (!isExistingDate) {
								doctorSchedules[doctor][nextDateStr] = { available: [], reserved: [] };
							}

							// Ajouter un créneau s'il n'existe pas encore ni dans available et ni dans reserved
							if (
								!doctorSchedules[doctor][nextDateStr].available.includes(newTime) &&
								!doctorSchedules[doctor][nextDateStr].reserved.includes(newTime)
							) {
								doctorSchedules[doctor][nextDateStr].available.push(newTime);
								// console.log(`✅ Créneau ajouté pour ${nextDateStr}: → ${newTime}`);
							} else {
								// console.log(`⚠️ Créneau ${newTime} déjà existant pour ${nextDateStr}`);
							}
						}
					}

					// console.log("📅 Emplois du temps mis à jour pour toute l'année:", doctorSchedules);
					return doctorSchedules[doctor];
				}


				 //Remplir le select avec les mois et années
				 function populateMonthYearSelect() {
					let currentYear = new Date().getFullYear();
					let startYear = currentYear - 2; // Afficher les années autour de l'année actuelle
					let endYear = currentYear + 2;

					monthYearSelect.innerHTML = ""; // Vider avant de remplir

					for (let year = startYear; year <= endYear; year++) {
						for (let month = 0; month < 12; month++) {
							let date = new Date(Date.UTC(year, month, 1));
							let monthName = date.toLocaleDateString("en-US", { month: "long" });
							let option = document.createElement("option");
							option.value = `${year}-${month}`;
							option.textContent = `${monthName} ${year}`;

							// Sélectionner par défaut le mois et année actuels en UTC
							if (year === selectedDate.getUTCFullYear() && month === selectedDate.getUTCMonth()) {
								option.selected = true;
							}

							monthYearSelect.appendChild(option);
						}
					}
				}

				//Mettre à jour l'affichage de la date et synchroniser le select
				function updateDateDisplay() {
					selectedDateElem.textContent = selectedDate.toLocaleDateString("en-US", {
						weekday: 'long',
						day: 'numeric',
						month: 'long',
						year: 'numeric'
					});

					// Mettre à jour le select avec le bon mois/année
					monthYearSelect.value = `${selectedDate.getUTCFullYear()}-${selectedDate.getUTCMonth()}`;
					expanded = false;
					updateTimeSlots(); // Mise à jour de l'affichage des créneaux
				}

				//Gérer le changement de jour avec les flèches
				prevDayBtn.addEventListener("click", function () {
					selectedDate.setDate(selectedDate.getDate() - 1);
					updateDateDisplay();
				});

				nextDayBtn.addEventListener("click", function () {
					selectedDate.setDate(selectedDate.getDate() + 1);
					updateDateDisplay();
				});

				//Gérer le changement de mois avec le select
				monthYearSelect.addEventListener("change", function () {
					let [year, month] = this.value.split("-");
					selectedDate.setUTCFullYear(parseInt(year));
					selectedDate.setUTCMonth(parseInt(month));
					selectedDate.setUTCDate(1); // Aller au premier jour du mois sélectionné

					updateDateDisplay();
				});


				// Ajouter l'écouteur d'événements pour le formulaire
				const form = document.getElementById("appointment");
				form.addEventListener("submit", function (e) {
					e.preventDefault(); // Empêche l'envoi du formulaire par défaut
					// Appeler la fonction de soumission après avoir préparé les données
					setupFormSubmission(doctorSchedules);
				});


				// Initialisation
				populateMonthYearSelect();
				updateDateDisplay();
			});

		</script>



		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<% if (message) { %>
			<script nonce="<%= nonce %>">
				Swal.fire({
					icon: 'error',
					title: 'Oops...',
					text: "<%= message %>",
					confirmButtonText: 'OK'
				});
			</script>
		<% } %>
  
			
    </body>
</html>