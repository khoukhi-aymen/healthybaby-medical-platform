		<!-- script pour afficher le calendrier  -->
		<script nonce="<%= nonce %>">
			//doctorSchedules est récupérée à partir de la BD 
			const doctor = "<%= doctorName %>";
			const rawData = document.getElementById("schedules-data").dataset.schedules;
			const rawSchedules = JSON.parse(rawData);

			const doctorSchedules = {
				[doctor]: {}
			};

			rawSchedules.forEach(entry => {
				doctorSchedules[doctor][entry.date] = {
					available: entry.available || [],
					reserved: entry.reserved || []
				};
			});

			// console.log(doctorSchedules);

			let currentDate = new Date(new Date().toISOString().split('T')[0]); // Date DE Départ UTC

			function generateCalendar() {
				const calendarBody = document.getElementById("calendar-body");
				calendarBody.innerHTML = ""; // Réinitialisation du calendrier

				calendarBody.style.backgroundColor = "#e0e0e0"; // gris moyen clair, confortable pour les yeux



				const weekDays = ["Saturday", "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];

				let startDate = new Date(currentDate);
				startDate.setDate(startDate.getDate() - ((startDate.getDay() + 1) % 7)); // Trouver le samedi de la semaine

				for (let i = 0; i < 7; i++) {
					let date = new Date(startDate);
					date.setDate(date.getDate() + i);
					let dateString = date.toISOString().split('T')[0];

					let schedule = doctorSchedules[doctor][dateString];

					let column = document.createElement("div");
					column.className = "calendar-day text-center border p-2 mx-1";

					// Ajouter le jour et la date
					let header = document.createElement("div");
					header.innerHTML = `<div class="fw-bold text-dark">${weekDays[i]}<br>${dateString}</div>`;
					column.appendChild(header);

					let btnContainer = document.createElement("div");
					btnContainer.className = "d-flex flex-column align-items-center mt-2"; // Aligner verticalement

					if (schedule) {
						if (schedule.available?.length === 0 && schedule.reserved?.length === 0) {
							let closedBtn = document.createElement("button");
							closedBtn.className = "btn  m-1";
							closedBtn.style.backgroundColor = "red";
							closedBtn.textContent = "Closed";
							btnContainer.appendChild(closedBtn);
						} else {
							let times = [...(schedule.available || []), ...(schedule.reserved || [])];
							times.sort(); // Trier les horaires

							times.forEach(time => {
								let btn = document.createElement("button");
								btn.className = schedule.available?.includes(time) ? "btn  m-1" : "btn btn-secondary m-1";
								btn.style.backgroundColor = schedule.available?.includes(time) ? "green" : "Gray";
								btn.textContent = time;
								btnContainer.appendChild(btn);
							});
						}
					} else {
						let nonDispoBtn = document.createElement("button");
						nonDispoBtn.className = "btn m-1";
						nonDispoBtn.style.backgroundColor = "#d39e00" //Dark Yellow
						nonDispoBtn.textContent = "Unavailable";
						btnContainer.appendChild(nonDispoBtn);
					}

					column.appendChild(btnContainer);
					calendarBody.appendChild(column);
				}

				updateMonthSelector();
			}

			function changeWeek(direction) {
				currentDate.setDate(currentDate.getDate() + direction * 7);
				generateCalendar();
			}

			function changeMonth() {
				let selectedMonth = document.getElementById("month-select").value;
				currentDate.setMonth(parseInt(selectedMonth));
				currentDate.setDate(1); // Aller au début du mois
				generateCalendar();
			}

			function updateMonthSelector() {
				const monthSelect = document.getElementById("month-select");
				monthSelect.value = currentDate.getMonth();
			}

			window.onload = generateCalendar;

			document.addEventListener("DOMContentLoaded", function () {
				document.getElementById("previousWeek").addEventListener("click", function () {
					changeWeek(-1);
				});

				document.getElementById("nextWeek").addEventListener("click", function () {
					changeWeek(1);
				});

				document.getElementById("month-select").addEventListener("change", function () {
					changeMonth();
				});
			});
		</script>



		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<% if (message) { %>
			<script nonce="<%= nonce %>">
				Swal.fire({
					icon: 'error',
					title: 'Oops...',
					text: "<%= message %>",
					confirmButtonText: 'OK'
				});
			</script>
		<% } %>
			
    </body>
</html>